{
  "configVersion": 2,
  // blacklisted_items also removed items from chests, which triggered a Lootr container recursion crash
  // (StackOverflowError on container close via Item Obliterator's onPlayerContainer hook).
  // Moved to only_disable_recipes: disables crafting only, never touches containers. Fixes the crash.
  "blacklisted_items": [],
  "blacklisted_nbt": [],
  "only_disable_interactions": [],
  "only_disable_attacks": [],
  "only_disable_recipes": [
    "artifacts:eternal_steak",
    "artifacts:everlasting_beef"
  ],
  "use_hashmap_optimizations": false
}

{
  "configVersion": 2,
  // blacklisted_items also removed items from chests, which triggered a Lootr container recursion crash
  // (StackOverflowError on container close via Item Obliterator's onPlayerContainer hook).
  // Moved to only_disable_recipes: disables crafting only, never touches containers. Fixes the crash.
  "blacklisted_items": [],
  "blacklisted_nbt": [],
  "only_disable_interactions": [],
  "only_disable_attacks": [],
  "only_disable_recipes": [
    "createendertransmission:chunk_loader",
    "cobblemon_utility:mastercandy",
    "cobblemon_utility:commoncandy",
    "cobblemon_utility:hpvoidcap",
    "cobblemon_utility:speedvoidcap",
    "cobblemon_utility:spdefvoidcap",
    "cobblemon_utility:defvoidcap",
    "cobblemon_utility:spatkvoidcap",
    "cobblemon_utility:atkvoidcap",
    "cobblemon_utility:shininghpsilvercap",
    "cobblemon_utility:shiningspeedsilvercap",
    "cobblemon_utility:shiningspdefsilvercap",
    "cobblemon_utility:shiningdefsilvercap",
    "cobblemon_utility:shiningspatksilvercap",
    "cobblemon_utility:shiningatksilvercap",
    "cobblemon_utility:hpobsidiancap",
    "cobblemon_utility:speedobsidiancap",
    "cobblemon_utility:spdefobsidiancap",
    "cobblemon_utility:defobsidiancap",
    "cobblemon_utility:spatkobsidiancap",
    "cobblemon_utility:atkobsidiancap",
    "cobblemon_utility:hpsilvercap",
    "cobblemon_utility:speedsilvercap",
    "cobblemon_utility:spdefsilvercap",
    "cobblemon_utility:defsilvercap",
    "cobblemon_utility:spatksilvercap",
    "cobblemon_utility:atksilvercap",
    "cobblemon_utility:woodencap",
    "mythsandlegends:zygarde_cube",
    "mythsandlegends:zygarde_core",
    "mythsandlegends:zygarde_cell",
    "artifacts:eternal_steak",
    "artifacts:everlasting_beef"
  ],
  "use_hashmap_optimizations": false
}

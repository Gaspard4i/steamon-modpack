	quest.C92DC14B3FD2A5A3.quest_desc: [
		"A few small habits make Steamon far more comfortable to play."
		""
		"Hold &eW&r while looking at a Create machine to open its Ponder, an in-world animation explaining exactly how it works. Sleep through the night when you can, phantoms get old. Open your Cobblemon smartphone to check your party, the Pokedex and battle history at a glance, and watch the on-screen HUD during a throw for real-time catch odds."
		""
		"None of this is required. All of it helps."
	]
	quest.C92DC14B3FD2A5A3.quest_subtitle: "Small habits, big comfort"
	quest.C92DC14B3FD2A5A3.title: "Useful Commands \& QoL"

	quest.5040629EF17E4552.quest_desc: [
		"The &aSteamon League&r is eight Gyms, each devoted to a single type. Beat them in order and face the Champion."
		""
		"Every Gym asks you to catch a Pokemon of its type, defeat several in battle, and raise one to a set level."
		""
		"&eUnlocked by completing the Trainer's Path in Cobblemon II.&r"
	]
	quest.5040629EF17E4552.quest_subtitle: "The road to Champion begins"
	quest.5040629EF17E4552.title: "Enter the League"
	quest.5046F7C28D3F1916.quest_desc: [

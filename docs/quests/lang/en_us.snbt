	quest.5096E4411BC2AEE2.quest_subtitle: "Every cook needs a blade"
	quest.5096E4411BC2AEE2.title: "Sharpen Up"
	quest.50996153FB959512.quest_desc: [
		"Now that you can smelt and cook, food becomes a craft. Farmer's Delight adds crops, tools and hearty meals."
		""
		"Plant a garden: &acabbages&r, &atomatoes&r and &aonions&r are the backbone of every recipe."
		""
		"&eGated behind the Stone Age milestone&r of the Steamon Journey."
	]
	quest.50996153FB959512.quest_subtitle: "Grow your first crops"

	chapter.388F59E226EBC45B.title: "Myths \& Legends"
	chapter.3D0322088ABD7480.title: "Otherside"
	chapter.3EF16F7A003E45D5.title: "Nether"
	chapter.46B599A838F27B8A.title: "Culinary"
	chapter.4AC9C2A03CC7FEF4.title: "Sparks \& Circuits"
	chapter.4B491D83F2C81B36.title: "Steamon League"
	chapter.509B21D25C01D8EB.title: "Welcome"
	chapter.5EFD32D15CC97C4F.title: "Adventure \& Loot"
	chapter.612937DFCAE1B256.title: "Steamon Journey"
	chapter.612C81EB79BF4D14.title: "Berries"
	chapter.680467472FCE4635.title: "Trainer's Path"
	chapter.7562E720C8A255F8.title: "Rotational Power"
	chapter.C0157DBF045118CA.title: "Evolution Items"
	chapter.C0CE44042B5F1369.title: "PvP Battle Items"
	chapter.C0F466D125501734.title: "Cobblemon Cooking"
	chapter_group.175FA950F5B31EAB.title: "Adventure"
	chapter_group.1AF20BFA15DC3940.title: "Dimensions"
	chapter_group.2A4A6BF9FB018712.title: "Cobblemon"
	chapter_group.2C0FD201CD572F12.title: "Culinary"
	chapter_group.348AE7020234F2D4.title: "Create"
	chapter_group.3DBCC9E2D8397D4A.title: "Getting Started"
	quest.00716086C3AA6CCE.quest_desc: [
		"&aAncient Debris&r hides deep in the Nether. Smelt it into Netherite Scrap and craft &aNetherite Ingots&r."
		""
		"Mine and process enough debris for a Netherite Ingot."
		""
		"Netherite gear survives what diamond cannot."
	]
	quest.00716086C3AA6CCE.quest_subtitle: "The hardest metal"
	quest.00B30EAE2FF80368.quest_desc: ["A Utility+ obsidian Speed cap."]
	quest.0108345428C6A5A1.quest_desc: [
		"Build a &aNether Portal&r from obsidian and light it with flint and steel."
		""
		"Step through into a world of fire, ash and rare Pokemon."
		""
		"Bring gold. The Nether respects those who wear it."
	]
	quest.0108345428C6A5A1.quest_subtitle: "Light the way down"
	quest.01CD388FD52FF912.quest_desc: [
		"Poke Balls are the tools of every Trainer. In Steamon you craft them from &aApricorns&r."
		""
		"Harvest colored Apricorns from Apricorn trees found around the world, cook a &ered Apricorn&r in a furnace to get an &aApricorn Lid&r, then craft a Poke Ball with the lid and an iron ingot."
		""
		"Stock up. You will need plenty."
	]
	quest.01CD388FD52FF912.quest_subtitle: "No Trainer travels without Poke Balls"
	quest.0273F11F73F41C4B.quest_desc: ["A Utility+ cap that guarantees a high HP IV floor when applied."]
	quest.030706C9972D89C0.quest_desc: ["Sharply raises one random stat when HP runs low. High-risk, high-reward and famously unpredictable."]
	quest.033AA5825BF33610.quest_desc: [
		"&aCreate Nuclear&r adds &aUranium&r ore deep underground. Mine it, then process the raw uranium into &aYellowcake&r and &aUranium Rods&r."
		""
		"Handle it with care. This is the fuel for your reactor."
		""
		"Gather raw uranium and refine your first Uranium Rod."
	]
	quest.033AA5825BF33610.quest_subtitle: "Mine the glowing rock"
	quest.0359CFB8910D5E9A.quest_desc: [
		"A &aBlaze Burner&r holds a captured blaze and heats the Basin above it. Feed it fuel for normal heat, or &aBlaze Cake&r for &asuperheating&r."
		""
		"Superheated basins unlock the pack's most advanced mixing and alloying recipes."
		""
		"Capture a blaze in an Empty Blaze Burner and craft a stack of Blaze Cakes."
	]
	quest.0359CFB8910D5E9A.quest_subtitle: "Fire, heat and power"
	quest.0392EBF332416130.quest_desc: ["Changes a Pokemon's nature to Brave, reshaping its stat spread without re-breeding."]
	quest.04126E3C1AB76169.quest_desc: ["A held metal coating that evolves Onix into Steelix and Scyther into Scizor."]
	quest.0488BD2CA10821C5.quest_desc: [
		"Pour water into your glowstone frame and rise into the &aAether&r, a paradise of floating islands."
		""
		"Enter the Aether dimension."
		""
		"Bright skies, holy stone and divine creatures await above the clouds."
	]
	quest.0488BD2CA10821C5.quest_subtitle: "Ascend to the isles"
	quest.05843ACAD754B724.quest_desc: ["Lowers Attack EVs and raises friendship. Handy for re-training a special attacker or evolving on friendship."]
	quest.060BBC24DA4BF541.quest_desc: ["Evolves Gligar into Gliscor when held at night, and can cause flinching."]
	quest.0665B33E2B5770CB.quest_desc: [
		"You now have every tool to automate a full process end to end."
		""
		"Build one &aself-running production line&r: a source of rotation feeding drills or fans, items carried on belts and sorted by funnels or an arm, with the output collected in a chest."
		""
		"Prove it works by stockpiling &a64 washed materials, planks or crushed ore&r. You have graduated to true automation."
	]
	quest.0665B33E2B5770CB.quest_subtitle: "A machine that runs itself"
	quest.06BA82A06BF7842E.quest_desc: ["A firm food berry used in cooking. No held battle effect on the server."]
	quest.07734F1A60D01289.quest_desc: [
		"Beating wild Pokemon grants hidden &aEVs&r that permanently boost your stats. &aFeathers&r give a small, targeted EV boost in one stat with no grinding."
		""
		"Collect a set of feathers so you can hand tune any stat: &aHealth&r, &aMuscle&r, &aResist&r, &aGenius&r, &aClever&r and &aSwift&r feathers cover all six."
		""
		"Stock up on feathers to shape your team's stats."
	]
	quest.07734F1A60D01289.quest_subtitle: "Train stats the fast way"
	quest.0786B6A084D59A9A.quest_desc: ["A bitter food berry. In the games it can pinch-heal HP but may confuse a picky Pokemon; here it is mainly a cooking ingredient."]
	quest.07B41EF5E9FD3A17.quest_desc: ["Held item that damages an attacker back when the holder is hit by a special move. The special-side counterpart to Jaboca."]
	quest.07E4C99E4BEDE8E9.quest_desc: ["Protects from weather damage and powder moves like Spore."]
	quest.0810A531D8798861.quest_desc: ["Locks the holder into one move but boosts its Special Attack by 50 percent."]
	quest.09EA7E2A62D56CB6.quest_desc: ["An eggplant-shaped food berry. Purely a cooking ingredient with no battle use."]
	quest.0A96541156F30C36.quest_desc: ["Raises the Speed IV toward its maximum."]
	quest.0AF37277D45D5B46.quest_desc: [
		"Some species have &aregional forms&r, alternate versions with different typings and looks depending on where they are found."
		""
		"Track down and &acatch a regional form&r, such as an Alolan or Galarian variant, to expand your collection beyond the ordinary."
		""
		"A true collector chases every form, not just every species."
	]
	quest.0AF37277D45D5B46.quest_subtitle: "Pokemon from distant lands"
	quest.0C309E7E5DAF01C8.quest_desc: [
		"The &aFactory Gauge&r and &aRedstone Requester&r let machines request exactly the items they need and keep production balanced automatically."
		""
		"Wire them into your package network so a machine pulls stock only when it runs low."
		""
		"This is the difference between a pile of machines and a real factory."
	]
	quest.0C309E7E5DAF01C8.quest_subtitle: "Read your factory at a glance"
	quest.0C572BFFD9ED2FB9.quest_desc: [
		"A Pokemon's &aNature&r raises one stat and lowers another. When breeding, a parent holding an &aEverstone&r passes its exact Nature to the whole clutch."
		""
		"Everstones also stop a Pokemon from evolving, handy when you want to keep a low form."
		""
		"Obtain an Everstone to control the Natures of your bred Pokemon."
	]
	quest.0C572BFFD9ED2FB9.quest_subtitle: "Lock in the nature you want"
	quest.0CE52A5881BE9369.quest_desc: ["Boosts HP potential further; part of the IV candy set."]
	quest.0D22B07789AE6D40.quest_desc: ["A fluffy Poke Puff treat used to raise a Pokemon's friendship."]
	quest.0D383980B566BC0D.quest_desc: ["A sweet cream puff snack, a tasty friendship treat."]
	quest.0D3B3DF1CC03C676.quest_desc: [
		"Craft the Sonorous Staff from a Heart of the Deep, Sculk"
		"Bones and a Soul Crystal. It fires the Warden's sonic boom"
		"on demand, the ultimate Otherside weapon."
	]
	quest.0D3B3DF1CC03C676.title: "The Sonorous Staff"
	quest.0D424E0479541DE2.quest_desc: [
		"Hold the Heart of the Deep, the guaranteed Warden drop."
		"Clear the sculk, veins and catalysts off the portal frame,"
		"then right-click the frame with the Heart to ignite it."
	]
	quest.0D424E0479541DE2.title: "Heart of the Deep"
	quest.0D56EF90278D9F98.quest_desc: [
		"Find an Ancient Temple, buried in the Deeplands biome."
		"It has three levels. An Ancient Compass points the way"
		"if you have crafted one."
	]
	quest.0D56EF90278D9F98.title: "The Ancient Temple"
	quest.0D573A3D893F8FE4.quest_desc: [
		"The Otherside is haunted. Catch 3 Ghost-type Pokemon here,"
		"from Gastly and Duskull to Golett and Spiritomb."
	]
	quest.0D573A3D893F8FE4.title: "Ghosts of the Otherside"
	quest.0D69C613943D8FB1.quest_desc: [
		"Loot the Warden Upgrade Smithing Template from Ancient City"
		"chests (about a 45% chance) or deep in the Ancient Temple."
		"You need it for every piece of Warden gear."
	]
	quest.0D69C613943D8FB1.title: "Warden Upgrade Template"
	quest.0D704EF54A8692D2.quest_desc: [
		"Enter the Otherside dimension through the ignited portal."
		"Beware: darkness is permanent here. Save near the portal"
		"and watch your footing over the void."
	]
	quest.0D704EF54A8692D2.title: "Step Into the Otherside"
	quest.0D75C87DFD66CFEA.quest_desc: [
		"The deepest reaches hide Dragon-types. Catch 3 Dragon-type"
		"Pokemon here, from Goomy and Gible to Noibat and Deino."
	]
	quest.0D75C87DFD66CFEA.title: "Dragons in the Deep"
	quest.0D802B541D5177D2.quest_desc: [
		"Craft the Reinforced Echo Shard: 4 Warden Carapace,"
		"4 Phantom Membrane and 1 Echo Shard in a crafting grid."
		"It is the addition for all Warden gear."
	]
	quest.0D802B541D5177D2.title: "Reinforced Echo Shard"
	quest.0D8409E8541916F7.quest_desc: [
		"Locate an Ancient City in the Deep Dark of the Overworld."
		"Its Reinforced Deepslate frame is a dormant Otherside portal."
		"Come prepared: the Warden lurks here."
	]
	quest.0D8409E8541916F7.title: "The Prebuilt Gate"
	quest.0D853FFF03AF874A.quest_desc: [
		"Break the 2x2 water on the temple entrance level to reach"
		"the hidden floor. Recover a Sculk Transmitter: place two"
		"and shift right-click to link them for wireless redstone."
	]
	quest.0D853FFF03AF874A.title: "The Linker"
	quest.0D910C4F83092A51.quest_desc: [
		"Smith a Resonarium Chestplate: Diamond Chestplate +"
		"Resonarium Plate + Resonarium Upgrade Template. A solid"
		"mid-game set, not the final goal of this dimension."
	]
	quest.0D910C4F83092A51.title: "Resonarium Armor"
	quest.0D994F3743783D4C.quest_desc: ["A magma-heated device that evolves Magmar into Magmortar."]
	quest.0DA011BA1F60AA1B.quest_desc: [
		"Paradox Pokemon roam the Otherside. Catch one more rare"
		"Dragon-type such as Roaring Moon or Raging Bolt to round"
		"out your Otherside dex."
	]
	quest.0DA011BA1F60AA1B.title: "Echoes of Another Time"
	quest.0DC288DA0D480DD9.quest_desc: [
		"Defeat a Warden. It always drops the Heart of the Deep"
		"and 1 to 3 Warden Carapace. The Heart is the portal key;"
		"the Carapace is the base of Warden armor."
	]
	quest.0DC288DA0D480DD9.title: "Slay the Warden"
	quest.0DD84E0B3DC7A88B.quest_desc: [
		"Combine 4 Resonarium with 4 Scutes to press a Resonarium"
		"Plate. This is the smithing addition for the whole set."
	]
	quest.0DD84E0B3DC7A88B.title: "Resonarium Plate"
	quest.0DE2D2ABD01B6240.quest_desc: [
		"Perpetual night breeds Dark-types. Catch 3 Dark-type"
		"Pokemon in the Otherside, such as Deino, Scraggy and Malamar."
	]
	quest.0DE2D2ABD01B6240.title: "Creatures of Darkness"
	quest.0DEADDEFF1333A3E.quest_desc: [
		"Visit all four Otherside biomes: the dangerous Deeplands,"
		"the calm Echoing Forest, the Overcast Columns and the"
		"Blooming Caverns."
	]
	quest.0DEADDEFF1333A3E.title: "A World to Explore"
	quest.0DEB68547CDDD594.quest_desc: [
		"The true endgame. Smith a full set of Warden armor from"
		"Netherite pieces, Reinforced Echo Shards and the Warden"
		"Upgrade Template. Sculk-forged protection for the deepest dark."
	]
	quest.0DEB68547CDDD594.title: "Warden Armor"
	quest.0DF27C813E62ED08.quest_desc: [
		"Hunt the small Sludges in the Blooming Caverns. They drop"
		"Resonarium, the raw material for a lightweight sculk armor"
		"set that sits between iron and diamond."
	]
	quest.0DF27C813E62ED08.title: "Resonarium Ore"
	quest.0DFA5A299C8FE1E3.quest_desc: [
		"Smith a Warden Helmet: Netherite Helmet + Reinforced Echo"
		"Shard + Warden Upgrade Template. Worn in the Otherside it"
		"cancels the permanent darkness effect."
	]
	quest.0DFA5A299C8FE1E3.title: "See in the Dark"
	quest.0E433EF0B0919A69.quest_desc: ["Adds a single Special Attack EV."]
	quest.0E5235A7B474672B.quest_desc: [
		"Never run out of Poke Balls again. Plant Apricorns and build a farm."
		""
		"Harvest &aApricorns of every color&r. Each color makes a different special ball later on."
		""
		"Collect a good stock of assorted Apricorns."
	]
	quest.0E5235A7B474672B.quest_subtitle: "Grow your own ball supply"
	quest.0E70C676DA82E5DB.quest_desc: [
		"Steamon adds dozens of biomes through &aOh The Biomes We've Gone&r and rich villages via &aContinents / CTOV&r."
		""
		"Travel until you find a biome you have never seen before and grab a piece of its ground."
		""
		"Different biomes hold different Pokemon. Exploration pays off."
	]
	quest.0E70C676DA82E5DB.quest_subtitle: "A world of strange new biomes"
	quest.0E81DA44CABC4937.quest_desc: [
		"Welcome to &6Create&r. Every machine you will ever build begins with one thing: &aAndesite Alloy&r."
		""
		"Combine &eAndesite&r with an &eIron Nugget&r or &eZinc Nugget&r in a crafting grid."
		""
		"Craft a small stockpile. You will use a lot of it."
	]
	quest.0E81DA44CABC4937.quest_subtitle: "The material that starts it all"
	quest.0EB826979D2A990C.quest_desc: [
		"&aReinforced Echo Shards&r and &aGloomsherds&r are the Otherside's crafting cores."
		""
		"Gather a &aReinforced Echo Shard&r."
		""
		"These fuel the strongest Deeper Darker gear."
	]
	quest.0EB826979D2A990C.quest_subtitle: "Shards of the deep"
	quest.0ED6291DA820379B.quest_desc: ["Held by Clamperl it evolves into Huntail, and boosts Special Attack."]
	quest.0F26DE78BF20BA89.quest_desc: ["A powerful Utility+ candy granting a large experience boost."]
	quest.0F46F990084649AE.quest_desc: ["Raises Special Defense when HP runs low, helping a special wall survive the follow-up hit."]
	quest.0F99E51F573AE76E.quest_desc: ["Evolves Moon-linked Pokemon such as Nidorina and Clefairy."]
	quest.0FFAB9114DA6C811.quest_desc: [
		"&aEngineer's Goggles&r let you read the stress and speed of any kinetic network at a glance."
		""
		"Craft them and wear them while building."
		""
		"They will save you from countless overstressed contraptions."
	]
	quest.0FFAB9114DA6C811.quest_subtitle: "See what your machines are doing"
	quest.100573543B0B18B8.quest_desc: [
		"Far above the world floats the &aAether&r. To reach it, build a frame of &aGlowstone&r and pour a bucket of water inside to open the portal."
		""
		"Gather the &aGlowstone&r you need for the frame. The sky is waiting."
		""
		"&eUnlocks the Aether dimension branch&r."
	]
	quest.100573543B0B18B8.quest_subtitle: "Build a doorway to the clouds"
	quest.1008C7F7965BD055.quest_desc: [
		"Deep beneath the surface lies the &aDeep Dark&r and its silent &aAncient Cities&r. Sneak past the Warden and loot what you can."
		""
		"Bring back an &aEcho Shard&r as proof you walked the dark and lived."
		""
		"&eUnlocks the Otherside branch&r. The whispers of the Deep Dark lead somewhere stranger."
	]
	quest.1008C7F7965BD055.quest_subtitle: "Something whispers below"
	quest.100F316559785DED.quest_desc: [
		"You have tools and iron. Now survive the world above ground. Build a shelter, then craft &aPoke Balls&r and catch your very first &aPokemon&r."
		""
		"Weaken a wild Pokemon in battle, then throw a Poke Ball. Your team starts with one."
		""
		"&eUnlocks the Cobblemon branch: First Steps&r. The real adventure begins now."
	]
	quest.100F316559785DED.quest_subtitle: "Shelter, and your first partner"
	quest.100F316559785DED.title: "Your First Partner"
	quest.1015F00E0936A20C.quest_desc: ["Restores 10 HP when held and HP runs low. A classic early-game pinch heal for frail Pokemon."]
	quest.102BA726C9F17223.quest_desc: [
		"Dig deeper and mine &aIron Ore&r. Smelt it into &aIron Ingots&r and craft a full set of iron tools."
		""
		"Iron is the backbone of both Create and Cobblemon. Machines, Poke Balls and better gear all demand it."
		""
		"&eUnlocks the Create branch: Cogs \& Crates&r. Time to start building machines."
	]
	quest.102BA726C9F17223.quest_subtitle: "The metal that runs everything"
	quest.102BA726C9F17223.title: "Iron Age"
	quest.102D9356B8648743.quest_desc: [
		"Wood only gets you so far. Mine &aStone&r with your wooden pickaxe, upgrade to stone tools, and smelt your first &aCharcoal&r or find &aCoal&r."
		""
		"Build a &aFurnace&r and get a fire going. Cooking, smelting and light all start here."
		""
		"&eUnlocks the Culinary branch&r. Once you can cook, food and farming open up."
	]
	quest.102D9356B8648743.quest_subtitle: "Stone, coal and the first furnace"
	quest.102D9356B8648743.title: "Stone Age"
	quest.103386F13265F194.quest_desc: [
		"Explore until you find a &aVillage&r. Villages are landmarks, trade hubs, and the easiest source of a &aWaystone&r."
		""
		"Bring back a &aWaystone&r: craft one from stone and a diamond, or take one from a village by breaking it. Either path works."
		""
		"&eUnlocks fast travel with Waystones&r, turning the whole overworld into your backyard."
	]
	quest.103386F13265F194.quest_subtitle: "Civilization on the horizon"
	quest.103C9803731EF929.quest_desc: ["Lowers Special Attack EVs and raises friendship, letting you re-train a physical attacker cleanly."]
	quest.10477055F5BA0E4B.quest_desc: ["Evolves Ice Pokemon like Alolan Vulpix and Galarian Darumaka."]
	quest.104AC6B428F14891.quest_desc: [
		"Wild Pokemon roam every biome. Catch one that lives near your base."
		""
		"Weaken it in battle, then throw a Poke Ball."
		""
		"Your overworld team starts here."
	]
	quest.104AC6B428F14891.quest_subtitle: "Meet the locals"
	quest.105485D414441DF4.quest_desc: [
		"Gather &aObsidian&r, build a &aNether Portal&r, and light it with flint and steel."
		""
		"Step through into a world of fire, ash and rare Pokemon. Bring gold. The Nether respects those who wear it."
		""
		"&eUnlocks the Nether dimension branch and the Create branch: Sparks \& Circuits&r."
	]
	quest.105485D414441DF4.quest_subtitle: "Light your first portal"
	quest.105485D414441DF4.title: "Into the Nether"
	quest.105FB4F860A68106.quest_desc: [
		"Locate a &aStronghold&r, fill the &aEnd Portal&r with Eyes of Ender, and step into the &aEnd&r."
		""
		"A barren island floats in the void, and upon it waits the &aEnder Dragon&r."
		""
		"&eUnlocks the End dimension branch&r. This is the beginning of the endgame."
	]
	quest.105FB4F860A68106.quest_subtitle: "The final frontier"
	quest.105FB4F860A68106.title: "The End Approaches"
	quest.106A1449763D07CF.quest_desc: [
		"Master the Nether. Brave a &aNether Fortress&r or &aBastion&r, farm blazes, and hunt down &aWither Skeletons&r for their skulls."
		""
		"Three Wither Skeleton skulls and soul sand summon the &aWither&r. Prepare well before you try."
		""
		"The deeper Nether holds the materials for your strongest early gear."
	]
	quest.106A1449763D07CF.quest_subtitle: "Fortresses, blazes and skulls"
	quest.106A1449763D07CF.title: "Nether Mastery"
	quest.106FA347B5C829E2.quest_desc: [
		"No overworld run is complete without &aDiamonds&r. Dig deep, watch for lava, and light your tunnels."
		""
		"Mine diamonds and set up an &aEnchanting Table&r for your first enchanted gear."
		""
		"&eUnlocks the Create branch: Rotational Power&r. Diamonds feed the pack's advanced machinery."
	]
	quest.106FA347B5C829E2.quest_subtitle: "The classic milestone"
	quest.106FA347B5C829E2.title: "Diamond Age"
	quest.1074005F5BFE6C71.quest_desc: ["A zesty red Apricorn juice."]
	quest.10A267E791DF2E98.quest_desc: [
		"Welcome to &aSteamon&r. Your adventure through the overworld, the Nether, the Aether, the Otherside and the End begins right here."
		""
		"Punch a few &atrees&r, turn the logs into planks, and build your first &aCrafting Table&r and wooden tools."
		""
		"This main line is your map. Each milestone below unlocks a whole branch of the pack. Follow it top to bottom."
	]
	quest.10A267E791DF2E98.quest_subtitle: "Every journey starts with a tree"
	quest.10F0A6A7E1E23DFF.quest_desc: [
		"Collect every evolution stone and evolution item to unlock every branch of the Pokedex."
		""
		"Reward: a random evolution stone or rare item plus a big XP payout."
	]
	quest.10F0A6A7E1E23DFF.quest_subtitle: "Gather every evolution item"
	quest.10F0A6A7E1E23DFF.title: "Stone Collector"
	quest.10FC1EB90F757C1B.quest_desc: [
		"Face the &aEnder Dragon&r and bring it down. Destroy the End Crystals, dodge its breath, and land the final blow."
		""
		"This is the peak of the main line. Beyond it lies the true endgame content of Steamon."
		""
		"&eUnlocks the Create branch: Beyond the Machine, the Cobblemon branch: Myths \& Legends, and the Adventure \& League content&r. You are ready for it all."
	]
	quest.10FC1EB90F757C1B.quest_subtitle: "Slay the Ender Dragon"
	quest.10FC1EB90F757C1B.title: "Dragon Slayer"
	quest.11136ED5775F20DC.quest_desc: [
		"This path leads to the &eCobblemon: First Steps&r branch."
		""
		"Follow the marker to open that quest line."
	]
	quest.11136ED5775F20DC.quest_subtitle: "Branch marker"
	quest.11136ED5775F20DC.title: "Path: First Steps"

	quest.501DCF0AC468F2D7.quest_desc: [
		"With the Ender Dragon slain, the world opens up. This opens the Adventure \& Loot quest line: structures hide priceless artifacts and relics."
		""
		"Seek out villages, mineshafts and the silent Ancient Cities of the Deep Dark."
		""
		"&eGated behind the Dragon Slayer milestone.&r"
	]
	quest.501DCF0AC468F2D7.quest_subtitle: "The world is full of treasure"

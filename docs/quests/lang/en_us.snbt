	quest.50294A5E15CF177A.quest_desc: [
		"Boots that reflect a portion of melee damage back at your attacker."
		""
		"A defensive artifact for surviving tough encounters."
	]
	quest.50294A5E15CF177A.quest_subtitle: "Deal damage back to attackers"
	quest.50294A5E15CF177A.title: "Steadfast Spikes"
	quest.5035665954F13AAF.quest_desc: [
		"Boots that grant fast underwater swimming speed."
		""
		"Pairs well with exploring flooded ruins and ocean structures."
	]
	quest.5035665954F13AAF.quest_subtitle: "Swim like a fish"
	quest.5035665954F13AAF.title: "Flippers"
	quest.5052447EB34CB6A8.quest_desc: [
		"Sneak into an &aAncient City&r beneath the Deep Dark. Avoid the Warden, loot the chests, and escape with an &aEcho Shard&r."
		""
		"The rarest overworld loot waits in the dark."
	]
	quest.5052447EB34CB6A8.quest_subtitle: "Brave the Deep Dark"
	quest.5052447EB34CB6A8.title: "Ancient City"
	quest.5072C373AAB7AF13.quest_desc: [
		"Pulls nearby dropped items and experience orbs toward you."
		""
		"Makes farming and mob grinding far more efficient."
	]
	quest.5072C373AAB7AF13.quest_subtitle: "Items come to you"
	quest.5072C373AAB7AF13.title: "Universal Attractor"
	quest.508490691423DA09.quest_desc: [
		"Grants full immunity to fire and lava damage while worn."
		""
		"Essential for anyone spending time in the Nether."
	]
	quest.508490691423DA09.quest_subtitle: "Immune to fire and lava"
	quest.508490691423DA09.title: "Obsidian Skull"
	quest.50B36D079EF538B3.quest_desc: [
		"Explore the great structures of the world and gather the rare relics and artifacts hidden within to become a true &aTreasure Hunter&r."
		""
		"Reward: one random pull from the Treasure Hunter table plus experience."
		""
		"Complete the artifact and relic collections to unlock this."
	]
	quest.50B36D079EF538B3.quest_subtitle: "Explore every structure and collect the relics"
	quest.50B36D079EF538B3.title: "Treasure Hunter"
	quest.50B3C21E7CF5708D.quest_desc: [
		"Right-click to launch yourself upward, softening any fall."
		""
		"Useful for reaching high ledges or escaping danger."
	]
	quest.50B3C21E7CF5708D.quest_subtitle: "A gust of air on demand"
	quest.50B3C21E7CF5708D.title: "Cloud in a Bottle"
	quest.50B9E56C7B987302.quest_desc: [
		"Right-click to set a waypoint, then teleport back to it later."
		""
		"One of the rarest and most useful artifacts in the game."
	]
	quest.50B9E56C7B987302.quest_subtitle: "Instant travel across the map"
	quest.50B9E56C7B987302.title: "Warp Drive"
	quest.50CAE62CFB0376EE.quest_desc: [
		"Worn as an accessory, it permanently grants an additional heart of health."
		""
		"One of the most valuable artifacts to track down."
	]
	quest.50CAE62CFB0376EE.quest_subtitle: "An extra heart, permanently"
	quest.50CAE62CFB0376EE.title: "Crystal Heart"
	quest.50CF24B5D3BA83FB.quest_desc: [
		"Heals you for a portion of the damage you deal in melee combat."
		""
		"A strong sustain option for extended fights."
	]
	quest.50CF24B5D3BA83FB.quest_subtitle: "Drain life on every hit"
	quest.50CF24B5D3BA83FB.title: "Vampiric Glove"
	quest.50D03A46E53F626F.quest_desc: [
		"A gauntlet that greatly increases melee attack damage."
		""
		"A steady early upgrade for taking on tougher fights."
	]
	quest.50D03A46E53F626F.quest_subtitle: "Punch through anything"
	quest.50D03A46E53F626F.title: "Power Glove"
	quest.50D198B0FBC2B764.quest_desc: [
		"Locate a &aVillage&r. Trade with villagers, raid the chests, and note it as a fast-travel anchor."
		""
		"Villages are the safest source of early loot and emeralds."
	]
	quest.50D198B0FBC2B764.quest_subtitle: "Find a settlement"
	quest.50D198B0FBC2B764.title: "Village Visitor"
	quest.50DD0D2A2D442224.quest_desc: [
		"Gauntlets that let you mine straight through blocks by punching them."
		""
		"Handy for quick tunnels and ancient city shortcuts."
	]
	quest.50DD0D2A2D442224.quest_subtitle: "Dig through stone with ease"
	quest.50DD0D2A2D442224.title: "Digging Claws"
	quest.50E194D990BF19F8.quest_desc: [
		"Descend into an &aAbandoned Mineshaft&r. Follow the rails to chest minecarts loaded with rare drops."
		""
		"Watch for cave spiders in the cobwebs."
	]
	quest.50E194D990BF19F8.quest_subtitle: "Delve the old tunnels"
	quest.50E194D990BF19F8.title: "Abandoned Mineshaft"
	quest.50E898FF65F0E742.quest_desc: [
		"Boots that grant a permanent speed boost while worn."
		""
		"The first artifact of many waiting in the wild."
	]
	quest.50E898FF65F0E742.quest_subtitle: "Faster than your own two feet"
	quest.50E898FF65F0E742.title: "Running Shoes"
	quest.50F676F9AEE5BB6A.quest_desc: [
		"A whole roast chicken, the classic centerpiece feast."
		""
		"Cook and obtain one to add it to your culinary collection."
	]
	quest.50F676F9AEE5BB6A.quest_subtitle: "Farmer's Delight"
	quest.50F676F9AEE5BB6A.title: "Farmhouse Roast"
	quest.5119550BFA8D38DF.quest_desc: ["Permanently raises the max PP of one move by 20 percent."]
	quest.51B23C29D9374CD6.quest_desc: ["All 70 Cobblemon berries have their own collection in the Berries chapter. Head there to fill every plot on the farm."]
	quest.53755E5B49D1C0EF.quest_desc: ["A tough scale that evolves Seadra into Kingdra when held."]
	quest.53968E03C9892789.quest_desc: ["Changes a Pokemon's nature to Sassy, reshaping its stat spread without re-breeding."]
	quest.542A34A7665C3651.quest_desc: ["Adds a single Attack EV for precise physical spreads."]
	quest.54ED834A9FADDA72.quest_desc: ["Changes a Pokemon's nature to Mild, reshaping its stat spread without re-breeding."]
	quest.5528A682AF93D1A6.quest_desc: [
		"Fill the End Portal you found in the Stronghold with Eyes of Ender and step through."
		""
		"You have gone from punching your first tree to standing at the edge of another dimension entirely. That is the whole Steamon Journey, completed."
		""
		"This is not the end of the pack, only of this guided line. Create, Cobblemon, the Aether, the Otherside and the League are all waiting for you now, at your own pace, along with your very first taste of Numismatics currency."
	]
	quest.5528A682AF93D1A6.quest_subtitle: "From a single tree to the edge of reality"
	quest.5528A682AF93D1A6.title: "Journey's End"
	quest.55E4ED79C6250B41.quest_desc: ["Halves Speed but adds Special Attack EVs after battle."]
	quest.56065A80390AF05A.quest_desc: ["Halves one super-effective Ice-type hit. Saves Dragon, Flying and Ground types from an Ice Beam KO."]
	quest.567E86E514462ED3.quest_desc: [
		"Your inventory fills up fast once you start hoarding cobblestone and Pokemon loot. A &esophisticated backpack&r fixes that before it becomes a problem."
		""
		"Craft one from 6 &estring&r, 2 &eleather&r and a wooden chest in a shaped recipe, then wear it or keep it in your inventory and right-click to open it anywhere."
		""
		"&e&lTip:&r upgrade slots let you socket in stack, pickup, void and even feeding upgrades later. It scales from copper to netherite as you progress, so this first one is only the beginning."
	]
	quest.567E86E514462ED3.quest_subtitle: "Never run out of pockets"
	quest.567E86E514462ED3.title: "&eYour Backpack"
	quest.56B209179516EB25.quest_desc: ["Raises accuracy when the holder moves after the target."]
	quest.57DD86D8A2FAF429.quest_desc: ["Lowers the HP IV. Useful for minimizing damage or Trick Room math."]
	quest.5837C4969FC678F4.quest_desc: ["Raises the Attack IV toward its maximum."]
	quest.58D5E7FD62AAB638.quest_desc: ["Cures poison the moment it takes hold. A cheap insurance held item against poison and toxic stallers."]
	quest.58E1F3765BF7EAD8.quest_desc: ["Extends Reflect and Light Screen from five turns to eight. A screen-setter staple."]
	quest.58EDB0CCF666DD0C.quest_desc: [
		"Looking for a specific biome, like a desert for cacti or a jungle for its Pokemon, usually means wandering for ages. A &bNature's Compass&r ends that."
		""
		"Craft one from a sapling, a log and a regular compass. Right-click it to open a biome list, pick your target, and the needle points straight to the nearest match."
		""
		"It is the first step toward serious exploration: more advanced tools build on it later."
	]
	quest.58EDB0CCF666DD0C.quest_subtitle: "Never wander blind again"
	quest.58EDB0CCF666DD0C.title: "&bThe Compass"
	quest.593047618466F462.quest_desc: ["Adds HP EVs, padding out a Pokemon's bulk."]
	quest.593E5631CD866B9F.quest_desc: ["Adds Special Attack EVs for special attackers."]
	quest.5B18937EED45C725.quest_desc: ["Evolves dark Pokemon such as Murkrow and Misdreavus."]
	quest.5B3658C7DF2D582B.quest_desc: ["A held item that evolves Poliwhirl and Slowpoke, and can cause flinching in battle."]
	quest.5C4F8C7C2625DA6B.quest_desc: ["A spicy food berry that can pinch-heal HP with a chance to confuse. Mostly used in cooking on the server."]
	quest.5C583CAA8FE451DD.quest_desc: ["The odd one out: halves a Normal-type hit, even when it is not super-effective. Niche but unique among resist berries."]
	quest.5CE75183A182114F.quest_desc: ["Adds Speed EVs, the fast track to outspeeding."]
	quest.5CF8E896D8D49489.quest_desc: ["Changes a Pokemon's nature to Naive, reshaping its stat spread without re-breeding."]
	quest.5D00FEC7C79E27E1.description: [
		"&6Create&r turns Rotational Power into machines that build things for you: crushers, presses, mixers, whole factories running on cogs and steam.",
		"",
		"Craft 1 &6Andesite Alloy&r (andesite + an iron nugget at a crafting table) to begin. Tip: hover any &6Create&r item and hold &eW&r to open the &6Ponder&r, the mod's built in guide. Use it all chapter long.",
		"",
		"Machines spin thanks to &dRotational Power&r: &dShafts&r carry it in a straight line, &dCogwheels&r change direction and flip the rotation's spin, and pairing a large cog with a small one doubles or halves the speed. That is the whole language of this chapter."
	]
	quest.5D00FEC7C79E27E1.subtitle: "Hold W to Ponder"
	quest.5D00FEC7C79E27E1.title: "&6Cogs \& Crates"
	quest.5D380D157C097D1B.quest_desc: ["Halves one super-effective Fairy-type hit. Prized tech on Dragon, Dark and Fighting types that fear Fairy moves."]
	quest.5F81875266DF9EC0.quest_desc: ["Lowers the Special Attack IV for pure physical attackers."]
	quest.6013505E01EFD144.quest_desc: ["A cool Apricorn juice, a handy field consumable."]
	quest.604A7A41DC122784.quest_desc: ["Changes a Pokemon's nature to Relaxed, reshaping its stat spread without re-breeding."]
	quest.6057F44C1806E792.quest_desc: ["Changes a Pokemon's nature to Jolly, reshaping its stat spread without re-breeding."]
	quest.6100000000000001.quest_desc: [
		"Relics add a second layer of wearable trinkets on top of Artifacts."
		""
		"Collect them here after finding a handful of Artifacts."
	]
	quest.6100000000000001.quest_subtitle: "This opens the Relics sub-collection"
	quest.6100000000000001.title: "Welcome to Relics"
	quest.6100000000000002.quest_desc: [
		"A belt that grants extra speed while sprinting."
		""
		"A simple, reliable mobility relic."
	]
	quest.6100000000000002.quest_subtitle: "Move faster while sprinting"
	quest.6100000000000002.title: "Kinetic Belt"
	quest.6100000000000003.quest_desc: [
		"Increases damage dealt to hostile mobs."
		""
		"A solid pick for anyone fighting through dungeons."
	]
	quest.6100000000000003.quest_subtitle: "Bonus damage against beasts"
	quest.6100000000000003.title: "Hunting Belt"
	quest.6100000000000004.quest_desc: [
		"Grants water breathing while worn."
		""
		"No more surfacing for air mid-exploration."
	]
	quest.6100000000000004.quest_subtitle: "Breathe easy underwater"
	quest.6100000000000004.title: "Jellyfish Necklace"
	quest.6100000000000005.quest_desc: [
		"Reflects certain negative status effects back at their source."
		""
		"A defensive trinket worth tracking down."
	]
	quest.6100000000000005.quest_subtitle: "Deflect harmful effects"
	quest.6100000000000005.title: "Reflective Necklace"
	quest.6100000000000006.quest_desc: [
		"A cloak that grants a chance to avoid mob aggro in foliage."
		""
		"Useful for slipping past hostile crowds."
	]
	quest.6100000000000006.quest_subtitle: "Blend into nature"
	quest.6100000000000006.title: "Leafy Mantle"
	quest.6100000000000007.quest_desc: [
		"Improves vision and stealth during nighttime."
		""
		"One of the rarer capes in the Relics collection."
	]
	quest.6100000000000007.quest_subtitle: "Master of the night"
	quest.6100000000000007.title: "Midnight Mantle"
	quest.6100000000000008.quest_desc: [
		"A curious relic said to bring luck to its wearer."
		""
		"Collect it to round out your relic set."
	]
	quest.6100000000000008.quest_subtitle: "A taste for treasure"
	quest.6100000000000008.title: "Golden Tooth"
	quest.6100000000000009.quest_desc: [
		"Right-click to summon your last ridden mount to your side."
		""
		"Never walk back to your Pokemon mount again."
	]
	quest.6100000000000009.quest_subtitle: "Call your mount from anywhere"
	quest.6100000000000009.title: "Rider Flute"
	quest.610000000000000A.quest_desc: [
		"Boots with a sharp edge, useful in a pinch."
		""
		"The final relic in this collection."
	]
	quest.610000000000000A.quest_subtitle: "Sharp footwork"
	quest.610000000000000A.title: "Cut Glass Boot"
	quest.615E78995AF53EDC.quest_desc: ["Changes a Pokemon's nature to Impish, reshaping its stat spread without re-breeding."]
	quest.61AA8829A6838596.quest_desc: ["Held item that raises Special Defense when the holder is hit by a special move, hardening a special wall on contact."]
	quest.61C62FB48C8EB0EB.quest_desc: ["A rarer candy that pushes an IV higher for perfect stats."]
	quest.6200000000000001.quest_desc: ["This opens the Berries quest line. Cobblemon berries grow on bushes and provide healing, status cures, and competitive held-item effects."]
	quest.6200000000000001.title: "Welcome to Berries"
	quest.627C814F3A419782.quest_desc: ["Changes a Pokemon's nature to Hasty, reshaping its stat spread without re-breeding."]
	quest.63248C846CF59B64.quest_desc: [
		"This book will never lock you out of anything. Every reward here is a bonus, never a requirement."
		""
		"&aThe Steamon Journey&r is a suggested path, not a chain. Once it opens the Create and Cobblemon branches, explore them in whatever order you like, skip what bores you, and chase what excites you."
		""
		"Play your way. The quests just try to keep up."
	]
	quest.63248C846CF59B64.quest_subtitle: "A guide, not a gate"
	quest.63248C846CF59B64.title: "&eQuests Are Optional"
	quest.6423205B2BC60390.title: "Elite Four Pai"
	quest.64869815C2449E97.quest_desc: ["Fully restores the PP of every move."]
	quest.64FCE431D519D969.quest_desc: ["Restores 10 PP to one of a Pokemon's moves."]
	quest.67859B9298078500.quest_desc: ["Boosts the Defenses of a not-fully-evolved Pokemon by 50 percent. Makes prevos into walls."]
	quest.67D1D991292C338C.quest_desc: ["A sweet-scented sachet that evolves Spritzee into Aromatisse on trade."]
	quest.687D0FF41B2B32AF.quest_desc: ["Changes a Pokemon's nature to Gentle, reshaping its stat spread without re-breeding."]
	quest.68ACE7575F81183E.quest_desc: ["Adds a single Special Defense EV."]
	quest.68E3143310F62CDC.quest_desc: ["Maxes out the PP of a single move in one use. The premium PP booster."]
	quest.69842A9FE6D1D83B.quest_desc: ["Lowers the Speed IV for Trick Room or Gyro Ball builds."]
	quest.69941C34B58F3E01.quest_desc: ["Raises the Special Attack IV toward its maximum."]
	quest.69B0B0FB1EBD0E38.quest_desc: ["Changes a Pokemon's nature to Modest, reshaping its stat spread without re-breeding."]
	quest.6A00000000000001.quest_desc: ["This opens the PvP Battle Items quest line. Held items, power items, and ability tools for competitive Cobblemon battles."]
	quest.6A00000000000001.title: "Welcome to Battle Items"
	quest.6A2390556B6867E8.quest_desc: ["A held item that restores a little HP every turn. The bread and butter of defensive teams."]
	quest.6A4B4A0C6266855D.quest_desc: ["Shields the holder from contact side effects like Rocky Helmet or Static."]
	quest.6B45A4029B04DFFC.quest_desc: ["Lowers a Pokemon's HP EVs while raising its friendship. Used to reset training or reach a friendship evolution."]
	quest.6BC7D53EBCF6F89F.title: "Elite Four Gaz"
	quest.6C255FF72F2B333E.quest_desc: ["Evolves Water Pokemon like Poliwhirl and Shellder."]
	quest.6C7E421CADAC0FE5.quest_desc: [
		"Walking back to base after a long expedition gets old fast. Good news: there is already a &bWaystone&r active near spawn."
		""
		"Right-click it once to attune yourself to it, then right-click any other Waystone later to warp instantly between the two. Keep a &bReturn Scroll&r in your hotbar too: use it anytime to warp straight back to the last Waystone you visited."
		""
		"&e&lTip:&r crafting your own Waystone costs a Warp Stone and an Ender Pearl, a bit steep this early. For now, lean on the spawn one and the villages you find. A full personal network can wait."
	]
	quest.6C7E421CADAC0FE5.quest_subtitle: "The waystone by the spawn"
	quest.6C7E421CADAC0FE5.title: "&bGetting Around"
	quest.6CEAD16A9F31722E.quest_desc: ["Locks the holder into one move but boosts its Attack by 50 percent."]
	quest.6D97B387BFE4207F.quest_desc: ["Boosts move power by 30 percent at the cost of chip damage each hit. A staple offensive item."]
	quest.6DA4719DA9D3C18B.quest_desc: ["A glossy, sweet-then-sour food berry. No battle use, good for cooking and dyes."]
	quest.6DBA9B5876B3E382.quest_desc: ["A held item that boosts the power of the holder's Fairy-type moves."]
	quest.6E38345EBB7E75DC.quest_desc: ["Restores 10 PP to all of a Pokemon's moves."]
	quest.6E7DCFD62C81A8FC.quest_desc: ["Halves one super-effective Psychic-type hit, helping Fighting and Poison types survive Psychic."]
	quest.6EF5321ED83ECD6C.quest_desc: ["A sweet pink Apricorn juice for on-the-go boosts."]
	quest.6F28747609CCE274.quest_desc: ["Cures a burn on a single Pokemon."]
	quest.6FAD6E69068A5DA5.quest_desc: ["Adds HP EVs, the mochi counterpart to HP Up."]
	quest.7081A84E2ED86395.quest_desc: [
		"An &aEye of Ender&r is crafted from an Ender Pearl and Blaze Powder, both Nether-adjacent ingredients you should have by now."
		""
		"Throw one and follow where it points, then throw another from there. Repeat and you will walk straight to a buried &aStronghold&r. Your Nature's Compass can help you narrow down the search."
		""
		"The Stronghold holds the portal to the End, the final threshold of the Steamon Journey."
	]
	quest.7081A84E2ED86395.quest_subtitle: "The threshold of the deep worlds"
	quest.7081A84E2ED86395.title: "Into the Depths"
	quest.7107C7BDAB487C21.quest_desc: ["Halves one super-effective Fighting-type hit. Lets Normal and Steel types survive a Close Combat."]
	quest.715241A394E6B043.quest_desc: ["Evolves Sun-linked Pokemon like Gloom and Sunkern."]
	quest.723E38A7E8441E11.quest_desc: ["A held item that boosts the power of the holder's Rock-type moves."]
	quest.72529F2BAD5B582D.quest_desc: ["Evolves Electric Pokemon such as Pikachu and Eelektrik."]
	quest.73512D315FA8BF3F.quest_desc: ["A fancy food berry once used for high-class snacks. Cooking ingredient with no battle use."]
	quest.73717D70820B1FDD.quest_desc: ["Halves Speed but adds Special Defense EVs after battle."]
	quest.73A90838A9F8B990.quest_desc: ["A sweet food berry, prized in the kitchen rather than in battle. Farm a patch and stock up."]
	quest.74057901CB46C6FC.quest_desc: ["Restores PP to all of a Pokemon's moves. A rarer PP-recovery berry for drawn-out battles."]
	quest.74208F10F2E142B6.quest_desc: ["Raises the Defense IV toward its maximum."]
	quest.747559FE31B2177C.quest_desc: ["Lowers the Special Defense IV in niche min-max builds."]
	quest.75576F9FD99EB80F.quest_desc: ["A brewed Apricorn juice that boosts a Pokemon's stats in the field."]
	quest.75BA0D99BF39BE21.quest_desc: ["An extremely sour food berry. Culinary only, best blended into recipes."]
	quest.76530D0122392A08.quest_desc: ["Halves one super-effective Ghost-type hit, protecting Psychic and other Ghost types."]
	quest.7723C8CD56413D01.quest_desc: [
		"Four planks make a &aCrafting Table&r, the single most important block in the game."
		""
		"Craft a table and a &awooden pickaxe&r. The pickaxe is what lets you finally break stone."
		""
		"Everything else builds on these two items."
	]
	quest.7723C8CD56413D01.quest_subtitle: "The tool that unlocks everything"
	quest.7723C8CD56413D01.title: "Craft \& Create"
	quest.7808D45744C35AEE.quest_desc: ["Held item that raises Defense when the holder is hit by a physical move. Turns an incoming hit into a setup."]
	quest.78B8EBAC59E95DBA.quest_desc: ["A suspicious disc that evolves Porygon2 into Porygon-Z."]
	quest.79779A27A0335696.quest_desc: ["Cures any single status condition on a Pokemon."]
	quest.79A3BC35DD7F0C88.quest_desc: ["Restores 10 PP to a single move when held or used. Keeps a key attack from running dry in long fights."]
	quest.7A6122D4891EE43B.quest_desc: ["Raises Speed when HP runs low. The core of many pinch-sweep setups, outpacing the whole field."]
	quest.7AEB7A40BBCCB99A.quest_desc: ["Fully restores a Pokemon's HP."]
	quest.7B078090B15F5093.quest_desc: ["A held band that boosts the power of physical moves by 10 percent."]
	quest.7B1D3463CD4D6E7B.quest_desc: ["Heals Poison types each turn but harms everyone else. Poison-type Leftovers."]
	quest.7B390BAE8ED58355.quest_desc: ["Wakes a sleeping Pokemon instantly. Held before a Rest, it lets you heal to full and act on the same turn."]
	quest.7B63BDBF02CC4CA0.quest_desc: ["Sharply raises the critical-hit ratio when HP runs low, making nearly every hit a crit."]
	quest.7CB5661D486CF43B.quest_desc: ["The universal cure: heals any single status condition, including confusion. One of the most reliable held berries in competitive play."]
	quest.7D00000000000001.quest_desc: ["This opens the Evolution Items quest line. Stones, trade items, and held items required to evolve specific Cobblemon."]
	quest.7D00000000000001.title: "Welcome to Evolution Items"
	quest.7D6E430C26EDE06C.quest_desc: ["A held or in-battle Cheri Berry cures paralysis, letting a Pokemon move freely again. Handy on fast sweepers that hate being locked down."]
	quest.7DABE28A86480F2F.quest_desc: ["A tangy food berry for cooking and juices. No battle effect, but easy to farm in bulk."]
	quest.7DCE0F34B0E1360E.quest_desc: ["Evolves certain Fire-related Pokemon such as Vulpix and Growlithe."]
	quest.7E453D568132465C.quest_desc: ["Lowers Special Defense EVs and raises friendship. A gentle way to fix an over-trained spread."]
	quest.7E4CBD441FEAA432.quest_desc: ["Fully restores HP and cures any status condition at once."]
	quest.7FEA374D63883FC9.quest_desc: ["A pinch berry: when HP drops low it sharply raises Attack, turning a near-faint into a sweep."]
	quest.9420BFEF9297CA54.quest_desc: [
		"Build a &afurnace&r from 8 cobblestone, then smelt raw iron ore into your first &aIron Ingot&r."
		""
		"Keep the furnace running: fuel it with coal, charcoal or spare wood, and craft yourself a &abucket&r while you are at it. Water and lava both become a lot more useful once you can carry them."
		""
		"Iron is the gate to real tools, real armor, and eventually the Nether."
	]
	quest.9420BFEF9297CA54.quest_subtitle: "The metal that changed a civilization"
	quest.9420BFEF9297CA54.title: "Iron Will"
	quest.A136866BCA203769.quest_desc: [
		"Steamon has a Discord community behind it: other Trainers, engineers, screenshots of ridiculous contraptions and the occasional shiny hunt gone wrong."
		""
		"Check #how-to-join and #announcements for the essentials, and grab the ping roles that interest you (updates, events, gym battles) so you never miss what matters to you."
		""
		"See you there."
	]
	quest.A136866BCA203769.quest_subtitle: "You are not playing alone"
	quest.A136866BCA203769.title: "Join the Community"
	quest.A4599F985915BA78.quest_desc: [
		"Torch-spamming every corner of your base gets old. A &6Magnum Torch&r solves it in one block."
		""
		"Craft one and place it near your base: it stops hostile mobs from spawning in a wide sphere around it. There are 3 tiers, and the diamond version you can craft now covers the widest range."
		""
		"One torch, one safe base. Networks of them for bigger bases come later, once you start exploring in earnest."
	]
	quest.A4599F985915BA78.quest_subtitle: "A base where nothing spawns"
	quest.A4599F985915BA78.title: "Hold the Line"

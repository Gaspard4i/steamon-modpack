	quest.50FCB3904FA220E4.title: "Catch a Fire-type"
	quest.5119550BFA8D38DF.quest_desc: ["Permanently raises the max PP of one move by 20 percent."]
	quest.51340482E6524F75.quest_desc: [
		"Prove your mastery of the void. Catch &a4 Pokemon&r total in the End."
		""
		"Psychic and Dragon types dominate here."
		""
		"An End team is a rare and powerful thing."
	]
	quest.51340482E6524F75.quest_subtitle: "Champion of the End"
	quest.51666628288FA69A.quest_desc: [
		"The &aMechanical Arm&r picks items from multiple inputs and drops them into multiple outputs. It also needs a Precision Mechanism."
		""
		"Set its input and output points with the wrench while holding it, then power it."
		""
		"An Arm can sort a belt, load a crafter, or keep a furnace stocked."
	]
	quest.51666628288FA69A.quest_subtitle: "Automate crafting with an Arm"
	quest.51B23C29D9374CD6.quest_desc: ["All 70 Cobblemon berries have their own collection in the Berries chapter. Head there to fill every plot on the farm."]
	quest.52676F23B7228EA1.quest_desc: [
		"You now control breeding, EVs, IVs, Natures and evolutions. Time to prove it."
		""
		"Take a Pokemon all the way through its line and &aevolve one into a fully evolved form&r, ideally one you bred and trained yourself."
		""
		"A finished Pokemon is the mark of a real breeder. The endgame awaits."
	]
	quest.52676F23B7228EA1.quest_subtitle: "Raise a masterpiece"
	quest.528F8FBB38353426.quest_desc: [
		"Among the clouds live &aFairy type Pokemon&r of pure and radiant nature. Catch &a2 Fairy types&r here."
		""
		"Fairy types shine in the Aether's holy light."
		""
		"Gentle to look at, fierce in battle."
	]
	quest.528F8FBB38353426.quest_subtitle: "Divine little spirits"
	quest.52C2C82C8519645F.quest_desc: [
		"Many Pokemon evolve when you use an &aEvolution Stone&r on them. Each stone triggers a different set of species."
		""
		"Gather a spread of stones: &aFire&r, &aWater&r, &aThunder&r and &aLeaf&r stones cover the classic four, and rarer ones like &aDusk&r, &aDawn&r, &aShiny&r and &aMoon&r stones exist too."
		""
		"Collect evolution stones and evolve a Pokemon that needs one."
	]
	quest.52C2C82C8519645F.quest_subtitle: "Evolution by stone"
	quest.53755E5B49D1C0EF.quest_desc: ["A tough scale that evolves Seadra into Kingdra when held."]
	quest.53968E03C9892789.quest_desc: ["Changes a Pokemon's nature to Sassy, reshaping its stat spread without re-breeding."]
	quest.542A34A7665C3651.quest_desc: ["Adds a single Attack EV for precise physical spreads."]
	quest.54ED834A9FADDA72.quest_desc: ["Changes a Pokemon's nature to Mild, reshaping its stat spread without re-breeding."]
	quest.55292817F97ED857.quest_desc: [
		"No overworld run is complete without &aDiamonds&r. Dig deep, watch for lava, and light your tunnels."
		""
		"Mine enough diamonds for a full set of core gear."
		""
		"Diamonds unlock the Healing Machine, PC and much of Create."
	]
	quest.55292817F97ED857.quest_subtitle: "The classic milestone"
	quest.559FAF4F5C8DEFD0.quest_desc: ["A Utility+ void Special Defense cap."]
	quest.55E4ED79C6250B41.quest_desc: ["Halves Speed but adds Special Attack EVs after battle."]
	quest.56065A80390AF05A.quest_desc: ["Halves one super-effective Ice-type hit. Saves Dragon, Flying and Ground types from an Ice Beam KO."]
	quest.56B209179516EB25.quest_desc: ["Raises accuracy when the holder moves after the target."]
	quest.576D68A4753F7D3E.quest_desc: [
		"The &aCTOV&r town generator fills the world with detailed villages full of trades and loot."
		""
		"Find a village and trade with a villager, or loot its chests."
		""
		"Villages are a safe first landmark and a steady supply of emeralds."
	]
	quest.576D68A4753F7D3E.quest_subtitle: "Civilization on the horizon"
	quest.57DD86D8A2FAF429.quest_desc: ["Lowers the HP IV. Useful for minimizing damage or Trick Room math."]
	quest.5837C4969FC678F4.quest_desc: ["Raises the Attack IV toward its maximum."]
	quest.5861651435CCB6CD.quest_desc: ["A Utility+ candy that grants experience to a Pokemon."]
	quest.58A63F4838969C97.quest_desc: [
		"The &aMillstone&r is your first processing machine. Powered by rotation, it grinds ores, seeds and blocks into useful outputs."
		""
		"Build a Millstone and connect it to your Water Wheel with a shaft."
		""
		"Try grinding raw ores to double them."
	]
	quest.58A63F4838969C97.quest_subtitle: "Grind materials into more"
	quest.58D5E7FD62AAB638.quest_desc: ["Cures poison the moment it takes hold. A cheap insurance held item against poison and toxic stallers."]
	quest.58E1F3765BF7EAD8.quest_desc: ["Extends Reflect and Light Screen from five turns to eight. A screen-setter staple."]
	quest.593047618466F462.quest_desc: ["Adds HP EVs, padding out a Pokemon's bulk."]
	quest.593E5631CD866B9F.quest_desc: ["Adds Special Attack EVs for special attackers."]
	quest.5AD9980B4D2CDBBE.quest_desc: [
		"The &aBrass Jetpack&r flies higher and longer than the andesite model. It is the mobility endgame of the pack."
		""
		"Combine your engineering know-how with a good air supply and take to the skies for real."
		""
		"Build a Brass Jetpack."
	]
	quest.5AD9980B4D2CDBBE.quest_subtitle: "Upgrade to brass flight"
	quest.5B18937EED45C725.quest_desc: ["Evolves dark Pokemon such as Murkrow and Misdreavus."]
	quest.5B3658C7DF2D582B.quest_desc: ["A held item that evolves Poliwhirl and Slowpoke, and can cause flinching in battle."]
	quest.5C4F8C7C2625DA6B.quest_desc: ["A spicy food berry that can pinch-heal HP with a chance to confuse. Mostly used in cooking on the server."]
	quest.5C583CAA8FE451DD.quest_desc: ["The odd one out: halves a Normal-type hit, even when it is not super-effective. Niche but unique among resist berries."]
	quest.5CE75183A182114F.quest_desc: ["Adds Speed EVs, the fast track to outspeeding."]
	quest.5CE94C50F4A1FEC1.quest_desc: ["A shiny Utility+ Defense cap variant."]
	quest.5CF8E896D8D49489.quest_desc: ["Changes a Pokemon's nature to Naive, reshaping its stat spread without re-breeding."]
	quest.5D0E09E62E730104.quest_desc: [
		"Welcome, Trainer. Your adventure in the world of Steamon starts here."
		""
		"Find a &aPoke Ball&r and interact with a wild Pokemon, or use a Cobblemon starter selection block if the server provides one, then &aselect your first partner&r."
		""
		"This first Pokemon will fight at your side for a long time. Choose the one that speaks to you."
	]
	quest.5D0E09E62E730104.quest_subtitle: "Every journey begins with a single partner"
	quest.5D380D157C097D1B.quest_desc: ["Halves one super-effective Fairy-type hit. Prized tech on Dragon, Dark and Fighting types that fear Fairy moves."]
	quest.5DD25C45606ACFF7.quest_desc: ["A shiny Utility+ HP cap variant."]
	quest.5DD8B634E92C9FE4.quest_desc: [
		"Most Create machines are built around a &aCasing&r. The first one you need is &aAndesite Casing&r."
		""
		"Combine Andesite Alloy with any stripped log."
		""
		"Craft a few. Presses, drills and belts all need it."
	]
	quest.5DD8B634E92C9FE4.quest_subtitle: "The shell of every machine"
	quest.5EF26A11EEE31555.quest_desc: [
		"&aSequenced Assembly&r builds advanced items over several stages on a belt. A Deployer and Press act on an item in order, guided by a Sequenced Gearshift."
		""
		"This is required for the pack's most valuable components, including upgraded mechanisms and train parts."
		""
		"Build a small assembly line and produce a &aPrecision Mechanism&r through it to prove the loop works."
	]
	quest.5EF26A11EEE31555.quest_subtitle: "Assemble items step by step"
	quest.5F3943D7E7E3DA58.quest_desc: [
		"&aNether Fortresses&r are the home of Blazes and the only source of &aBlaze Rods&r."
		""
		"Find a fortress and defeat a Blaze to claim a Blaze Rod."
		""
		"Blaze Rods power brewing, and Blaze Burners heat your Create foundry."
	]
	quest.5F3943D7E7E3DA58.quest_subtitle: "Storm the fortress"
	quest.5F81875266DF9EC0.quest_desc: ["Lowers the Special Attack IV for pure physical attackers."]
	quest.5FF8FDF8123257F4.quest_desc: [
		"Add a &aControls&r block to a train contraption and you can drive it yourself, blowing the &aSteam Whistle&r as you go."
		""
		"Assemble a simple train: a bogey on the track, a few blocks glued on, and a set of Controls to sit at."
		""
		"Drive your first train from one station to another."
	]
	quest.5FF8FDF8123257F4.quest_subtitle: "Take the controls"
	quest.6013505E01EFD144.quest_desc: ["A cool Apricorn juice, a handy field consumable."]
	quest.604A7A41DC122784.quest_desc: ["Changes a Pokemon's nature to Relaxed, reshaping its stat spread without re-breeding."]
	quest.6057F44C1806E792.quest_desc: ["Changes a Pokemon's nature to Jolly, reshaping its stat spread without re-breeding."]
	quest.615E78995AF53EDC.quest_desc: ["Changes a Pokemon's nature to Impish, reshaping its stat spread without re-breeding."]
	quest.61AA8829A6838596.quest_desc: ["Held item that raises Special Defense when the holder is hit by a special move, hardening a special wall on contact."]
	quest.61C62FB48C8EB0EB.quest_desc: ["A rarer candy that pushes an IV higher for perfect stats."]
	quest.625D3A36734D3C9F.quest_desc: [
		"A &aClutch&r cuts rotation when it receives a redstone signal. A &aGearshift&r reverses rotation direction instead."
		""
		"Together they let redstone control which parts of your machine spin, and in which direction."
		""
		"Essential for pistons, bearings and anything that needs to move back and forth."
	]
	quest.625D3A36734D3C9F.quest_subtitle: "Switch and reverse rotation"
	quest.627C814F3A419782.quest_desc: ["Changes a Pokemon's nature to Hasty, reshaping its stat spread without re-breeding."]
	quest.63907AF6F2B026CC.quest_desc: [
		"The &aDeployer&r acts like a player: it can place blocks, use tools, apply items and even attack. It needs a &aPrecision Mechanism&r to build."
		""
		"Give it a hoe to farm, a sword to fight, or an item to combine on a belt."
		""
		"The Deployer is Create's most versatile automation block."
	]
	quest.63907AF6F2B026CC.quest_subtitle: "A robotic hand for your machines"
	quest.63F913C70F514D8D.quest_desc: [
		"&aNether Wart&r is the base of every potion. Harvest it from fortress soul sand gardens."
		""
		"Collect Nether Wart and start a brewing supply."
		""
		"Potions keep both you and your Pokemon in the fight."
	]
	quest.63F913C70F514D8D.quest_subtitle: "Brew and grow"
	quest.64869815C2449E97.quest_desc: ["Fully restores the PP of every move."]
	quest.64FCE431D519D969.quest_desc: ["Restores 10 PP to one of a Pokemon's moves."]
	quest.6562D2D16F386E24.quest_desc: [
		"Weaken a wild Pokemon in battle, then throw a Poke Ball to catch it."
		""
		"The lower the target's HP and the better the ball, the higher your chance of success."
		""
		"Go out and catch your very first wild Pokemon."
	]
	quest.6562D2D16F386E24.quest_subtitle: "Catch your first wild Pokemon"
	quest.65CC35BD4A0D2602.quest_desc: ["A Utility+ obsidian Special Attack cap."]
	quest.6636BE847956C87C.quest_desc: [
		"A competitive Pokemon needs to reach its level ceiling. Push one of your trained, held-item ready Pokemon all the way to &alevel 100&r."
		""
		"Battle high level trainers, use Exp Candies, and let your Exp Share spread the experience."
		""
		"Level a Pokemon to 100 and complete its journey to power."
	]
	quest.6636BE847956C87C.quest_subtitle: "Raise a Pokemon to the summit"
	quest.66AFD1C2A52614AC.quest_desc: [
		"&aEnder Pearls&r and &aBlaze Powder&r make &aEyes of Ender&r, which lead you to the stronghold portal."
		""
		"Craft a handful of Eyes of Ender."
		""
		"Throw them to follow the trail to the End portal."
	]
	quest.66AFD1C2A52614AC.quest_subtitle: "Find the stronghold"
	quest.671B593F8BCC119B.quest_desc: [
		"A pair of &aCrushing Wheels&r spinning into each other crush ores far faster than a Millstone and can process a full belt of items."
		""
		"Build two Crushing Wheels facing each other, rotating in opposite directions."
		""
		"This is your first real automated ore processor."
	]
	quest.671B593F8BCC119B.quest_subtitle: "Crushing on an industrial scale"
	quest.672156768ED8452D.quest_desc: ["A Utility+ treat that boosts friendship quickly. Great for friendship evolutions."]
	quest.6729335784B57978.quest_desc: [
		"The &aEnder Dragon&r rules the central island. Destroy the End Crystals, then bring it down."
		""
		"Defeat the dragon to open the gateway to the outer End."
		""
		"This is the classic endgame boss. Come prepared."
	]
	quest.6729335784B57978.quest_subtitle: "Slay the Ender Dragon"
	quest.673F1ED4695484DC.quest_desc: [
		"An &aEncased Fan&r blows air through a source to process items on a belt or depot in front of it."
		""
		"Blow through &awater&r to wash ores and gravel, through &afire&r to smoke and cook food, and through &asoul fire&r to haunt blocks."
		""
		"One fan replaces a furnace, a smoker and a washer all at once."
	]
	quest.673F1ED4695484DC.quest_subtitle: "Wash, smoke and haunt with airflow"
	quest.67859B9298078500.quest_desc: ["Boosts the Defenses of a not-fully-evolved Pokemon by 50 percent. Makes prevos into walls."]
	quest.67D1D991292C338C.quest_desc: ["A sweet-scented sachet that evolves Spritzee into Aromatisse on trade."]
	quest.67F51A3CF0157466.quest_desc: [
		"The heart of Create Nuclear is a multiblock &aReactor&r. Build the frame from &aReactor Casing&r, add a &aReactor Controller&r, and load it with uranium rods via the Reactor Input."
		""
		"A running reactor outputs enormous rotational power through its Reactor Output."
		""
		"Assemble the reactor casing and controller to bring your reactor online."
	]
	quest.67F51A3CF0157466.quest_subtitle: "Build a nuclear reactor"
	quest.6867040658D62523.quest_desc: [
		"The &aMechanical Press&r hammers ingots into &aSheets&r, a key crafting material, and can compact items on a Depot or Belt."
		""
		"Build a Mechanical Press over a Depot, power it, and press iron into &aIron Sheets&r."
		""
		"Sheets unlock casings, tanks and much more."
	]
	quest.6867040658D62523.quest_subtitle: "Stamp out sheets and plates"
	quest.687D0FF41B2B32AF.quest_desc: ["Changes a Pokemon's nature to Gentle, reshaping its stat spread without re-breeding."]
	quest.68ACE7575F81183E.quest_desc: ["Adds a single Special Defense EV."]
	quest.68E3143310F62CDC.quest_desc: ["Maxes out the PP of a single move in one use. The premium PP booster."]
	quest.69842A9FE6D1D83B.quest_desc: ["Lowers the Speed IV for Trick Room or Gyro Ball builds."]
	quest.69941C34B58F3E01.quest_desc: ["Raises the Special Attack IV toward its maximum."]
	quest.69B0B0FB1EBD0E38.quest_desc: ["Changes a Pokemon's nature to Modest, reshaping its stat spread without re-breeding."]
	quest.6A12F68AB2E2FC65.quest_desc: [
		"The &aMechanical Piston&r pushes and pulls entire structures as a moving contraption, not just a single block like vanilla pistons."
		""
		"Build one with a &aPiston Extension Pole&r behind it and power it to extend and retract."
		""
		"This is your first &acontraption&r: a group of blocks that moves as one."
	]
	quest.6A12F68AB2E2FC65.quest_subtitle: "Move whole structures"
	quest.6A2390556B6867E8.quest_desc: ["A held item that restores a little HP every turn. The bread and butter of defensive teams."]
	quest.6A4B4A0C6266855D.quest_desc: ["Shields the holder from contact side effects like Rocky Helmet or Static."]
	quest.6A8523589EA2B1C2.quest_desc: [
		"&aVitamins&r pump a large amount of EVs into a single stat at once. They cost more than feathers but train far faster."
		""
		"Craft or trade for &aHP Up&r, &aProtein&r, &aIron&r, &aCalcium&r, &aZinc&r and &aCarbos&r, one vitamin for each of the six stats."
		""
		"Bring a stack of vitamins to fully train a competitive Pokemon."
	]
	quest.6A8523589EA2B1C2.quest_subtitle: "Premium stat boosters"
	quest.6B3669A195FB80AE.quest_desc: [
		"This pack adds &ajetpacks&r through Create Stuff \& Additions. The &aAndesite Jetpack&r is your first taste of flight, powered by a Copper Backtank."
		""
		"Fill a Backtank with air using a rotating machine, equip the jetpack, and take off."
		""
		"Craft an Andesite Jetpack and leave the ground behind."
	]
	quest.6B3669A195FB80AE.quest_subtitle: "Wear the andesite wings"
	quest.6B45A4029B04DFFC.quest_desc: ["Lowers a Pokemon's HP EVs while raising its friendship. Used to reset training or reach a friendship evolution."]
	quest.6C255FF72F2B333E.quest_desc: ["Evolves Water Pokemon like Poliwhirl and Shellder."]
	quest.6CEAD16A9F31722E.quest_desc: ["Locks the holder into one move but boosts its Attack by 50 percent."]
	quest.6D97B387BFE4207F.quest_desc: ["Boosts move power by 30 percent at the cost of chip damage each hit. A staple offensive item."]
	quest.6DA4719DA9D3C18B.quest_desc: ["A glossy, sweet-then-sour food berry. No battle use, good for cooking and dyes."]
	quest.6DBA9B5876B3E382.quest_desc: ["A held item that boosts the power of the holder's Fairy-type moves."]
	quest.6DD8C473F0A287AF.quest_desc: [
		"&aWaystones&r let you fast travel across the map. Place one, attune to it, and warp between them for a small cost."
		""
		"Craft or find a &aWaystone&r and place it near your base."
		""
		"A network of Waystones turns the whole overworld into your backyard."
	]
	quest.6DD8C473F0A287AF.quest_subtitle: "Never walk the same road twice"
	quest.6E38345EBB7E75DC.quest_desc: ["Restores 10 PP to all of a Pokemon's moves."]
	quest.6E7DCFD62C81A8FC.quest_desc: ["Halves one super-effective Psychic-type hit, helping Fighting and Poison types survive Psychic."]
	quest.6EF5321ED83ECD6C.quest_desc: ["A sweet pink Apricorn juice for on-the-go boosts."]
	quest.6F28747609CCE274.quest_desc: ["Cures a burn on a single Pokemon."]
	quest.6F2C91293EE586D3.quest_desc: ["A shiny Utility+ Speed cap variant."]
	quest.6FAD6E69068A5DA5.quest_desc: ["Adds HP EVs, the mochi counterpart to HP Up."]
	quest.6FEF46245AA194A9.quest_desc: [
		"Build a squad suited to the heat. Catch &a3 Fire type Pokemon&r in the Nether."
		""
		"Fire types resist the environment and hit hard against many foes."
		""
		"Weaken before you throw, the Nether Pokemon are tough."
	]
	quest.6FEF46245AA194A9.quest_subtitle: "A proper fire team"
	quest.703CA0D8C35A645B.quest_desc: [
		"You have opened the gate, cleared the temple and tamed the dark."
		""
		"Forge a full set of &aResonarium&r gear to seal your mastery of every dimension."
		""
		"From the overworld to the Otherside, Steamon holds no realm you have not conquered."
	]
	quest.703CA0D8C35A645B.quest_subtitle: "Sovereign of the shadow realm"
	quest.70480F6B1137D785.quest_desc: ["A Utility+ void Defense cap."]
	quest.708E0F6BC94646E8.quest_desc: [
		"You have hunted shinies, mastered held items, perfected stats and proven yourself in battle. Only one trophy remains."
		""
		"Catch a &asecond shiny Pokemon&r, a deliberate hunt this time, to seal your legacy as a master Trainer."
		""
		"There is no higher rank. You are a Champion of Steamon."
	]
	quest.708E0F6BC94646E8.quest_subtitle: "Champion of Steamon"
	quest.7107C7BDAB487C21.quest_desc: ["Halves one super-effective Fighting-type hit. Lets Normal and Steel types survive a Close Combat."]
	quest.715241A394E6B043.quest_desc: ["Evolves Sun-linked Pokemon like Gloom and Sunkern."]
	quest.716CCFD9560B8DA5.quest_desc: [
		"Battles wear your Pokemon down. A &aHealing Machine&r fully restores your whole party."
		""
		"Craft a Healing Machine (it needs Redstone and a diamond) and place it down. Power it with redstone and use it to heal your team."
		""
		"This will be the heart of your base."
	]
	quest.716CCFD9560B8DA5.quest_subtitle: "Keep your team in fighting shape"
	quest.7223A5274014E6E6.quest_desc: [
		"&aBrass&r unlocks the advanced half of Create. Crush &eZinc Ore&r for Zinc, then heat a Basin under your Mixer and alloy &eCopper&r with &eZinc&r into &aBrass Ingots&r."
		""
		"A Blaze Burner under the Basin provides the heat."
		""
		"Then craft &aBrass Casing&r to prove your foundry works."
	]
	quest.7223A5274014E6E6.quest_subtitle: "The second tier metal"
	quest.723E38A7E8441E11.quest_desc: ["A held item that boosts the power of the holder's Rock-type moves."]
	quest.72529F2BAD5B582D.quest_desc: ["Evolves Electric Pokemon such as Pikachu and Eelektrik."]
	quest.73512D315FA8BF3F.quest_desc: ["A fancy food berry once used for high-class snacks. Cooking ingredient with no battle use."]
	quest.73717D70820B1FDD.quest_desc: ["Halves Speed but adds Special Defense EVs after battle."]
	quest.73A90838A9F8B990.quest_desc: ["A sweet food berry, prized in the kitchen rather than in battle. Farm a patch and stock up."]
	quest.74057901CB46C6FC.quest_desc: ["Restores PP to all of a Pokemon's moves. A rarer PP-recovery berry for drawn-out battles."]
	quest.74208F10F2E142B6.quest_desc: ["Raises the Defense IV toward its maximum."]
	quest.742ADE7A6D2BF1CD.quest_desc: [
		"The &aBeast Ball&r is built for the strangest Pokemon. Gather a stock of them for the hardest hunts."
		""
		"Craft or collect Beast Balls."
		""
		"Save them for the Aether and the Otherside legends."
	]
	quest.742ADE7A6D2BF1CD.quest_subtitle: "Balls for the rarest catches"
	quest.747559FE31B2177C.quest_desc: ["Lowers the Special Defense IV in niche min-max builds."]
	quest.75576F9FD99EB80F.quest_desc: ["A brewed Apricorn juice that boosts a Pokemon's stats in the field."]
	quest.75BA0D99BF39BE21.quest_desc: ["An extremely sour food berry. Culinary only, best blended into recipes."]
	quest.76530D0122392A08.quest_desc: ["Halves one super-effective Ghost-type hit, protecting Psychic and other Ghost types."]
	quest.766D585BC011002D.quest_desc: [
		"A strong team wins battles. Level one of your Pokemon up to &alevel 20&r."
		""
		"Battle wild Pokemon and other Trainers to earn experience. &aRare Candies&r instantly raise a level if you find them."
		""
		"Prove you can raise a Pokemon."
	]
	quest.766D585BC011002D.quest_subtitle: "Train a Pokemon to level 20"
	quest.76D043AC17022CA9.quest_desc: [
		"A &aMechanical Belt&r carries items from one place to another. Right-click two shafts with the belt item to connect them."
		""
		"Belts are the backbone of every factory. Build a few and get items flowing."
		""
		"Everything downstream depends on a moving belt."
	]
	quest.76D043AC17022CA9.quest_subtitle: "Move items across your base"
	quest.77598B4BD0E37377.quest_desc: [
		"An &aItem Vault&r is a large, connectable storage block. Place several together and they merge into one huge inventory."
		""
		"Funnels and arms can pull from and push to a Vault, making it the warehouse of your factory."
		""
		"Build a Vault and connect it to a belt to buffer your production."
	]
	quest.77598B4BD0E37377.quest_subtitle: "Bulk item storage"
	quest.775ACA2AE92227E9.quest_desc: [
		"Fire and Dark type Pokemon thrive in the heat of the Nether."
		""
		"Catch a Pokemon while you are in the Nether."
		""
		"These species rarely appear anywhere else."
	]
	quest.775ACA2AE92227E9.quest_subtitle: "Fire in the blood"
	quest.77E4C16D8EBB59D7.quest_desc: [
		"The strongest rotation source in Create is a &aSteam Engine&r on a &aFluid Tank&r boiler. Heat water with blaze burners to build boiler power, then tap it with engines."
		""
		"A fully superheated multi-engine boiler can run your entire factory."
		""
		"Build a Fluid Tank boiler and mount a Steam Engine on it."
	]
	quest.77E4C16D8EBB59D7.quest_subtitle: "Steam power at scale"
	quest.7808D45744C35AEE.quest_desc: ["Held item that raises Defense when the holder is hit by a physical move. Turns an incoming hit into a setup."]
	quest.784CA6BB23DCB72E.quest_desc: [
		"Deep in the Otherside stands a &aTemple&r holding the &aHeart of the Deep&r, its greatest treasure."
		""
		"Explore the temple and claim the Heart of the Deep."
		""
		"It is the key to the realm's finest crafts."
	]
	quest.784CA6BB23DCB72E.quest_subtitle: "The Otherside Temple"
	quest.78B8EBAC59E95DBA.quest_desc: ["A suspicious disc that evolves Porygon2 into Porygon-Z."]
	quest.791227C8CBDED02B.quest_desc: [
		"&aBastion Remnants&r are piglin strongholds full of gold, gear and &aAncient Debris&r hints."
		""
		"Loot a bastion and bring back its treasures. Watch the piglins, wear your gold."
		""
		"This is where the road to Netherite begins."
	]
	quest.791227C8CBDED02B.quest_subtitle: "Raid the bastion"
	quest.79779A27A0335696.quest_desc: ["Cures any single status condition on a Pokemon."]
	quest.79A3BC35DD7F0C88.quest_desc: ["Restores 10 PP to a single move when held or used. Keeps a key attack from running dry in long fights."]
	quest.79D288DD0E67538B.quest_desc: [
		"The &aRotation Speed Controller&r sits under a large cogwheel and lets you set the output speed to any value you want with a scroll of the wheel."
		""
		"Many machines only work in a narrow speed range. The RSC gives you precise control over your whole network."
		""
		"No more guessing with cogwheel ratios."
	]
	quest.79D288DD0E67538B.quest_subtitle: "Set an exact rotation speed"
	quest.79F9DFB58FC68B31.quest_desc: [
		"The &aSequenced Gearshift&r runs a programmed sequence of moves: turn so many degrees, wait, reverse, and so on."
		""
		"This is how you build machines that repeat a precise mechanical routine on their own."
		""
		"It is also the driver behind sequenced assembly."
	]
	quest.79F9DFB58FC68B31.quest_subtitle: "Timed, repeatable motion"
	quest.7A6122D4891EE43B.quest_desc: ["Raises Speed when HP runs low. The core of many pinch-sweep setups, outpacing the whole field."]
	quest.7A65BD80A9CC734B.quest_desc: ["A Utility+ relic that reverses an evolution, sending a Pokemon back a stage."]
	quest.7AEB7A40BBCCB99A.quest_desc: ["Fully restores a Pokemon's HP."]
	quest.7B078090B15F5093.quest_desc: ["A held band that boosts the power of physical moves by 10 percent."]
	quest.7B1D3463CD4D6E7B.quest_desc: ["Heals Poison types each turn but harms everyone else. Poison-type Leftovers."]
	quest.7B390BAE8ED58355.quest_desc: ["Wakes a sleeping Pokemon instantly. Held before a Rest, it lets you heal to full and act on the same turn."]
	quest.7B63BDBF02CC4CA0.quest_desc: ["Sharply raises the critical-hit ratio when HP runs low, making nearly every hit a crit."]
	quest.7CB5661D486CF43B.quest_desc: ["The universal cure: heals any single status condition, including confusion. One of the most reliable held berries in competitive play."]
	quest.7CD6915D3DF8ED65.quest_desc: [
		"You have beaten the dragon, looted the cities and earned your wings."
		""
		"Gather &aGlowstone&r and &aWater Buckets&r, for a very different portal awaits."
		""
		"The Aether calls those who have conquered the End."
	]
	quest.7CD6915D3DF8ED65.quest_subtitle: "The sky is not the limit"
	quest.7D6E430C26EDE06C.quest_desc: ["A held or in-battle Cheri Berry cures paralysis, letting a Pokemon move freely again. Handy on fast sweepers that hate being locked down."]
	quest.7D6FB54D986EB3DF.quest_desc: [
		"The &aAether&r portal is built like a Nether portal but framed in &aGlowstone&r."
		""
		"Build a glowstone frame, then activate it by pouring &awater&r inside instead of using fire."
		""
		"Gather the glowstone to begin."
	]
	quest.7D6FB54D986EB3DF.quest_subtitle: "A gateway of glowstone"
	quest.7DABE28A86480F2F.quest_desc: ["A tangy food berry for cooking and juices. No battle effect, but easy to farm in bulk."]
	quest.7DCE0F34B0E1360E.quest_desc: ["Evolves certain Fire-related Pokemon such as Vulpix and Growlithe."]
	quest.7E42887E4B81614D.quest_desc: ["A Utility+ cap that guarantees a high Attack IV floor."]
	quest.7E453D568132465C.quest_desc: ["Lowers Special Defense EVs and raises friendship. A gentle way to fix an over-trained spread."]
	quest.7E4CBD441FEAA432.quest_desc: ["Fully restores HP and cures any status condition at once."]
	quest.7E5FB52E190E7B4A.quest_desc: [
		"Ride the outer End gateway to the &aEnd Cities&r, towers full of loot and shulkers."
		""
		"Loot an End City and bring back a &aShulker Shell&r."
		""
		"Shulker boxes are the best portable storage in the game."
	]
	quest.7E5FB52E190E7B4A.quest_subtitle: "Plunder the End Cities"
	quest.7E62BDDF9A21402E.quest_desc: [
		"The &aWrench&r is your most used tool in Create. Use it to rotate components and to dismantle them by sneaking."
		""
		"Craft one from Andesite Alloy and an iron sheet."
		""
		"Never build without it."
	]
	quest.7E62BDDF9A21402E.quest_subtitle: "Multi purpose tool for kinetics"
	quest.7F19A9B9B2BDE1A9.quest_desc: [
		"A living record of every Pokemon you have met is the mark of a dedicated Trainer. Build your &aPokedex&r toward completion."
		""
		"Catch &a50 Pokemon&r in total across your adventure, chasing every species, form and colour you can find."
		""
		"Real dex completion is a lifelong goal. This is a serious milestone toward it."
	]
	quest.7F19A9B9B2BDE1A9.quest_subtitle: "Fill the Pokedex"
	quest.7FA54ED3268E1447.quest_desc: [
		"&aShiny Pokemon&r are alternately coloured and extremely rare, roughly one in every few thousand encounters. They are the ultimate trophy for a Trainer."
		""
		"Search, battle and breed until fortune smiles on you, then catch a &ashiny Pokemon&r of any species."
		""
		"This is the beginning of your endgame. Good luck, hunter."
	]
	quest.7FA54ED3268E1447.quest_subtitle: "The hunt for a rare colour"
	quest.7FEA374D63883FC9.quest_desc: ["A pinch berry: when HP drops low it sharply raises Attack, turning a near-faint into a sweep."]
	task.10EF9DB906E0FDD4.title: "Obtain a Waystone (craft or break one in a village)"

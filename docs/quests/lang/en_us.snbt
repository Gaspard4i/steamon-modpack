	quest.C94C21D4798ACAAE.quest_subtitle: "End's Delight"
	quest.C94C21D4798ACAAE.title: "Grilled Shulker"
	quest.C95C54898F425D8D.quest_desc: [
		"A &aMechanical Mixer&r over a &aBasin&r can substitute for hand-mixing many Farmer's Delight recipes."
		""
		"Add a Blaze Burner underneath for heated recipes."
	]
	quest.C95C54898F425D8D.quest_subtitle: "Automate mixed recipes with a Mixer"
	quest.C95C54898F425D8D.title: "Mixing at Scale"
	quest.C9748421599E3E9C.quest_desc: [
		"A warming soup made from chicken and vegetables."
		""
		"Cook and obtain one to add it to your culinary collection."
	]
	quest.C9748421599E3E9C.quest_subtitle: "Farmer's Delight"
	quest.C9748421599E3E9C.title: "Chicken Soup"
	quest.C97713DAF3405DFF.quest_desc: [
		"Melt cheese with a lava-heated cauldron under a Cooking Pot to make &aFiery Fondue&r."
		""
		"A spicy centerpiece dish for the brave."
	]
	quest.C97713DAF3405DFF.quest_subtitle: "Cook Fiery Fondue with a cauldron"
	quest.C97713DAF3405DFF.title: "Fire Breather"
	quest.C97B2C1D0E2ADCD9.quest_desc: [
		"A Cooking Pot feast of smoked ham glazed in honey, the centerpiece of a Farmer's Delight table."
		""
		"Cook and obtain one to add it to your culinary collection."
	]
	quest.C97B2C1D0E2ADCD9.quest_subtitle: "Farmer's Delight"
	quest.C97B2C1D0E2ADCD9.title: "Honey Glazed Ham"
	quest.C9AC9ED336DE7DAE.quest_desc: [
		"A Cooking Pot feast block, mutton and potato baked under a crust. Serves the whole table."
		""
		"Cook and obtain one to add it to your culinary collection."
	]
	quest.C9AC9ED336DE7DAE.quest_subtitle: "Farmer's Delight"
	quest.C9AC9ED336DE7DAE.title: "Shepherd's Pie"
	quest.377B589AE8FB35E7.description: [
		"Some prey needs a specialized net, not brute force.",
		"",
		"The Net Ball gets a strong bonus against Water and Bug type Pokemon, making it the go to choice near lakes, oceans, and bug infested undergrowth.",
		"",
		"Worth keeping a stack for exactly those encounters."
	]
	quest.377B589AE8FB35E7.subtitle: "Specialize your catches"
	quest.377B589AE8FB35E7.title: "&9Net Ball&r"
	quest.0E3A1A9561E38E87.description: [
		"Every trainer's journey runs through this Ball, humble as it looks.",
		"",
		"Craft it from red Apricorns, found growing on Apricorn trees in the wild. It's cheap, it's reliable, and you should never be caught without a stack.",
		"",
		"Keep this recipe close, you'll be crafting these by the dozen."
	]
	quest.0E3A1A9561E38E87.subtitle: "Never leave home without one"
	quest.0E3A1A9561E38E87.title: "&cThe Standard Poke Ball&r"
	quest.167442E180611782.description: [
		"A farm you have to babysit isn't much of a farm.",
		"",
		"Pokemon placed in a Pasture are protected from despawning and from most sources of damage, they'll simply be there, safe, whenever you come back.",
		"",
		"Set your Pasture up once, then stop worrying about it."
	]
	quest.167442E180611782.subtitle: "Optional, peace of mind"
	quest.167442E180611782.title: "&aSafe Pastures&r"
	quest.2633B33E9ED60B09.description: [
		"Apricorns work fine for a handful of Balls. They won't cut it once you need hundreds.",
		"",
		"Using Create, you can automate Ball production from blank Balls, dyes, and Sequenced Assembly, turning a manual chore into a steady output.",
		"",
		"Follow the link to Sparks \& Circuits to start building your own factory line."
	]
	quest.2633B33E9ED60B09.subtitle: "Optional, from handful to assembly line"
	quest.2633B33E9ED60B09.title: "&6Ball Factory&r"
	quest.4B9E126E287F51EC.description: [
		"The dark hides plenty of things. This Ball is built for hunting in it.",
		"",
		"The Dusk Ball gets a major bonus at night or underground/in caves, exactly where a lot of your best exploration happens.",
		"",
		"Stock up before any caving or nighttime expedition."
	]
	quest.4B9E126E287F51EC.subtitle: "The hunter's ball"
	quest.4B9E126E287F51EC.title: "&4Dusk Ball&r"
	quest.344DBC48503D19DC.description: [
		"When the odds are stacked against you, this is the Ball you reach for.",
		"",
		"The Ultra Ball is the strongest of the standard line, built for high level Pokemon that shrug off anything weaker.",
		"",
		"&eTip:&r once you're deep into Create, you can mass produce these on an assembly line instead of crafting them one by one, see the Ball Factory."
	]
	quest.344DBC48503D19DC.subtitle: "The top standard tier"
	quest.344DBC48503D19DC.title: "&6Ultra Ball&r"
	quest.2AB04ECF48DE57D9.description: [
		"When a standard Ball isn't cutting it, this one picks up the slack.",
		"",
		"The Great Ball offers a noticeably better catch rate than the basic Poke Ball, worth crafting a batch before you go after something tougher.",
		"",
		"A staple for anyone catching Pokemon that fight back harder."
	]
	quest.2AB04ECF48DE57D9.subtitle: "A step up in reliability"
	quest.2AB04ECF48DE57D9.title: "&9Great Ball&r"
	quest.5AF70B122DBEEFB2.description: [
		"A tired team loses battles. A healed team wins them.",
		"",
		"Place a &aHealing Machine&r and power it with a redstone signal: your entire party is restored to full HP and cured of status conditions in seconds, no potions needed.",
		"",
		"Set one up as a hub near your base, it's cheaper than stacking potions in the long run."
	]
	quest.5AF70B122DBEEFB2.subtitle: "Your team's safe haven"
	quest.5AF70B122DBEEFB2.title: "&aBack to Full Health&r"
	quest.0E411D4F2A158EAE.description: [
		"A starter is a gift. A catch is earned.",
		"",
		"Weaken a wild Pokemon (lower its HP, and a status like sleep or paralysis helps a lot), then throw a Poke Ball at it. The lower its health and the worse its condition, the higher your odds.",
		"",
		"Catch 1 wild Pokemon, any species, to prove you've got the basics down."
	]
	quest.0E411D4F2A158EAE.subtitle: "Your first real capture"
	quest.0E411D4F2A158EAE.title: "&cGotta Catch One&r"
	quest.537FA2FE2D662CE7.description: [
		"Six slots in your party isn't the end of your collection, it's just the front row.",
		"",
		"Place down a &9PC&r and open it: you get 30 boxes to store Pokemon in. Drag a Pokemon from your party into a box, or pull one out, anytime you're near a PC.",
		"",
		"You will never be forced to release a Pokemon just because your party is full."
	]
	quest.537FA2FE2D662CE7.subtitle: "Never run out of room"
	quest.537FA2FE2D662CE7.title: "&9The Storage System&r"
	quest.2B91F64B1F2070CC.description: [
		"Somewhere near spawn stands a monolith. Interact with it and three Poke Balls will offer you a choice that starts every great journey.",
		"",
		"&eTip:&r picking your starter is a separate action from catching wild Pokemon, you won't spend a Poke Ball here. Choose wisely, this partner will be with you for a long time.",
		"",
		"This is the first member of your team. Everything else builds from here."
	]
	quest.2B91F64B1F2070CC.subtitle: "One choice, one bond"
	quest.2B91F64B1F2070CC.title: "&dChoose Your Partner&r"
	quest.63764ABC4C940F73.description: [
		"Why carry a PokeNav, a stack of Waystone tickets, and a healing routine separately when one device can do it all?",
		"",
		"The Smartphone bundles the PokeNav, Waystone travel, and healing access into a single item. &eIts vanilla crafting recipe is disabled&r, it can only be built with Create's Mechanical Crafter.",
		"",
		"Follow the link to the Sparks \& Circuits chapter to see how it's made, your first real reason to dive into Create."
	]
	quest.63764ABC4C940F73.subtitle: "Optional, one device to rule them all"
	quest.63764ABC4C940F73.title: "&6The Cobblemon Smartphone&r"
	quest.44FCB07F176B20CD.description: [
		"Look at that, a real Trainer already. You've learned the basics: catching, healing, storing, and bonding with your team.",
		"",
		"Everything from here builds on what you just did: better Balls, deeper mechanics, and the two worlds of Steamon working together.",
		"",
		"Head into &cThe Type Trials&r when you're ready, your Pokemon are waiting."
	]
	quest.44FCB07F176B20CD.subtitle: "On to the next chapter"
	quest.44FCB07F176B20CD.title: "&cTrainer Ready&r"
	quest.59446C3A7B96E114.description: [
		"Every shiny hunter needs a number to watch climb.",
		"",
		"The encounter counter tracks how many times you've run into a given species, resettable per hunt and visible right in your HUD.",
		"",
		"Not required to progress, but essential if you're chasing that shiny odds streak."
	]
	quest.59446C3A7B96E114.subtitle: "Optional, for the hunters"
	quest.59446C3A7B96E114.title: "&cKeep Count&r"
	quest.2F2784A26CE0407F.description: [
		"Some Pokemon aren't just teammates, they're rides.",
		"",
		"Certain species can be mounted on land, across water, or through the air. Enable riding on a compatible Pokemon and use the dedicated mount key to hop on and take off.",
		"",
		"&eTip:&r Aprijuice (see Poke-Cuisine) can boost a mount's speed and stamina, worth brewing once you're covering real distance."
	]
	quest.2F2784A26CE0407F.subtitle: "Travel with your team"
	quest.2F2784A26CE0407F.title: "&6Ride \& Fly&r"
	quest.237F5DCBB34F5FBD.description: [
		"Not every Pokemon needs to sit in a Poke Ball forever.",
		"",
		"Place a &aPasture&r and send Pokemon into it: they'll wander freely around it without despawning or wandering off. Right click the Pasture to tweak its radius and how many Pokemon it can hold.",
		"",
		"This is the start of your own living farm, breeding, storage, and decoration all in one."
	]
	quest.237F5DCBB34F5FBD.subtitle: "A home outside the ball"
	quest.237F5DCBB34F5FBD.title: "&aLet Them Roam&r"
	quest.34DEA4F8E317BB02.description: [
		"Why make two trips when one will do?",
		"",
		"A Pokemon caught in a Heal Ball comes out fully healed, no detour to a Healing Machine required.",
		"",
		"Perfect for long expeditions far from your base."
	]
	quest.34DEA4F8E317BB02.subtitle: "Catch and heal in one throw"
	quest.34DEA4F8E317BB02.title: "&aHeal Ball&r"
	quest.1683A11A35417B74.description: [
		"Rare spawns don't wait around, and neither should you.",
		"",
		"Turn on spawn alerts in your HUD settings to get notified when something rare, or shiny, appears nearby.",
		"",
		"A shiny that despawns unseen is a story you don't want to tell."
	]
	quest.1683A11A35417B74.subtitle: "Optional, don't miss a shiny"
	quest.1683A11A35417B74.title: "&cNearby Encounters&r"
	quest.0A34A253060DF69E.description: [
		"Ever wonder if that Ball was even worth throwing? Now you don't have to guess.",
		"",
		"The catch indicator shows your live capture chance above a wild Pokemon, color coded from red (unlikely) to green (great odds).",
		"",
		"Wait for green when you can, it saves your Balls for the catches that matter."
	]
	quest.0A34A253060DF69E.subtitle: "Optional, know before you throw"
	quest.0A34A253060DF69E.title: "&cRead the Odds&r"
	quest.4F0C4959E0ECDDA1.description: [
		"Wild spawns aren't always in plain sight. The PokeNav makes sure you never miss them.",
		"",
		"Craft or find a &6PokeNav&r and bind it to a hotkey: it acts as both a radar and a pocket dex, pointing you toward nearby Pokemon.",
		"",
		"&eTip:&r later on, the Cobblemon Smartphone folds the PokeNav into a single all-in-one device."
	]
	quest.4F0C4959E0ECDDA1.subtitle: "Never wander blind"
	quest.4F0C4959E0ECDDA1.title: "&6The PokeNav&r"
	quest.38035D1640A05BEB.description: [
		"This isn't Palworld, your Pokemon aren't tools. The bond you build with them actually matters.",
		"",
		"Friendship rises as you walk together, battle together, and heal them when they're hurt. Some Pokemon only evolve once their friendship is high enough, no amount of levels will substitute for it.",
		"",
		"Level a Pokemon up to level 15 or higher while keeping it close, a good proxy for a growing bond. Watch for the signs, evolution is often just around the corner."
	]
	quest.38035D1640A05BEB.subtitle: "This isn't Palworld"
	quest.38035D1640A05BEB.title: "&dBonds of Friendship&r"
	quest.371C7E049B843129.description: [
		"Sometimes the best thing you can do for your Pokemon is just say hello.",
		"",
		"Shift and click on a Pokemon to pet it. It's a small gesture, but it can lift its mood and strengthen your bond over time.",
		"",
		"Purely optional, purely wholesome."
	]
	quest.371C7E049B843129.subtitle: "Optional, but worth it"
	quest.371C7E049B843129.title: "&dA Gentle Touch&r"
	quest.3062B493AFA48A7F.description: [
		"A bare mechanism is just a spinning axle. Casing is what turns it into a proper machine.",
		"",
		"Craft 1 &8Andesite Casing&r (Andesite Alloy + a stripped log + andesite at a crafting table). It dresses up shafts and cogs, and almost every processing machine in this tier requires it as an ingredient.",
		"",
		"This is the key that unlocks millstones, presses, mixers, and fans alike: everything from here branches out from this one block."
	]
	quest.3062B493AFA48A7F.subtitle: "What makes a machine \"real\""
	quest.3062B493AFA48A7F.title: "&8Andesite Casing"
	quest.5CF9FEFF2FA5311C.description: [
		"Time to retire the hand crank: this is your first real, automatic source of power.",
		"",
		"Craft 1 &dWater Wheel&r and place it against flowing water (4 blocks on at least one side, facing the right way). It generates a steady &cStress&r capacity for free, no fuel needed. A &dLarge Water Wheel&r produces even more.",
		"",
		"Chain several wheels together to feed bigger networks. This is the moment your factory stops depending on you standing there clicking."
	]
	quest.5CF9FEFF2FA5311C.subtitle: "Let the river do the work"
	quest.5CF9FEFF2FA5311C.title: "&dThe Water Wheel"
	quest.22483B405C807FC6.description: [
		"Your first processing machine needs no belts, no fluids, just rotation.",
		"",
		"Craft 1 &6Millstone&r. Drop an item on top and give it &dRotational Power&r: it grinds ores into dust, wheat into flour, and plenty more, one item at a time, output through the bottom or by hand.",
		"",
		"It is slow but dead simple: your first real transformation process, and the seed of every processing line you will build afterward."
	]
	quest.22483B405C807FC6.subtitle: "Grinding without a factory"
	quest.22483B405C807FC6.title: "&6The Millstone"
	quest.6686A261B372DB31.description: [
		"Flattening, stamping, compressing: one machine handles it all.",
		"",
		"Craft 1 &6Mechanical Press&r. Place it above a Depot or Belt and give it &dRotational Power&r: it presses items into sheets and compacts stacks into blocks. Pair it with a &6Basin&r underneath for 2x2 or 3x3 compacting recipes.",
		"",
		"Sheets and compacted blocks feed into an enormous number of later recipes: this machine earns its keep fast."
	]
	quest.6686A261B372DB31.subtitle: "The press that does it all"
	quest.6686A261B372DB31.title: "&6Under Pressure"
	quest.37E6F9BA2855E71B.description: [
		"Some recipes need more than one ingredient combined at once. That is where the mixer comes in.",
		"",
		"Craft 1 &6Mechanical Mixer&r and 1 &6Basin&r, then stack the mixer directly above the basin. Feed it &dRotational Power&r of at least &e30 RPM&r (check with a speedometer) and drop ingredients into the basin: it blends them into the recipe's output below.",
		"",
		"Mixing recipes are the backbone of compound crafting, and later, of alloys."
	]
	quest.37E6F9BA2855E71B.subtitle: "30 RPM or it does not start"
	quest.37E6F9BA2855E71B.title: "&6Mixing It Up"
	quest.741D67AF5AB207C8.description: [
		"Fluids need their own kind of machine, and their own kind of casing. Craft 4 &bCopper Casing&r (press a copper ingot into a sheet first, then combine with a log): it is the base ingredient for every machine that moves or stores &bfluids&r, your ticket into pumps, pipes, tanks and spouts.",
		"",
		"You have now touched all three pillars of early &6Create&r: &dRotation&r (kinetics), &6Processing&r (the machines) and soon &bFluids&r. You do not need to master every branch below, just explore what interests you.",
		"",
		"This checkpoint validates the basics of your workshop and unlocks the branches ahead: kinetics, processing tools, and the fluid systems."
	]
	quest.741D67AF5AB207C8.subtitle: "Your workshop takes shape"
	quest.741D67AF5AB207C8.title: "&bMachine Shop"
	quest.056236D977A63503.description: [
		"Every kinetic network needs an axle to carry the spin from one machine to the next, and cogs to decide where that spin goes.",
		"",
		"Craft 8 &dShaft&r, 4 &dCogwheel&r and 2 &dLarge Cogwheel&r. A &dShaft&r transmits &dRotational Power&r in a straight line, through walls and floors alike. A &dCogwheel&r meshed at a 90 degree angle redirects rotation AND flips its spin direction. Mesh a large cog with a small one and you double or halve the speed, depending on which side drives the other.",
		"",
		"Master this and you control both the direction and the speed of every machine downstream: the first link of any contraption you will ever build."
	]
	quest.056236D977A63503.subtitle: "The teeth that turn the world"
	quest.056236D977A63503.title: "&dGears \& Shafts"
	quest.27B794995280FD42.description: [
		"Sometimes rotation needs to change direction entirely, or stop on command.",
		"",
		"Craft 1 &6Gearbox&r and 1 &6Gearshift&r. The &6Gearbox&r splits a shaft into up to 4 directions. The &6Gearshift&r cuts the rotational flow on a redstone signal, or INVERTS the direction instead of stopping it, depending on how you configure it.",
		"",
		"With these two you can build systems that start, stop, and reverse on command, no rebuilding required."
	]
	quest.27B794995280FD42.subtitle: "Route it, cut it, flip it"
	quest.27B794995280FD42.title: "&6Gearbox \& Clutch"
	quest.5DC0686927656313.description: [
		"No river nearby? The wind works just as well, if you are willing to build a bit more.",
		"",
		"Craft 1 &dWindmill Bearing&r and at least 8 &dSail&r blocks glued to a frame behind it, then right click the bearing to activate. The wind turns the whole structure and generates &cStress&r, scaled to how many sails you attach.",
		"",
		"A great option in the desert, on a mountaintop, or anywhere water is inconvenient."
	]
	quest.5DC0686927656313.subtitle: "An alternative to the river"
	quest.5DC0686927656313.title: "&dCatch the Wind"
	quest.69DC22D5CEBB41C4.description: [
		"Before you automate anything, sometimes you just need a quick burst of power.",
		"",
		"Craft 1 &8Hand Crank&r. Right click it repeatedly for a short burst of &dRotational Power&r: perfect for testing a machine, popping open a door, or running something once without wiring up a real source.",
		"",
		"It will not power a factory, but it is the fastest way to check that your contraption actually works before you commit to a permanent source."
	]
	quest.69DC22D5CEBB41C4.subtitle: "Powered by elbow grease"
	quest.69DC22D5CEBB41C4.title: "&8Hand Crank"
	quest.43509FBF8B57D6EA.description: [
		"The Millstone processes one item at a time. When you need real throughput, the Crushing Wheels take over.",
		"",
		"Craft 2 &6Crushing Wheel&r and place them side by side, spinning in opposite directions, with a belt or hopper feeding items into the gap between them. They crush ores, cobblestone and more in bulk, often with a bonus output the Millstone cannot match.",
		"",
		"This is the upgrade path from single-item grinding to a real ore processing line."
	]
	quest.43509FBF8B57D6EA.subtitle: "Ores in, more ores out"
	quest.43509FBF8B57D6EA.title: "&6Crushing Wheels"
	quest.33718AA16E638ADC.description: [
		"One of the most underrated machines in &6Create&r: a single block that replaces a furnace, a bucket of water, and more.",
		"",
		"Craft 1 &6Encased Fan&r. Give it &dRotational Power&r &d&oclockwise&r and it blows air away from itself; &d&ocounter-clockwise&r and it sucks air toward itself. Place &cLava&r in front of it to &6Blast&r items like a furnace. Place &6Fire&r in front to &6Smoke&r them. Place &bWater&r in front to &bWash&r them (sand into concrete powder, for example, becomes concrete).",
		"",
		"One cheap block, three completely different processes: this is where bulk processing starts."
	]
	quest.33718AA16E638ADC.subtitle: "This blows!"
	quest.33718AA16E638ADC.title: "&6The Encased Fan"
	quest.37055A0A9369FB63.description: [
		"Now that your &6Encased Fan&r is running, put its three modes to work.",
		"",
		"Use the fan to &6Blast&r an item (lava in front, like a furnace), &6Smoke&r an item (fire in front, like a smoker) or &bWash&r an item (water in front, turning gravel into sand and sand into concrete powder among other conversions). Try any one of the three to complete this.",
		"",
		"A single block quietly replacing three separate contraptions: this is bulk processing without the fuss."
	]
	quest.37055A0A9369FB63.subtitle: "One fan, three processes"
	quest.37055A0A9369FB63.title: "&cBlast, Smoke, Wash"
	quest.37ECF341AF585DED.description: [
		"Even a farm can be mechanized, if you give it a bit of rotation.",
		"",
		"Craft 1 &aRoost&r from Create: Integrated Farming. It automates animal husbandry (eggs, feathers, and more) using &dRotational Power&r instead of loose mobs wandering your base. Its companion, the fishing net, does the same for passive fishing.",
		"",
		"A gentle, on-theme way to automate farming without leaving the world of cogs and belts."
	]
	quest.37ECF341AF585DED.subtitle: "A farm that runs itself"
	quest.37ECF341AF585DED.title: "&aChicken Roost"
	quest.73B1C37E9C5C1053.description: [
		"A tank full of water does nothing until it can actually move, and nowhere to go once it does.",
		"",
		"Craft 1 &6Mechanical Pump&r, 8 &bFluid Pipe&r and 1 &bFluid Tank&r. Pipes carry water, lava, honey and more between machines; the pump forces fluid to move and sets the direction; pipes must form a closed loop between a source and a destination to work. Stack tanks together and they merge into one giant reservoir, with a window showing the current fluid level.",
		"",
		"Once fluids can move and be stored on their own, you can feed any machine downstream automatically."
	]
	quest.73B1C37E9C5C1053.subtitle: "Making liquids flow"
	quest.73B1C37E9C5C1053.title: "&bFluid Foundations"
	quest.47E5EB44AA25E6AB.description: [
		"Bottling potions, filling buckets, soaking an item in fluid: this is the machine for that.",
		"",
		"Craft 1 &bSpout&r and 1 &bCopper Valve Handle&r (to control fluid flow by hand). Place the spout above a Depot or Belt and pipe a &bfluid&r into it: it fills whatever item passes underneath (bottles, buckets, blaze cakes, and more).",
		"",
		"This is the foundation of automated bottling and filling lines, and a sneak peek at what awaits Poke Balls later on."
	]
	quest.47E5EB44AA25E6AB.subtitle: "Filling anything that holds liquid"
	quest.47E5EB44AA25E6AB.title: "&bThe Spout"
	quest.499D5A8F8C8EDB30.description: [
		"Machines are only useful if items can get in and out of them automatically.",
		"",
		"Craft 2 &eChute&r and 1 &eAndesite Funnel&r. The &eChute&r moves items straight down between inventories. The &eFunnel&r inserts and extracts items between an inventory and a Belt, in whichever direction you point it.",
		"",
		"This is the basic logistics kit of the andesite tier: brass will offer smarter tools later, but this is where item automation begins."
	]
	quest.499D5A8F8C8EDB30.subtitle: "Moving items without touching them"
	quest.499D5A8F8C8EDB30.title: "&eItem Logistics"
	quest.53106940FBFDE4BE.description: [
		"Sometimes you do not want a bucket at a time, you want the whole lake.",
		"",
		"Craft 1 &bHose Pulley&r. Lower it into a body of water or lava and it pumps out (or dumps in) massive quantities of fluid in one go. Pair it with a pump and a tank for a virtually endless fluid reservoir.",
		"",
		"This closes the fluids branch: you can now source, move, store and dispense liquids at any scale you need."
	]
	quest.53106940FBFDE4BE.subtitle: "Drain an ocean, fill a valley"
	quest.53106940FBFDE4BE.title: "&bHose Pulley"
	quest.47ED753E40A4E523.description: [
		"Not every machine tells you what it is doing. Sometimes you need to look closer.",
		"",
		"Craft 1 pair of &eEngineer's Goggles&r and wear them. They reveal hidden information overlaid on Create machines: fluid levels in tanks and basins, item contents on belts, and more that is otherwise invisible.",
		"",
		"Keep them on whenever you are debugging a contraption: half of Create troubleshooting is just seeing what is actually happening."
	]
	quest.47ED753E40A4E523.subtitle: "Seeing the machine's insides"
	quest.47ED753E40A4E523.title: "&eEngineer's Goggles"
	quest.6A6D495892A224F8.description: [
		"Every &6Create&r player hits this wall eventually: your whole network grinds to a halt at once, and you need a tool to fix it.",
		"",
		"Craft 1 &8Wrench&r. Right click any &6Create&r block to rotate, reconfigure or instantly pick it back up without breaking it. Every rotation source supplies a fixed &cStress&r capacity, and every machine consumes some: the moment consumption exceeds supply, the ENTIRE network turns &c&lOverstressed&r and stops dead.",
		"",
		"With a wrench in hand you can rewire a contraption on the fly instead of breaking and replacing blocks by hand."
	]
	quest.6A6D495892A224F8.subtitle: "Why did everything just stop?"
	quest.6A6D495892A224F8.title: "&8The Wrench"
	quest.630AC1E25A44E238.description: [
		"Regular crafting tables work fine, but Create has a flashier way to build complex items.",
		"",
		"Craft 1 &aCrafting Blueprint&r. Place it on a wall like a picture frame, then right click to arrange ingredients directly on it: it acts as a crafting table you can decorate and display at the same time.",
		"",
		"A small comfort upgrade, purely optional, for players who want their workshop to look like one."
	]
	quest.630AC1E25A44E238.subtitle: "Crafting, framed and mounted"
	quest.630AC1E25A44E238.title: "&aCrafting Blueprint"
	quest.72D61CB7B2ABA690.description: [
		"Building a perfectly symmetrical structure by hand is tedious and error prone.",
		"",
		"Craft 1 &aWand of Symmetry&r. Right click to place a mirror plane anywhere in the world, then every block you place on one side is instantly mirrored on the other, across as many axes as you configure.",
		"",
		"A huge time saver for factories, towers, and any build that needs to look the same on both sides."
	]
	quest.72D61CB7B2ABA690.subtitle: "Build half, get it all"
	quest.72D61CB7B2ABA690.title: "&aWand of Symmetry"
	quest.238DA14E6210F144.description: [
		"Not every automation needs a whole contraption: some tools just work in place.",
		"",
		"Craft 1 &6Mechanical Drill&r and 1 &6Mechanical Saw&r. Mounted in a fixed position and given &dRotational Power&r, the &6Drill&r breaks whatever block is in front of it, while the &6Saw&r cuts logs into planks (and more, once other mods add recipes).",
		"",
		"A small, low-effort way to automate block breaking or wood processing without building a moving contraption."
	]
	quest.238DA14E6210F144.subtitle: "Tools that work without you"
	quest.238DA14E6210F144.title: "&6Mechanical Tools"
	quest.13C41FAE71D80306.description: [
		"Storage runs out fast once you start hoarding Create materials.",
		"",
		"Craft 1 &8Compressed Cogwheel Block&r. Create: Compressed lets you compact resources into dense blocks to save space and cut down on trips, then decompress them back on demand whenever you need the raw materials again.",
		"",
		"An easy early win for storage and hauling, long before you have proper storage solutions set up."
	]
	quest.13C41FAE71D80306.subtitle: "Squeeze nine into one"
	quest.13C41FAE71D80306.title: "&8Compressed!"
	quest.05DCA23B4E98DD0E.description: [
		"One layer of compacting was not enough for the real hoarders out there.",
		"",
		"Craft 1 &8Compressed Brass Sheet Block&r. Create: Compressed keeps stacking multipliers on top of each other, letting entire chests of sheets and plates collapse into a handful of blocks.",
		"",
		"Purely a storage convenience, but one that saves an enormous amount of chest space over a full playthrough."
	]
	quest.05DCA23B4E98DD0E.subtitle: "Compressing the compressed"
	quest.05DCA23B4E98DD0E.title: "&8Tighter Still"
	quest.110E0E09CEE657A2.description: [
		"Every builder eventually needs an unreasonable amount of cobblestone.",
		"",
		"Gather 64 &8Cobblestone&r any way you like, then look into Create: Cobblestone's generator: it produces cobblestone automatically, powered by &dRotational Power&r, no lava-and-water bucket contraption required.",
		"",
		"A small convenience, but one that saves a lot of pickaxe swings over the life of your base."
	]
	quest.110E0E09CEE657A2.subtitle: "Cobblestone, on tap"
	quest.110E0E09CEE657A2.title: "&8Endless Stone"
	quest.3FBC19CFF348DDEE.description: [
		"Gearboxes, tools and compacted cogwheels: you have explored the rotation branch in depth.",
		"",
		"This checkpoint confirms you are comfortable routing, tooling and compacting kinetic parts. No single path is required, exploring any two of them is proof enough."
	]
	quest.3FBC19CFF348DDEE.subtitle: "You speak the language of gears"
	quest.3FBC19CFF348DDEE.title: "&dKinetic Apprentice"
	quest.32BE7A97CE942A73.description: [
		"Pumps, spouts, chutes and hose pulleys: you have put the fluids branch to work.",
		"",
		"This checkpoint confirms you can move, dispense and shift liquids and items around your workshop with confidence."
	]
	quest.32BE7A97CE942A73.subtitle: "Water, lava, and everything between"
	quest.32BE7A97CE942A73.title: "&bFluid Handler"
	quest.0C5F7EB80F927E75.description: [
		"Crushing wheels, encased fans, blast/smoke/wash and the chicken roost: you have squeezed real output out of Create's processing branch.",
		"",
		"This checkpoint confirms your workshop is not just running, it is producing."
	]
	quest.0C5F7EB80F927E75.subtitle: "Every trick the fan has to offer"
	quest.0C5F7EB80F927E75.title: "&6Process Master"
	quest.17D2B573D0192137.description: [
		"Alloy, casings, rotation, processing, fluids: you have built a complete andesite-tier workshop from scratch.",
		"",
		"This is the end of &6Cogs \& Crates&r. Claim your reward, including your first &6Numismatics&r coins from this chapter.",
		"",
		"Next comes &6&lBrass&r: precision mechanisms, automation, and the machines that build FOR you. &dRotational Power&r is waiting."
	]
	quest.17D2B573D0192137.subtitle: "The andesite age is complete"
	quest.17D2B573D0192137.title: "&aMaster of Cogs"
	quest.D563B85D7AE2D984.quest_desc: [
		"Dying used to mean scrambling back to a pile of despawning items. Not anymore."
		""
		"When you die, a &agravestone&r automatically appears holding everything you dropped. Right-click it to get your items back, no timer, no panic. You can also craft the block yourself from cobblestone and dirt if you ever want to place one manually."
		""
		"Mine with confidence. Your stuff will be waiting."
	]
	quest.D563B85D7AE2D984.quest_subtitle: "Die without losing everything"
	quest.D563B85D7AE2D984.title: "Death Insurance"
	quest.D5792F747EE0F514.quest_desc: [
		"Steamon blends two very different worlds into one pack: &6Create&r, where cogs, steam and rotational power build machines that run themselves, and &cCobblemon&r, where you catch, train and battle Pokemon across the map."
		""
		"This book is your guide, not your leash. &aThe Steamon Journey&r below is the main line: a short, guided climb from your first tree to your first trip through the End. Along the way it points you toward the Create and Cobblemon branches whenever you are ready for them."
		""
		"Nothing here is mandatory. Explore the tips around this quest, then follow the Journey at your own pace. Come say hi on Discord, link in the tip to your right."
	]
	quest.D5792F747EE0F514.quest_subtitle: "Two worlds, one adventure"
	quest.D5792F747EE0F514.title: "&eWelcome, Trainer"
	quest.E2FD3EF613340EE1.quest_desc: [
		"&6Create&r turns rotational power into automation: water wheels and windmills spin shafts and cogwheels, which drive mixers, presses and mechanical arms that eventually run entire factories for you."
		""
		"&cCobblemon&r is about the team you build: catching wild Pokemon, training them up, evolving them and battling other Trainers, gym leaders included."
		""
		"Both branches open from &aThe Steamon Journey&r as you progress. Start with whichever one calls to you first, there is no wrong answer."
	]
	quest.E2FD3EF613340EE1.quest_subtitle: "Cogs or critters, your call"
	quest.E2FD3EF613340EE1.title: "The Two Worlds"
	quest.E88560D89D5A44CB.quest_desc: [
		"Craft a full set of &airon tools&r."
		""
		"An iron pickaxe finally cracks open diamond, redstone and the deeper ores. Time to dig further than you have dared so far."
	]
	quest.E88560D89D5A44CB.quest_subtitle: "Cut deeper, dig further"
	quest.E88560D89D5A44CB.title: "Tools of the Trade"
	task.196A601AE88BD806.title: "Berry Master"
	task.307088461895A95F.title: "Champion of Steamon"
	task.30B4A1F78532EA40.title: "Trainer's Path Complete"
	task.4004E23832D14D2F.title: "Catch 3 Fire type Pokemon in the Nether"
	task.4013D9EABAFACD6D.title: "Forge a Netherite milestone"
	task.4015F856286C0EE5.title: "Catch 2 Flying type Pokemon in the Aether"
	task.401AE71A6BE40156.title: "Catch a Ice type"
	task.4025EA76537AAE47.title: "Catch 2 Dark type Pokemon in the Nether"
	task.403D33EFA38EA9BD.title: "Catch a Ghost type"
	task.404625016F33D48C.title: "Craft Eyes of Ender to find the stronghold"
	task.404A72FF4479269D.title: "Catch 4 Pokemon in the End"
	task.40642DCAE7539CCA.title: "Catch a Dragon type Pokemon in the End"
	task.4065764CF034912C.title: "Catch 2 Psychic type Pokemon in the End"
	task.40671B593F8BCC11.title: "Catch a Psychic type"
	task.406B9A6F6EC1D24C.title: "Catch a Dragon type"
	task.409A12CBD1BBDEA0.title: "Catch a Flying type"
	task.40A8E5BD84FCB027.title: "Catch 2 Fairy type Pokemon in the Aether"
	task.40ABBAF318B8522D.title: "Catch a Dark type"
	task.40B7F45AAB16D272.title: "Gather Beast Balls for the rarest catches"
	task.40C20E9E7D1C89A5.title: "Catch a Ground type"
	task.40E954F3B46B9EE2.title: "Catch a Fairy type"
	task.40F676F9AEE5BB6A.title: "Catch a Fire type"
	task.50F4E7B3E590B2DF.title: "Ready to Explore"
	chapter.7562E720C8A255F8.title: "&6Rotational Power",
	quest.72B7A55C0E1D0001.title: "Rotational Power",
	quest.72B7A55C0E1D0001.subtitle: "Beyond the basics",
	quest.72B7A55C0E1D0001.description: [
		"Create 1 taught you how rotation moves through your machines. Create 2 is where you put that power to work: brass, automation, and the tools that turn a workshop into a factory.",
		"",
		"&eZinc&r is a standard overworld ore, look for its blocky ore texture wherever you'd find copper or iron. Mine some to get started.",
		"",
		"This chapter is the gateway to real automation. Everything after this builds on it."
	],

	quest.7C2A2A8E158D0848.title: "Zinc \& Grit",
	quest.7C2A2A8E158D0848.subtitle: "Alloying begins",
	quest.7C2A2A8E158D0848.description: [
		"Raw zinc alone is not very useful, it needs to be refined before it becomes something worth building with.",
		"",
		"Crush your raw zinc with a &6Crushing Wheel&r or smelt it in a furnace to get &eZinc Ingots&r. Combine zinc with copper and you get &6brass&r, the backbone metal of everything in this chapter.",
		""
	],

	quest.7C2A73D1B89429A4.title: "Brass in the Basin",
	quest.7C2A73D1B89429A4.subtitle: "Heat is not optional",
	quest.7C2A73D1B89429A4.description: [
		"Copper and zinc do not become brass just by touching. They need heat to alloy properly.",
		"",
		"Pour 1 &eCopper Ingot&r and 1 &eZinc Ingot&r into a Basin sitting under a &6Mixer&r, then heat the basin with a &6Blaze Burner&r underneath. An unheated basin will just mix and fail, the flame is the whole trick.",
		"",
		"Make &e4 Brass Ingots&r this way. You already have the Mixer and Basin from Cogs \& Crates, this quest is about using them right."
	],

	quest.7C2A1BA5208817FF.title: "Brass Casing",
	quest.7C2A1BA5208817FF.subtitle: "Dressing up the machine",
	quest.7C2A1BA5208817FF.description: [
		"Bare cogwheels and shafts work fine, but the serious machines need a proper housing.",
		"",
		"Craft &e2 Brass Casings&r from Brass Ingots on a stripped log. Casings are the shell of every advanced Create machine.",
		"",
		"You will need them for the Deployer, the Mechanical Arm, and the Mechanical Crafter, they're the key ingredient of this whole chapter."
	],

	quest.7C2A4C13EB00B08C.title: "The Deployer",
	quest.7C2A4C13EB00B08C.subtitle: "A mechanical hand",
	quest.7C2A4C13EB00B08C.description: [
		"Some jobs need hands, not just belts. The Deployer is those hands.",
		"",
		"Craft a &6Deployer&r. It mimics a player's arm: hold an item in its hand slot (right click it with the item) and, once powered by rotation, it applies that item to whatever is in front of it, a block, a Depot, or a belt.",
		"",
		"This is the core tool behind &6Sequenced Assembly&r, Create's way of automating multi-step crafting. You'll use it immediately."
	],

	quest.7C2A4425BF322509.title: "Precision Mechanism",
	quest.7C2A4425BF322509.subtitle: "Your first sequenced craft",
	quest.7C2A4425BF322509.description: [
		"Some items are too precise for a crafting table. They need to be assembled step by step, on a moving line.",
		"",
		"Place a Golden Sheet on a belt or Depot, then line up &63 Deployers&r in a row holding a Cogwheel, a Large Cogwheel, and an Iron Nugget in that order. This is &6Sequenced Assembly&r: each deployer applies its item as the sheet passes.",
		"",
		"&eTip:&r the process loops up to 5 times and succeeds around 80% of the time, so ask for just 1 Precision Mechanism first to see it work before scaling up."
	],

	quest.7C2A516B3AB880F3.title: "The Assembly Line",
	quest.7C2A516B3AB880F3.subtitle: "A pattern you'll reuse",
	quest.7C2A516B3AB880F3.description: [
		"The belt-and-deployers line you just built is not a one-off, it's a pattern.",
		"",
		"Any recipe that needs Sequenced Assembly will reuse this same setup: a belt or Depot feeding a row of Deployers. Keep this contraption around, or build a second one, future machines will need it again.",
		""
	],

	quest.7C2A810F1F2A0929.title: "Mechanical Arm",
	quest.7C2A810F1F2A0929.subtitle: "Pick, carry, place",
	quest.7C2A810F1F2A0929.description: [
		"Belts move items in a straight line. Sometimes you need something smarter to shuffle items between them.",
		"",
		"Craft a &6Mechanical Arm&r. It reaches up to 4 blocks and can pick up items from, and place them onto, belts, Depots, and funnels. Right click its input and output blocks to configure its targets.",
		"",
		"Set its mode to Round Robin, Forced, or Prefer First depending on how you want it to split or prioritize items across a factory."
	],

	quest.7C2A9AE3A67022C2.title: "Mechanical Crafter",
	quest.7C2A9AE3A67022C2.subtitle: "Auto-crafting, finally",
	quest.7C2A9AE3A67022C2.description: [
		"A crafting table needs your hands. A grid of &6Mechanical Crafters&r does not.",
		"",
		"Place &e4 Mechanical Crafters&r together to form a crafting grid, wrench them to point their arrows toward the output crafter, then feed them items and rotation. Some recipes are even too large for a normal 3x3 table and only work here.",
		"",
		"This is the heart of any automated factory: once fed and powered, it crafts on its own forever."
	],

	quest.7C2ADF926B24BDC3.title: "Full Automation",
	quest.7C2ADF926B24BDC3.subtitle: "Sorting the flow",
	quest.7C2ADF926B24BDC3.description: [
		"A factory with no sorting is just a pile of belts dumping everything everywhere.",
		"",
		"Craft a &6Filter&r and place it in funnels, Mechanical Arms, or Brass Tunnels to control exactly which items pass through and where they go.",
		"",
		"Filters are what turn a tangle of belts into an actual production line."
	],

	quest.7C2A2927BC26E978.title: "Copper Backtank",
	quest.7C2A2927BC26E978.subtitle: "Carry your own air",
	quest.7C2A2927BC26E978.description: [
		"Flying and diving both cost air, and your lungs alone won't cut it.",
		"",
		"Craft a &eCopper Backtank&r and wear it on your back. It stores air for jetpacks and diving gear, and refills automatically near any source of rotational power.",
		"",
		"Keep it topped off before long flights or deep dives."
	],

	quest.7C2A5D3D62BCFD5F.title: "Brass Jetpack",
	quest.7C2A5D3D62BCFD5F.subtitle: "Take to the skies",
	quest.7C2A5D3D62BCFD5F.description: [
		"Wings are for birds. You get a chestplate.",
		"",
		"Craft the &6Brass Jetpack&r, worn as a &echestplate&r, not a separate backtank, and it lets you fly freely as long as it has air. Keep a Copper Backtank charged nearby to refuel it.",
		"",
		"It replaces your armor slot, so weigh flight against protection before a fight."
	],

	quest.7C2A7D03FD69E77A.title: "Brass Exoskeleton",
	quest.7C2A7D03FD69E77A.subtitle: "Armor with a purpose",
	quest.7C2A7D03FD69E77A.description: [
		"Not every job needs wings. Some need muscle.",
		"",
		"Craft the &6Brass Exoskeleton&r chestplate for bonus Strength and Haste, great for mining and combat where the Jetpack's flight would not help you.",
		"",
		"Think of it as the ground-based alternative to the Jetpack, same armor slot, different priorities."
	],

	quest.7C2A3E24D08390D6.title: "Extendo Grip",
	quest.7C2A3E24D08390D6.subtitle: "An arm's reach further",
	quest.7C2A3E24D08390D6.description: [
		"Sometimes the block you need is just barely out of reach.",
		"",
		"Craft the &eExtendo Grip&r to extend your reach by 4 blocks and add extra knockback to your punches.",
		"",
		"Handy for building across gaps, fishing items out of awkward spots, or keeping mobs at a distance."
	],

	quest.7C2A3C448003FB0F.title: "Wear It on Your Back",
	quest.7C2A3C448003FB0F.subtitle: "Pure convenience",
	quest.7C2A3C448003FB0F.description: [
		"Your chestplate slot is precious, and the Jetpack or Backtank both want it.",
		"",
		"With Curios support, you can wear your &eJetpack&r or &eBacktank&r in the dedicated back slot instead, freeing your chestplate slot for real armor.",
		"",
		"No new item to craft here, just a smarter way to gear up."
	],

	quest.7C2AC84B49726AA3.title: "Potato Cannon",
	quest.7C2AC84B49726AA3.subtitle: "Farm to firearm",
	quest.7C2AC84B49726AA3.description: [
		"Not everything Create makes is about factories. Some of it is just fun.",
		"",
		"Craft a &6Potato Cannon&r and load it with any food item to launch it as ammo, starchy potatoes hit the hardest.",
		"",
		"A cheap, renewable ranged weapon straight from your farm."
	],

	quest.7C2AD3E1A8DB2A49.title: "Bulk Processing",
	quest.7C2AD3E1A8DB2A49.subtitle: "Scaling up the fan",
	quest.7C2AD3E1A8DB2A49.description: [
		"Your Encased Fan from Create 1 can do more than push air around, it can process items in bulk if you feed it the right fluid.",
		"",
		"Craft a &bFluid Hatch&r and attach it to your existing fan setup. This does not replace your fan, it upgrades what the air current in front of it can do.",
		"",
		"From here, whole stacks can be washed, dyed, or frozen at once instead of one item at a time."
	],

	quest.7C2AFD2429290865.title: "Air Current Recipes",
	quest.7C2AFD2429290865.subtitle: "Dye and frost in bulk",
	quest.7C2AFD2429290865.description: [
		"With a Fluid Hatch feeding your fan, the air current itself becomes a processing step.",
		"",
		"Push &bDye&r into the current to bulk-dye items passing through, or use &bPowder Snow&r to freeze them instead.",
		"",
		"No extra machine needed, just the right fluid at the right time."
	],

	quest.7C2A108CB6C3B375.title: "Molten Vents",
	quest.7C2A108CB6C3B375.subtitle: "Lava breathes life into stone",
	quest.7C2A108CB6C3B375.description: [
		"Deep underwater, dormant veins of stone wait for a spark of heat to wake them up.",
		"",
		"Find a &6Molten Vent&r structure (often submerged) and break its dormant orestone, then pour lava over the vent. It will generate fresh orestone: &eVeridium&r, &eAsurine&r, &eCrimsite&r, &eOchrum&r, &eScorchia&r, or &eScoria&r.",
		"",
		"This is a renewable source of decorative stone, not a heat source, don't expect it to power anything. Great for builders who never want to run out of colorful blocks."
	],

	quest.7C2AA35847EE4ABC.title: "The Packager",
	quest.7C2AA35847EE4ABC.subtitle: "Boxing it all up",
	quest.7C2AA35847EE4ABC.description: [
		"An automated kitchen still needs something to load the ingredients in and take the plates out.",
		"",
		"Craft a &6Packager&r to automatically box items into their crafting result, or unbox them again. It's what feeds your Cooking Pot without you lifting a spoon.",
		"",
		"Pair it with a Mechanical Arm and your Cooking Pot never sits empty."
	],

	quest.7C2A129960169A0C.title: "Cooking Automation",
	quest.7C2A129960169A0C.subtitle: "From your hands to your machines",
	quest.7C2A129960169A0C.description: [
		"You already know how to cook by hand, see Farm to Table if you skipped it. Now it's time to stop standing at the stove.",
		"",
		"Feed your Cooking Pot with a &6Packager&r and have a &6Mechanical Arm&r serve the finished meals. create-central-kitchen adds no new blocks, it simply makes your existing Farmer's Delight cookware compatible with Create automation.",
		"",
		"&aThis is the capstone of Rotational Power, and the bridge into the Culinary chapter.&r"
	]
	chapter.4AC9C2A03CC7FEF4.title: "Sparks \& Circuits"
	quest.7FD87542D311BA8A.title: "Sparks \& Circuits"
	quest.7FD87542D311BA8A.subtitle: "Create meets the Grid"
	quest.7FD87542D311BA8A.description: [
		"Create just met Forge Energy. Somewhere behind the shafts and belts, a whole electrical grid is waiting to be wired up."
		""
		"This section builds the bridge between kinetic power and FE, industrializes your XP, and lets you manufacture your own Poke Balls from scratch."
		""
		"You already have the fluids (see &6Fluids \& Foundations&r) and sequenced assembly (see &6Rotational Power&r). Time to electrify them."
	]
	quest.7C843786B025E59B.title: "Rolling Mill"
	quest.7C843786B025E59B.subtitle: "Flatten it, then thin it"
	quest.7C843786B025E59B.description: [
		"Every wire in this chapter starts life as a plate on this machine."
		""
		"The &6Rolling Mill&r is a kinetic block that reshapes metal: feed it plates or ingots and, with enough &dRotational Power&r, it rolls them into rods and wires."
		""
		"Build one first. Everything downstream (wiring, connectors, the whole electrical branch) needs it running."
	]
	quest.7C7742A771DC152F.title: "Wires \& Rods"
	quest.7C7742A771DC152F.subtitle: "The copper (and gold, and iron) standard"
	quest.7C7742A771DC152F.description: [
		"A grid needs cables, and cables start on the Rolling Mill."
		""
		"Run plates through the mill to get &ecopper wire&r, and it'll do the same job on iron and gold. These wires are recurring ingredients: expect to make a lot of them."
		""
		"Tip: keep a stack or two on hand, connectors and machinery both eat through wire fast."
	]
	quest.7C80BFCD93CF15BF.title: "Connectors"
	quest.7C80BFCD93CF15BF.subtitle: "Plug it in"
	quest.7C80BFCD93CF15BF.description: [
		"Wires alone don't move power: you need something to plug them into."
		""
		"&6Connectors&r (small and large) attach to FE-capable blocks and let wires insert or extract Forge Energy through them. Wire two connected blocks together and power starts flowing."
		""
		"This is how you lay down your first electrical network."
	]
	quest.7C72143865DB0A59.title: "Alternator \& Electric Motor"
	quest.7C72143865DB0A59.subtitle: "The two-way bridge"
	quest.7C72143865DB0A59.description: [
		"This is the heart of the whole branch: the machine that turns rotation into electricity, and electricity back into rotation."
		""
		"The &6Alternator&r converts &dRotational Power&r into FE, but only once it is spinning at &e32 RPM&r or faster. The &6Electric Motor&r does the reverse: it consumes FE to produce rotation, at whatever RPM you configure."
		""
		"Tip: the round trip (kinetic -> FE -> kinetic) only keeps about &c75% efficiency&r. Don't chain alternators and motors for fun, only when you actually need to cross the gap."
	]
	quest.7C9DE7FB54FCB456.title: "Capacitor \& Modular Accumulator"
	quest.7C9DE7FB54FCB456.subtitle: "Store the surge"
	quest.7C9DE7FB54FCB456.description: [
		"Power you generate is power you'll eventually want to save for later."
		""
		"The &6Capacitor&r is a portable battery you can carry in your inventory. The &6Modular Accumulator&r is its big brother: a multiblock FE buffer for your base. Right-click it with a &ewrench&r to set which faces input and which output."
		""
		"Tip: always give your grid a buffer. Machines that spike their FE draw will brownout a network with nowhere to store the slack."
	]
	quest.7CD4722C08CC064B.title: "Tesla Coil"
	quest.7CD4722C08CC064B.subtitle: "Shocking, isn't it?"
	quest.7CD4722C08CC064B.description: [
		"Everything you've built so far moves power. This is where power starts doing something on its own."
		""
		"The &6Tesla Coil&r discharges FE at range: it can charge items sitting nearby or apply effects to entities without a single wire touching them."
		""
		"The capstone of this branch. Purely optional, purely fun."
	]
	quest.7C9685EEAD33FCDB.title: "Portable Energy Interface"
	quest.7C9685EEAD33FCDB.subtitle: "Power on the move"
	quest.7C9685EEAD33FCDB.description: [
		"Your grid doesn't have to stay put."
		""
		"The &6Portable Energy Interface&r transfers FE into and out of moving contraptions, including &etrains&r, the same way item and fluid interfaces already do."
		""
		"A first taste of what's coming: trains get their own chapter later, and they'll want power too."
	]
	quest.7CDFF5177298BBDF.title: "Enchantment Industry"
	quest.7CDFF5177298BBDF.subtitle: "The XP factory floor"
	quest.7CDFF5177298BBDF.description: [
		"Enchanting one item at a time at an enchanting table is fine. Enchanting a hundred is a factory problem."
		""
		"This branch industrializes experience and enchantment: automated tables, book duplication, and enchanting beyond vanilla's limits."
		""
		"Opens the door to everything below. None of it is required, all of it saves you hours."
	]
	quest.7CC751AED6F79984.title: "Blaze Enchanter"
	quest.7CC751AED6F79984.subtitle: "A burner with ambition"
	quest.7CC751AED6F79984.description: [
		"Take a Blaze Burner, teach it a new trick: it becomes an automatic enchanting table."
		""
		"The &6Blaze Enchanter&r consumes &bLiquid Experience&r and enchants any item riding a belt on the conveyor beneath it. No manual clicking, no book consumed by hand."
		""
		"Tip: you'll need a steady supply of Liquid XP flowing in for this to run continuously."
	]
	quest.7CBC4B4E2E4F181D.title: "Printer"
	quest.7CBC4B4E2E4F181D.subtitle: "Copy, paste, enchant"
	quest.7CBC4B4E2E4F181D.description: [
		"Why write the same book twice when a machine can copy it for you?"
		""
		"The &6Printer&r duplicates enchanted books, written books, name tags, and train schedules. Enchanted books specifically require the Printer to be fed &bLiquid Experience&r to work."
		""
		"Tip: print your best enchanted books once, then hand out copies without ever touching another enchanting table."
	]
	quest.7CAFAE556E1AD980.title: "Super Experience"
	quest.7CAFAE556E1AD980.subtitle: "Past the vanilla cap"
	quest.7CAFAE556E1AD980.description: [
		"Level 30 was never the real limit, just vanilla's limit."
		""
		"Using &bLiquid Experience&r and a Super Experience Nugget, you can push enchantments beyond what a normal enchanting table allows."
		""
		"For the player who has already automated everything else and wants one more edge."
	]
	quest.7C91C963BE42B881.title: "Enchanted Machines"
	quest.7C91C963BE42B881.subtitle: "Yes, your Drill too"
	quest.7C91C963BE42B881.description: [
		"Enchantments aren't just for swords and pickaxes anymore."
		""
		"Create's own machines (Drill, Saw, Fan, Millstone, Mechanical Press) can be enchanted on a regular anvil, exactly like a tool. Efficiency on a Millstone is not a typo, it genuinely speeds it up."
		""
		"No new item to craft here: just try it next time you're at an anvil with a spare machine block."
	]
	quest.7C117C23BB9CCBD8.title: "Wireless Transmission"
	quest.7C117C23BB9CCBD8.subtitle: "No wires, no belts, no limits"
	quest.7C117C23BB9CCBD8.description: [
		"Sometimes running a belt (or a pipe, or a wire) across the map just isn't worth it."
		""
		"The &6Energy Transmitter&r moves items, fluids, or FE without any physical connection between sender and receiver, at unlimited distance, even across dimensions."
		""
		"Tip: it does NOT transmit &dRotational Power&r, only items/fluids/energy. Keep your kinetic network local."
	]
	quest.7C6C4030BA83E2D2.title: "Chunk Loader"
	quest.7C6C4030BA83E2D2.subtitle: "Keep it running while you're gone"
	quest.7C6C4030BA83E2D2.description: [
		"A farm that stops the second you log off isn't much of a farm."
		""
		"The &6Chunk Loader&r spends kinetic energy to keep a chunk active even when no player is standing in it."
		""
		"Feed it rotation, point it at your favorite automated farm, and let it work while you're offline."
	]
	quest.7C39882DA16ECA63.title: "Master Engineer"
	quest.7C39882DA16ECA63.subtitle: "All roads lead here"
	quest.7C39882DA16ECA63.description: [
		"Electricity, enchantment, transmission: three branches, one engineer."
		""
		"Complete at least two of the three branches above to prove you've mastered more than just the basics of this chapter."
		""
		"You're ready for the centerpiece: turning all of this into an actual Poke Ball production line."
	]
	quest.7C9EAA50BE7B7E3E.title: "Poke Ball Shell"
	quest.7C9EAA50BE7B7E3E.subtitle: "Every ball starts empty"
	quest.7C9EAA50BE7B7E3E.description: [
		"Before a Poke Ball can catch anything, it has to exist as an empty shell."
		""
		"The &6Blank Ball&r is crafted entirely through Create's machines, no vanilla crafting table required. This is the shared base for every ball you're about to mass-produce."
		""
		"Every path below (fill or paint) starts from this same shell."
	]
	quest.7C0A9D56716EA09A.title: "Filling: Poke Ball"
	quest.7C0A9D56716EA09A.subtitle: "A splash of dye does it"
	quest.7C0A9D56716EA09A.description: [
		"The simplest path from shell to ball just needs a bit of color."
		""
		"Run a &6Blank Ball&r under a &6Spout&r and fill it with dye: that's it, you get a &cPoke Ball&r. This reuses the same fluid-filling mechanic from &6Fluids \& Foundations&r, no new machine required."
		""
		"The fastest of the two production lines. Great for bulk output."
	]
	quest.7C2F001D63D3BEBB.title: "Painting: Great \& Ultra Ball"
	quest.7C2F001D63D3BEBB.subtitle: "Layer by layer"
	quest.7C2F001D63D3BEBB.description: [
		"Fancier balls need more than one coat of paint."
		""
		"Starting from an &6Unpainted Ball&r, run it through &6Sequenced Assembly&r: multiple filling passes with alternating dye colors produce a &cGreat Ball&r or an &cUltra Ball&r depending on the pattern. This reuses the sequenced assembly line from &6Rotational Power&r."
		""
		"Tip: no stencils involved here, the Belt-and-Spout sequence does all the work."
	]
	quest.7C8AD03F796DC586.title: "Cherish Ball"
	quest.7C8AD03F796DC586.subtitle: "A ball worth remembering"
	quest.7C8AD03F796DC586.description: [
		"Not every ball is meant for the shelf. This one is for a Pokemon you want to remember catching."
		""
		"A custom Steamon recipe: deploy a &enetherite ingot&r onto the shell, follow with red and white filling passes, then finish on the &6Mechanical Press&r. Sequenced assembly, start to finish."
		""
		"Note: the &dMaster Ball&r stays out of reach here on purpose. It's a jackpot reward found elsewhere, never something you craft."
	]
	quest.7C1D505ED91FDAB9.title: "Cobblemon Smartphone"
	quest.7C1D505ED91FDAB9.subtitle: "Crafted, not bought"
	quest.7C1D505ED91FDAB9.description: [
		"You've seen trainers carrying one since the start of your journey. Now it's your turn to build it."
		""
		"The vanilla crafting table recipe is disabled on Steamon: the &6Black Smartphone&r is only obtainable through &6Mechanical Crafting&r, using the Mechanical Crafters you built in &6Rotational Power&r."
		""
		"This one comes without the Pokenav or Waystone module pre-installed: those are separate upgrades you'll find later."
	]
	quest.7C117CF367A45F77.title: "Poke Ball Factory"
	quest.7C117CF367A45F77.subtitle: "The line is running"
	quest.7C117CF367A45F77.description: [
		"Shells, dye, sequenced assembly, all of it running without your hands ever touching a single ball."
		""
		"You now have a working Poke Ball production line, built entirely from Create machinery. This is the bridge between the factory floor and the world outside."
		""
		"Time to put those balls to use. Head to &6Trainer's First Steps&r and go catch something."
	]
	chapter.680467472FCE4635.title: "&cThe Type Trials"
	chapter.388F59E226EBC45B.title: "&cBreeding \& Battle Mastery"
	quest.3000000000000B01.title: "Type Trials Begin"
	quest.3000000000000B01.subtitle: "Eighteen types, one dex"
	quest.3000000000000B01.description: [
		"Cobblemon sorts every species into one or two of eighteen types, and each one fights differently.",
		"",
		"Catch any Pokemon to open the trial grid below. Each node asks for one type; work through them in any order you like.",
		"",
		"Clearing all eighteen unlocks the Type Master reward and rounds out your understanding of the whole type chart."
	]
	quest.2000000000000101.title: "Plain and Simple"
	quest.2000000000000101.subtitle: "The most common type"
	quest.2000000000000101.description: [
		"Normal-types are the generalists of the region: no glaring weakness, no gimmick, just solid stats.",
		"",
		"Catch one Normal-type Pokemon. You have probably already seen a dozen wandering the plains."
	]
	quest.2000000000000102.title: "Playing With Fire"
	quest.2000000000000102.subtitle: "Turn up the heat"
	quest.2000000000000102.description: [
		"Fire-types burn hot and hit hard, and the Nether is not the only place to find them.",
		"",
		"Catch one Fire-type Pokemon. Warm biomes and volcanic areas are a good place to start looking."
	]
	quest.2000000000000103.title: "Making Waves"
	quest.2000000000000103.subtitle: "Dive in"
	quest.2000000000000103.description: [
		"Water covers most of the map, and most of it has something swimming in it.",
		"",
		"Catch one Water-type Pokemon along a river, lake, or coastline."
	]
	quest.2000000000000104.title: "Green Thumb"
	quest.2000000000000104.subtitle: "Roots and leaves"
	quest.2000000000000104.description: [
		"Grass-types thrive wherever things grow, from quiet meadows to dense forests.",
		"",
		"Catch one Grass-type Pokemon. Plains, forests, and flower fields are all fair game."
	]
	quest.2000000000000105.title: "Shock Value"
	quest.2000000000000105.subtitle: "Charge it up"
	quest.2000000000000105.description: [
		"Electric-types crackle with energy and love to paralyze anything that gets close.",
		"",
		"Catch one Electric-type Pokemon. Keep an eye out near power lines, storms, and the odd rodent."
	]
	quest.2000000000000106.title: "The Big Chill"
	quest.2000000000000106.subtitle: "Where the frost bites"
	quest.2000000000000106.description: [
		"Ice-types are rare outside the cold, and the cold is not exactly on the way to anywhere.",
		"",
		"&eTip:&r head to snowy or frozen biomes, mountain peaks included, and catch one Ice-type Pokemon there."
	]
	quest.2000000000000107.title: "Fists of Fury"
	quest.2000000000000107.subtitle: "Trained, not born"
	quest.2000000000000107.description: [
		"Fighting-types rely on raw physical power and hit Normal and Rock hard.",
		"",
		"Catch one Fighting-type Pokemon. They tend to roam open ground and rocky terrain."
	]
	quest.2000000000000108.title: "Toxic Encounter"
	quest.2000000000000108.subtitle: "Handle with care"
	quest.2000000000000108.description: [
		"Poison-types lurk in swamps, caves, and anywhere else things fester.",
		"",
		"Catch one Poison-type Pokemon. Wetlands and cave systems are usually a safe bet."
	]
	quest.2000000000000109.title: "Down to Earth"
	quest.2000000000000109.subtitle: "Dig deep"
	quest.2000000000000109.description: [
		"Ground-types shrug off Electric moves entirely and often burrow to survive.",
		"",
		"Catch one Ground-type Pokemon. Deserts, badlands, and cave floors are their usual haunts."
	]
	quest.200000000000010A.title: "Take to the Skies"
	quest.200000000000010A.subtitle: "Above it all"
	quest.200000000000010A.description: [
		"Flying-types own the skies and are immune to Ground moves entirely.",
		"",
		"Catch one Flying-type Pokemon. Look up: mountains, open sky, and tall trees all count."
	]
	quest.200000000000010B.title: "Mind Over Matter"
	quest.200000000000010B.subtitle: "Read the future"
	quest.200000000000010B.description: [
		"Psychic-types bend the rules with pure mental force, and they hit Fighting-types where it hurts.",
		"",
		"Catch one Psychic-type Pokemon. Ruins, quiet plains, and open fields tend to hide them."
	]
	quest.200000000000010C.title: "Small but Mighty"
	quest.200000000000010C.subtitle: "Under every leaf"
	quest.200000000000010C.description: [
		"Bug-types are everywhere once you start looking, and several evolve into serious threats.",
		"",
		"Catch one Bug-type Pokemon. Forests and tall grass are crawling with them, literally."
	]
	quest.200000000000010D.title: "Solid as Rock"
	quest.200000000000010D.subtitle: "Ancient and sturdy"
	quest.200000000000010D.description: [
		"Rock-types boast huge physical defense but crumble fast against Water and Grass.",
		"",
		"Catch one Rock-type Pokemon. Mountains, badlands, and cave walls are their natural home."
	]
	quest.200000000000010E.title: "Things That Go Bump"
	quest.200000000000010E.subtitle: "Only in the dark"
	quest.200000000000010E.description: [
		"Ghost-types are shy in daylight and immune to Normal and Fighting moves outright.",
		"",
		"&eTip:&r explore caves or wait for nightfall. Ghost-types come out once the sun is gone."
	]
	quest.200000000000010F.title: "Here Be Dragons"
	quest.200000000000010F.subtitle: "The rarest breed"
	quest.200000000000010F.description: [
		"Dragon-types are the region's heavy hitters, and they do not show up just anywhere.",
		"",
		"&eTip:&r badlands and high-altitude terrain are your best shot. Dragons are uncommon by design, so be patient."
	]
	quest.2000000000000110.title: "Creatures of the Night"
	quest.2000000000000110.subtitle: "No conscience, no fear"
	quest.2000000000000110.description: [
		"Dark-types are immune to Psychic moves and thrive once the lights go out.",
		"",
		"&eTip:&r hunt after dark. Dark-types favor nighttime hours over daylight encounters."
	]
	quest.2000000000000111.title: "Forged, Not Found"
	quest.2000000000000111.subtitle: "Underground and unyielding"
	quest.2000000000000111.description: [
		"Steel-types resist more move types than anything else in the game, at the cost of being scarce.",
		"",
		"&eTip:&r check caves and underground tunnels. Steel-types tend to stay below the surface."
	]
	quest.2000000000000112.title: "Touched by Magic"
	quest.2000000000000112.subtitle: "Delicate and deadly"
	quest.2000000000000112.description: [
		"Fairy-types shut down Dragon-types cold and slip past Dark moves without a scratch.",
		"",
		"&eTip:&r flowery forests and blooming fields are where Fairy-types tend to settle. Look for color."
	]
	quest.2000000000000201.title: "Type Master"
	quest.2000000000000201.subtitle: "One of each, mastered"
	quest.2000000000000201.description: [
		"Eighteen types, eighteen catches: you have covered the entire type chart with your own two hands.",
		"",
		"This is the mark of a Trainer who understands the region, not just its Pokemon.",
		"",
		"Claim a randomized jackpot reward built for players who finish what they start."
	]
	quest.2000000000000301.title: "Type Cheat-Sheet"
	quest.2000000000000301.subtitle: "Know your matchups"
	quest.2000000000000301.description: [
		"Every type has strengths and weaknesses, and knowing them wins fights before they start.",
		"",
		"&eTip:&r a super-effective move deals double damage, not very effective is half, and some matchups are a full immunity (zero damage). Open the Pokedex entry of any Pokemon in-game to see its exact type chart.",
		"",
		"Learning this chart is the single biggest jump in battle skill you can make."
	]
	quest.2000000000000302.title: "Fight or Flight"
	quest.2000000000000302.subtitle: "Wild Pokemon bite back"
	quest.2000000000000302.description: [
		"Not every wild Pokemon just stands there and takes it anymore.",
		"",
		"&eTip:&r some wild Pokemon now fight back if you attack them and miss, or flee outright if a capture attempt fails. Approach carefully and make your throws count.",
		"",
		"Treat every wild encounter as a real fight, not a free target."
	]
	quest.2000000000000303.title: "Share the XP"
	quest.2000000000000303.subtitle: "Two ways to level up faster"
	quest.2000000000000303.description: [
		"Grinding one Pokemon at a time is slow. Steamon gives you two shortcuts.",
		"",
		"&eTip:&r capturing a wild Pokemon grants XP to your first sent-out Pokemon, and a held EXP-share item splits 50 percent of battle XP with your whole party automatically.",
		"",
		"Combine both and your entire team levels up while you focus on catching."
	]
	quest.3000000000000C01.title: "The Path to Mastery"
	quest.3000000000000C01.subtitle: "Beyond the Poke Ball"
	quest.3000000000000C01.description: [
		"Catching Pokemon is only half the game. The other half is raising them into something exceptional.",
		"",
		"This chapter covers breeding, EVs and IVs, and the tools that turn a good Pokemon into a great one, across three independent paths.",
		"",
		"Catch any Pokemon to begin, then follow whichever branch interests you first: Breeding, Stat Training, or Battle Gear."
	]
	quest.7C30000000000101.title: "Breeding Basics"
	quest.7C30000000000101.subtitle: "Back to the Pasture"
	quest.7C30000000000101.description: [
		"You already met the Pasture block back in your first steps as a Trainer. Now it earns its keep.",
		"",
		"Place two compatible Pokemon in a Pasture and, given time, they will produce an egg together.",
		"",
		"Breeding is how you pass down natures, IVs, and egg moves, the foundation of every serious team."
	]
	quest.7C30000000000102.title: "The Universal Parent"
	quest.7C30000000000102.subtitle: "The great equalizer"
	quest.7C30000000000102.description: [
		"Ditto has one job, and it does that job with almost anything.",
		"",
		"Catch a Ditto. It breeds with nearly every species in the Pasture, making it the single most useful Pokemon for any serious breeding project."
	]
	quest.7C30000000000103.title: "Get an Egg"
	quest.7C30000000000103.subtitle: "New life, new stats"
	quest.7C30000000000103.description: [
		"Once two Pokemon in a Pasture are compatible, an egg is only a matter of time.",
		"",
		"Obtain an egg and hatch it into a Pokemon of your own.",
		"",
		"This is your first hands-on look at the breeding cycle you will be relying on for the rest of this chapter."
	]
	quest.7C30000000000104.title: "Destiny Knot"
	quest.7C30000000000104.subtitle: "Pass down perfection"
	quest.7C30000000000104.description: [
		"Breeding for good stats is a numbers game, and the Destiny Knot loads the dice.",
		"",
		"Obtain a Destiny Knot and have a parent hold it while breeding: it passes five IVs from the two parents to the egg instead of the usual three."
	]
	quest.7C30000000000105.title: "Everstone"
	quest.7C30000000000105.subtitle: "Lock in the nature"
	quest.7C30000000000105.description: [
		"A nature shapes how a Pokemon's stats grow, and breeding it randomly is a gamble.",
		"",
		"Obtain an Everstone and have a parent hold it while breeding: the offspring inherits that parent's nature directly."
	]
	quest.7C30000000000106.title: "Hatch a Clutch"
	quest.7C30000000000106.subtitle: "Practice makes perfect"
	quest.7C30000000000106.description: [
		"One egg is a first step. A real breeding project means running the cycle again and again.",
		"",
		"Hatch 5 eggs in total. Each hatch is another shot at the nature, IVs, and species you are aiming for."
	]
	quest.7C30000000000107.title: "Eggs in Your Pack"
	quest.7C30000000000107.subtitle: "Walk it off"
	quest.7C30000000000107.description: [
		"An egg is not just a decoration sitting in a box.",
		"",
		"&eTip:&r eggs hatch over time whether they are in your inventory or simply carried along, so keep moving and let the distance add up."
	]
	quest.7C30000000000108.title: "Handle With Care"
	quest.7C30000000000108.subtitle: "Your first egg"
	quest.7C30000000000108.description: [
		"Before it hatches, an egg is an item like any other, and it is worth holding onto properly.",
		"",
		"Obtain a Pokemon egg. Keep it safe until it is ready to hatch."
	]
	quest.7C30000000000109.title: "A Lucky Hatch"
	quest.7C30000000000109.subtitle: "The Masuda method"
	quest.7C30000000000109.description: [
		"Shiny hunting through breeding is not just luck, there is a known trick to it.",
		"",
		"&eTip:&r breeding two parents from different regions, known as the Masuda Method, noticeably increases the odds of hatching a shiny.",
		"",
		"Optional, but a real path to a shiny for anyone patient enough to chase one."
	]
	quest.7C30000000000201.title: "Vitamin Boost"
	quest.7C30000000000201.subtitle: "Six shots at greatness"
	quest.7C30000000000201.description: [
		"Effort Values (EVs) are hidden stat points earned through battle, and vitamins let you add them directly.",
		"",
		"Use one of each EV vitamin: Protein, Iron, Calcium, Zinc, Carbos, and HP Up. Each one boosts a different stat.",
		"",
		"This is the fastest way to jumpstart a Pokemon's EV spread without a single battle."
	]
	quest.7C30000000000202.title: "Reset with Mochi"
	quest.7C30000000000202.subtitle: "A clean slate"
	quest.7C30000000000202.description: [
		"Overinvested in the wrong stat, or want to retrain a Pokemon from scratch?",
		"",
		"Obtain a Fresh Start Mochi and feed it to a Pokemon: it wipes every EV clean, letting you retrain from zero."
	]
	quest.7C30000000000203.title: "Silver Cap"
	quest.7C30000000000203.subtitle: "Hyper Training begins"
	quest.7C30000000000203.description: [
		"IVs are fixed at birth, or so the theory goes. Hyper Training bends that rule.",
		"",
		"Obtain a Silver Bottle Cap and use it on a Pokemon: it maxes out a single IV of your choice, no rebreeding required."
	]
	quest.7C30000000000204.title: "Golden Cap"
	quest.7C30000000000204.subtitle: "Perfect, guaranteed"
	quest.7C30000000000204.description: [
		"Why max one stat at a time when you can max them all at once?",
		"",
		"Obtain a Golden Bottle Cap: applying it maxes out every IV on a Pokemon in one go, the fastest route to a flawless stat spread."
	]
	quest.7C30000000000205.title: "Nature Mint"
	quest.7C30000000000205.subtitle: "Change your mind"
	quest.7C30000000000205.description: [
		"Bred the perfect Pokemon except for its nature? No need to start over.",
		"",
		"Obtain an Adamant Mint and use it on a Pokemon: it changes the nature's stat effects directly, no rebreeding needed."
	]
	quest.7C30000000000206.title: "Read Your Stats"
	quest.7C30000000000206.subtitle: "The numbers behind the Pokemon"
	quest.7C30000000000206.description: [
		"EVs, IVs, and natures all shape a Pokemon's stats, but none of it is visible unless you know where to look.",
		"",
		"&eTip:&r open a Pokemon's summary screen to see its full stat breakdown, EVs, IVs, and nature included. Check it before you commit any vitamins or bottle caps."
	]
	quest.7C30000000000207.title: "Max a Stat"
	quest.7C30000000000207.subtitle: "The 252 rule"
	quest.7C30000000000207.description: [
		"EV training has hard limits, and knowing them saves you from wasting vitamins.",
		"",
		"&eTip:&r a single stat can hold at most 252 EVs, and a Pokemon can hold at most 510 total across all stats. Plan your spread before you pour vitamins into it."
	]
	quest.7C30000000000208.title: "The Void Cap"
	quest.7C30000000000208.subtitle: "One step further"
	quest.7C30000000000208.description: [
		"For Trainers who already maxed the basics and want to push further still.",
		"",
		"Obtain a Void Bottle Cap, a rarer tier above the Silver Cap. Fully optional, for those chasing the last word in stat perfection."
	]
	quest.7C30000000000301.title: "Blank TM"
	quest.7C30000000000301.subtitle: "A move, captured"
	quest.7C30000000000301.description: [
		"Blank TMs are not sold pre-loaded. You make them useful yourself.",
		"",
		"Obtain a Blank TM. Use it on a Pokemon that knows the move you want, and it captures that move for later use on any compatible Pokemon."
	]
	quest.7C30000000000302.title: "TM Case"
	quest.7C30000000000302.subtitle: "Stay organized"
	quest.7C30000000000302.description: [
		"A growing TM collection gets unmanageable fast without somewhere to put it.",
		"",
		"Obtain a TM Case. It stores your captured TMs in one place instead of cluttering your inventory."
	]
	quest.7C30000000000303.title: "KO Streak"
	quest.7C30000000000303.subtitle: "Win, and keep winning"
	quest.7C30000000000303.description: [
		"Battling is its own reward, and Steamon's Unchained system tracks how well you are doing at it.",
		"",
		"Defeat 40 Pokemon in battle. Unchained rewards consecutive wins with bonuses of its own, so a longer streak is always worth more.",
		"",
		"&eTip:&r keep the streak alive for better odds at Unchained's own bonuses. Nothing is guaranteed, but persistence pays off."
	]
	quest.7C30000000000304.title: "Zacian's Blade"
	quest.7C30000000000304.subtitle: "A legendary weapon, forged"
	quest.7C30000000000304.description: [
		"Some weapons are not found. They are built.",
		"",
		"Smith Zacian's Sword at a smithing table using the required upgrade template and materials.",
		"",
		"It is not merely crafted. It is earned, a centerpiece for any Trainer's arsenal."
	]
	quest.7C30000000000305.title: "Capture Streak"
	quest.7C30000000000305.subtitle: "Fill out the Pasture"
	quest.7C30000000000305.description: [
		"Every Pokemon you catch is another option for battling, breeding, or trading later.",
		"",
		"Catch 20 Pokemon. Optional, but the more you have on hand, the more flexible your team building becomes."
	]
	quest.7C30000000000306.title: "Pokemon Armor"
	quest.7C30000000000306.subtitle: "Suit up"
	quest.7C30000000000306.description: [
		"Not all armor is meant for you to wear.",
		"",
		"Obtain a Charizard Armor Chestplate, smithed for a Pokemon rather than a Trainer. A striking optional cosmetic and combat piece."
	]
	quest.7C30000000000307.title: "Ceruledge Sword"
	quest.7C30000000000307.subtitle: "Blade of embers"
	quest.7C30000000000307.description: [
		"Another smithed weapon for Trainers who want their arsenal complete.",
		"",
		"Obtain a Ceruledge Sword. Optional, but a fitting companion piece to Zacian's Blade."
	]
	quest.7C30000000000401.title: "Battle Master"
	quest.7C30000000000401.subtitle: "Mastery, proven"
	quest.7C30000000000401.description: [
		"Breeding, stat training, battle gear: you do not need to finish all three to prove you have mastered this chapter.",
		"",
		"Complete at least two of the three branches, Breeding, EVs and IVs, or Battle Gear, to unlock this quest.",
		"",
		"Claim a randomized jackpot reward built for Trainers who went the distance."
	]
	chapter.290C02C15C8843CE.title: "&eWelcome to Steamon"
	chapter.111CC61C07A52AD5.title: "&aThe Steamon Journey"
	quest.1B6DD754A1659453.title: "Welcome to Steamon"
	quest.1B6DD754A1659453.subtitle: "A world of cogs and creatures"
	quest.1B6DD754A1659453.description: [
		"Two worlds await you here: the wild region of &cCobblemon&r and the machine age of &6Create&r."
		""
		"This chapter is a quick onboarding, nothing below is mandatory. Look around, pick up a few starter tools, and take your time."
		""
		"This quest checks itself off the moment you step into the world. Head over to &aThe Steamon Journey&r next, that's where the real adventure begins, with a path through both Create and Cobblemon."
	]
	quest.0F2F4FBA5607AE59.title: "Join the Community"
	quest.0F2F4FBA5607AE59.subtitle: "You are not playing alone"
	quest.0F2F4FBA5607AE59.description: [
		"Steamon is a small international community, not just a server."
		""
		"Check the server info for the Discord invite, say hello, and link your account. It grants you the whitelist role and hooks you into the in-game chat bridge, so you can talk to the community even while offline."
		""
		"Tick this off once you have joined."
	]
	quest.38700AB387BF8F4B.title: "Surviving the First Night"
	quest.38700AB387BF8F4B.subtitle: "The dark is not empty"
	quest.38700AB387BF8F4B.description: [
		"The first night is the deadliest part of the whole run. Mobs spawn wherever the light level drops too low."
		""
		"Place torches around your camp, wall yourself into a basic shelter, and sleep in a bed once night falls to skip straight to morning."
		""
		"Check the mark once you have survived your first night, and take these torches for the next one."
	]
	quest.5ADB3AB95E816F3D.title: "The Iron Age"
	quest.5ADB3AB95E816F3D.subtitle: "The metal that changes everything"
	quest.5ADB3AB95E816F3D.description: [
		"Iron is the turning point of the early game. Everything past this quest gets faster, safer, and stronger."
		""
		"Mine iron ore with a stone pickaxe, then smelt it in a furnace to get ingots."
		""
		"A core milestone of the main path: it unlocks iron tools and armor, and hands you a bucket to start managing water and lava."
	]
	quest.0E609DBE08A8AD02.title: "Iron Tools"
	quest.0E609DBE08A8AD02.subtitle: "Real efficiency at last"
	quest.0E609DBE08A8AD02.description: [
		"Wooden and stone tools only get you so far. Iron is where mining and fighting stop being a chore."
		""
		"Forge an iron pickaxe, sword, or shovel at the crafting table using your ingots."
		""
		"Another step on the main path, and the last stop before diamond."
	]
	quest.5CDA7F5EE9D74A0A.title: "Gateway to the Nether"
	quest.5CDA7F5EE9D74A0A.subtitle: "Light the way down"
	quest.5CDA7F5EE9D74A0A.description: [
		"Beneath the surface waits a whole other dimension, and a portal of obsidian is all that stands between you and it."
		""
		"Mine 10 obsidian with a diamond pickaxe, place it in a frame, and light it with Flint and Steel (yours to keep from this quest's reward)."
		""
		"A milestone of the main path: it opens the Nether, right next to this one on the tree."
	]
	quest.22B0B4F4536DDC20.title: "Grave Matters"
	quest.22B0B4F4536DDC20.subtitle: "Death is not the end of your loot"
	quest.22B0B4F4536DDC20.description: [
		"Dying used to mean losing everything on the ground, at the mercy of mobs and despawn timers."
		""
		"With Gravestone installed, death now leaves behind a Gravestone holding your full inventory and experience. Break it to get everything back."
		""
		"An optional comfort quest: it does not block anything, but it will save your run more than once."
	]
	quest.51424B4C0885F924.title: "Keep the Mobs Away"
	quest.51424B4C0885F924.subtitle: "Secure your base"
	quest.51424B4C0885F924.description: [
		"A base is only as peaceful as the ground it stands on."
		""
		"The Magnum Torch stops hostile mobs from spawning in a large radius around it, far bigger than a regular torch's reach."
		""
		"An optional quality-of-life pickup: place one at the heart of your base and stop tunneling under it for a light source."
	]
	chapter.3EF16F7A003E45D5.title: "&cInto the Nether"
	quest.36F75F3A69E5E07F.title: "Into the Nether"
	quest.36F75F3A69E5E07F.subtitle: "Hell awaits"
	quest.36F75F3A69E5E07F.description: [
		"A Nether Portal opens the way to a burning dimension of fortresses, bastions and lava seas."
		""
		"Build a frame from 10 Obsidian, light it with Flint and Steel, and step through."
		""
		"Everything past this gate: quartz, blaze rods, gold, ancient debris, all of it starts here."
	]
	quest.405B885C41DDE9FE.title: "Nether Quartz"
	quest.405B885C41DDE9FE.subtitle: "Harvest the wastes"
	quest.405B885C41DDE9FE.description: [
		"&aNether Quartz&r feeds Create redstone builds and dozens of decorative recipes."
		""
		"Mine 16 Nether Quartz. The Nether is the only place it grows."
	]
	quest.403463CB69668C51.title: "Blaze Rods"
	quest.403463CB69668C51.subtitle: "Storm the fortress"
	quest.403463CB69668C51.description: [
		"&aNether Fortresses&r are the home of blazes and the only source of &aBlaze Rods&r."
		""
		"Defeat blazes and claim 3 Blaze Rods. They power brewing and heat your Create foundry."
	]
	quest.400288EDEEB9E085.title: "Bastion Gold"
	quest.400288EDEEB9E085.subtitle: "Raid the bastion"
	quest.400288EDEEB9E085.description: [
		"&aBastion Remnants&r are piglin strongholds packed with gold and gear."
		""
		"Loot a bastion and bring back 2 Gold Blocks. Wear your gold and watch the brutes: piglins turn hostile if they see you without it."
		""
		"This is where the road to Netherite begins."
	]
	quest.401CF50145120356.title: "Ancient Debris"
	quest.401CF50145120356.subtitle: "The hardest metal"
	quest.401CF50145120356.description: [
		"&aAncient Debris&r hides deep near the lava seas, mostly around Y=15."
		""
		"Dig 2 Ancient Debris. Bring beds or TNT to blast it out safely instead of a slow pickaxe crawl, and never mine it with fire nearby."
		""
		"Smelt it into scrap and it becomes the first half of a Netherite Ingot."
	]
	quest.408268A0E9C639C1.title: "Fire Types of the Nether"
	quest.408268A0E9C639C1.subtitle: "A proper fire team"
	quest.408268A0E9C639C1.description: [
		"Build a squad suited to the heat. Catch 3 Fire type Pokemon down here."
		""
		"&e&lTip:&r Charizard, Magmar and Torkoal spawn in the basalt deltas and the nether wastes."
		""
		"Fire types resist the environment and hit hard. A strong catch here carries you through the rest of the dimension."
	]
	quest.40CE4F3B89953E7A.title: "First Fire Catch"
	quest.40CE4F3B89953E7A.subtitle: "One more for the squad"
	quest.40CE4F3B89953E7A.description: [
		"Your fire team is strong, but a true trainer never stops scouting."
		""
		"Catch 1 more Fire type Pokemon in the Nether. Basalt deltas and the wastes are still your best bet."
	]
	quest.40EF3BD366314373.title: "Ghast Tears"
	quest.40EF3BD366314373.subtitle: "Tears from the sky"
	quest.40EF3BD366314373.description: [
		"Ghasts float over the wastes and cry when they die."
		""
		"Kill a Ghast for 1 Ghast Tear. Shoot back their own fireballs if you have no bow, it deals heavy damage."
		""
		"Tears brew into Regeneration Potions, a lifesaver in any dangerous fight."
	]
	quest.40FF75F82B92A6B7.title: "Magma Cream"
	quest.40FF75F82B92A6B7.subtitle: "Cooled from the core"
	quest.40FF75F82B92A6B7.description: [
		"Magma Cubes bounce through the lower caves and basalt deltas, dropping magma cream when slain."
		""
		"Gather 4 Magma Cream, from cubes or crafted from a Magma Block and Slimeball if you would rather not fight."
		""
		"Brew it into Fire Resistance Potions and lava stops being a threat."
	]
	quest.402B24236BC528BD.title: "Nether Wart \& Brewing"
	quest.402B24236BC528BD.subtitle: "Brew and grow"
	quest.402B24236BC528BD.description: [
		"&aNether Wart&r is the base of every potion, grown in fortress soul sand gardens."
		""
		"Collect 8 Nether Wart and start a brewing supply. Potions keep you and your team in the fight."
	]
	quest.408EF2591FC945BB.title: "Netherite Gear"
	quest.408EF2591FC945BB.subtitle: "Master of the fire realm"
	quest.408EF2591FC945BB.description: [
		"You have looted the fortress, raided the bastion and forged the hardest metal in the game."
		""
		"Smelt Ancient Debris into Netherite Scrap, then combine 4 Scrap with 4 Gold Ingots to forge 1 Netherite Ingot."
		""
		"It is not merely crafted. It is earned. Netherite gear survives what diamond cannot, and nothing in the Nether can stop you now."
	]
	chapter.2139644C7994A01B.title: "&5The Final Frontier"
	quest.4000000000000B01.title: "&5The Final Frontier"
	quest.4000000000000B01.subtitle: "Beyond the last star"
	quest.4000000000000B01.quest_desc: [
		"Every great trainer starts somewhere. This is where the road ends, in a dimension of pure void and purple stone."
		""
		"Check the mark to open the End quest line: the eyes that find the gate, the dragon that guards it, and the cities that drift beyond."
		""
		"There is no going back to being an amateur after this. The Final Frontier begins now."
	]
	quest.4007E20DAC235BE9.title: "Eyes of Ender"
	quest.4007E20DAC235BE9.subtitle: "Craft your way to the gate"
	quest.4007E20DAC235BE9.quest_desc: [
		"An Eye of Ender is a Blaze Powder fused with an Ender Pearl, and it is the only thing in this world that can smell out a Stronghold."
		""
		"Craft 6 Eyes of Ender. Throw one and watch where it flies, it always drifts toward the nearest Stronghold portal room before shattering or falling."
		""
		"Tip: keep a few in reserve. Some throws break or get lost down a ravine, and the portal room needs several placed at once."
	]
	quest.4089CCC850C250F5.title: "Enter the End"
	quest.4089CCC850C250F5.subtitle: "Into the void"
	quest.4089CCC850C250F5.quest_desc: [
		"Follow your Eyes of Ender down into the Stronghold and find the portal room, ringed with Eyes already half-socketed into its frame."
		""
		"Fill the remaining sockets, step through, and bring blocks to bridge along with a bow. The dragon does not wait for you to get comfortable."
		""
		"This is the true threshold of the End dimension. Everything past this point is played for keeps."
	]
	quest.409E53EBB16ED918.title: "Slay the Dragon"
	quest.409E53EBB16ED918.subtitle: "Break the crystals first"
	quest.409E53EBB16ED918.quest_desc: [
		"The Ender Dragon rules the central island, and it heals every time it touches the beam of an End Crystal still standing on its obsidian pillar."
		""
		"Tip: destroy every End Crystal first, from the ground with arrows or by climbing the pillars, before you commit to fighting the dragon itself. Skip this step and the fight never ends."
		""
		"This is the pivot of the whole dimension. Killing the dragon opens the exit gateway to the outer islands and everything beyond them."
	]
	quest.405357394611F7F4.title: "Reach an End City"
	quest.405357394611F7F4.subtitle: "Navigate the outer islands"
	quest.405357394611F7F4.quest_desc: [
		"Jump into the exit gateway the dragon left behind and you will land on the outer End islands, a scatter of floating rock adrift in the void."
		""
		"Bring a stack of Ender Pearls or an Elytra if you already have one, then island-hop until a City of purple Purpur towers rises out of the dark."
		""
		"End Cities hold the best loot in the dimension. Finding one is the gateway to everything past this quest."
	]
	quest.4054629EF17E4552.title: "Shulker Shells"
	quest.4054629EF17E4552.subtitle: "Hunt the boxes on legs"
	quest.4054629EF17E4552.quest_desc: [
		"Shulkers cling to the walls of End Cities, disguised as blocks until they pop open and start lobbing levitation shells at you."
		""
		"Defeat 2 Shulkers for their Shells. Combine 2 Shells with a Chest to craft a Shulker Box, a portable storage block that keeps its contents even when broken and picked back up."
		""
		"Tip: place a Shulker Box down, loot it, then mine it again. Nothing spills. It is the best inventory expansion in the game."
	]
	quest.4040629EF17E4552.title: "Claim the Elytra"
	quest.4040629EF17E4552.subtitle: "Wings at last"
	quest.4040629EF17E4552.quest_desc: [
		"Somewhere in the City floats an End Ship, a wrecked purple vessel usually guarded by its own Shulker, with the Elytra mounted in an item frame on deck."
		""
		"Take the Elytra from the frame. It is the only way to glide in this world, and there is no crafting recipe for it, only this one guaranteed spot."
		""
		"Guard it with your life. Losing this Elytra means another full trip back out to an End City."
	]
	quest.401C56BC12A6160F.title: "Take Flight"
	quest.401C56BC12A6160F.subtitle: "Learn to glide"
	quest.401C56BC12A6160F.quest_desc: [
		"An Elytra on your back does nothing until you jump and actually open it. The void is a forgiving place to learn, so long as you do not aim down."
		""
		"Boost yourself with a Firework Rocket held while gliding for an instant burst of speed, or let a Shulker's levitation bullet fling you 50 blocks into the air and glide out of the fall."
		""
		"Once you can steer confidently, the whole map opens up. No more walking when you can fly."
	]
	quest.4059CC3CE24C1001.title: "Chorus Harvest"
	quest.4059CC3CE24C1001.subtitle: "Farm the purple stalks"
	quest.4059CC3CE24C1001.quest_desc: [
		"Chorus Plants are the tall purple stalks growing wild across the outer islands, the only crop that thrives in this dimension's cracked end stone."
		""
		"Harvest 1 Chorus Fruit. Eating it randomly teleports you a short distance, useful for crossing gaps or escaping a bad fall. Break the flower at the top of a stalk to farm it properly and it will regrow from the stem below."
		""
		"Tip: Chorus Fruit is also the base ingredient for Popped Chorus Fruit and Purpur Blocks, both essential for building anything that belongs in the End."
	]
	quest.4064C3F139A34C8D.title: "Dragon Trophies"
	quest.4064C3F139A34C8D.subtitle: "Claim your proof"
	quest.4064C3F139A34C8D.quest_desc: [
		"Two trophies remain once the dragon falls: the Dragon Egg sitting on its obsidian pedestal, and Dragon's Breath curling from its final attacks."
		""
		"Tip: the Dragon Egg teleports away the instant you strike it. Place a block to remove its landing spot, or slide a piston underneath and push it off the pedestal to capture it without a single chase."
		""
		"Bottle the Dragon's Breath with a glass bottle while it lingers in the air after the kill. Both trophies prove you were there when the dragon fell."
	]
	quest.403EA98C0D6DA092.title: "Void Psychics"
	quest.403EA98C0D6DA092.subtitle: "Minds beyond the void"
	quest.403EA98C0D6DA092.quest_desc: [
		"The void of the End does not stay empty. It hums with a strange psychic energy that draws Psychic-type Pokemon to nest here."
		""
		"Catch 2 Psychic-type Pokemon in the End. Tip: Beldum is one of them, a slow steel-and-psychic oddity that evolves all the way into the fearsome Metagross."
		""
		"Every Psychic catch here strengthens a team built for the strangest minds in the game."
	]
	quest.40D62523710408DC.title: "The Winged Guardian"
	quest.40D62523710408DC.subtitle: "A watcher on the wind"
	quest.40D62523710408DC.quest_desc: [
		"High above the End Cities glides a watchful shape, wings spread wide, patient and silent over the ruins below."
		""
		"Catch Sigilyph, the winged guardian of the void. It is a Psychic and Flying type that patrols these floating islands like it has always belonged here."
		""
		"A rare sight even for seasoned End explorers. Few trainers ever look up in time to spot one."
	]
	quest.4044E086A32B8BAB.title: "The Symbol Seeker"
	quest.4044E086A32B8BAB.subtitle: "Letters adrift in the dark"
	quest.4044E086A32B8BAB.quest_desc: [
		"Near the ruins of the End Cities, strange stone tablets drift through the void, each one etched with a single ancient symbol."
		""
		"Catch an Unown. Every one is shaped like a different letter, and no two trainers ever seem to collect the same set first."
		""
		"They are a curiosity more than a fighter, but no End dex feels complete without at least one symbol in your team."
	]
	quest.40C8746684D36B5F.title: "Whispers of the Void"
	quest.40C8746684D36B5F.subtitle: "Names the void remembers"
	quest.40C8746684D36B5F.quest_desc: [
		"Listen closely at the edge of the islands and the void seems to whisper two names it will not let go of: Giratina, and something else, older, called Eternatus."
		""
		"Neither can be caught here, not by any trainer, not by any means. They are older than the dragon you slew, and the void only remembers them, it does not release them."
		""
		"&eClaim the reward anyway. The void does not give up its secrets for free, but it pays those who listen.&r"
	]
	quest.4066CC3CE24C1002.title: "Voidwalker's Kit"
	quest.4066CC3CE24C1002.subtitle: "Build where nothing grows"
	quest.4066CC3CE24C1002.quest_desc: [
		"An outpost in the void needs materials that belong to the void. End Stone Bricks and Purpur are the only stones native to this dimension."
		""
		"Gather 16 End Stone Bricks, cut and crafted from the endless end stone underfoot. Pair them with Purpur from your Chorus farm to build a base that actually looks like it survives out here."
		""
		"Optional, but worth it. A proper voidwalker never has to fly all the way home just to restock."
	]
	quest.4053CC3CE24C8C96.title: "Master of the End"
	quest.4053CC3CE24C8C96.subtitle: "The void bows"
	quest.4053CC3CE24C8C96.quest_desc: [
		"The dragon is dead, the cities are looted, the Elytra is yours, and the psychic guardians of the void have been caught, one by one."
		""
		"Claim your prize from the End Cache: a random pull worthy of everything you conquered here, plus a Dragon Head to mount as proof."
		""
		"The Final Frontier no longer deserves its name. You have been past it, and back."
	]
	chapter.6E1047B29BA85246.title: "&bUncharted"
	quest.6E10B03DE71321DC.title: "Uncharted"
	quest.6E10B03DE71321DC.quest_desc: ["The world doesn't end at your base's doorstep. Somewhere out there are ruins nobody's cracked open, biomes nobody's set foot in, and loot with your name on it.", "", "This chapter is entirely optional, work through it at your own pace. It'll teach you fast travel with waystones, biome tracking with the Nature's Compass, and structure looting where nobody else can steal your rewards (thanks to Lootr).", "", "Check this quest to unlock the map and see what's waiting past the horizon."]
	quest.6E1037562EB8A8BE.title: "Waystone Network"
	quest.6E1037562EB8A8BE.quest_desc: ["You've already got a waystone back home, every trainer does. But one waystone is a landmark, not a network.", "", "Place at least 2 more waystones (right click to activate, then name them) at different bases or points of interest. Right click any activated waystone to open the list and warp instantly between all of them.", "", "This is about mobility, not the block itself: the more waystones you place, the smaller the map feels."]
	quest.6E107965A127F923.title: "Warp Scroll"
	quest.6E107965A127F923.quest_desc: ["Sometimes an expedition goes sideways and you just need out, right now, no backtracking through a Frosted Cave full of angry mobs.", "", "Craft a Warp Scroll and use it near any activated waystone to bind it, then use it again anytime to teleport straight there. It's consumed on use: one scroll, one trip.", "", "Keep a couple in your hotbar before heading into unknown territory."]
	quest.6E10FA9BC8BB53C1.title: "Bound Scroll"
	quest.6E10FA9BC8BB53C1.quest_desc: ["Here's a trick most players miss: a scroll doesn't have to open a menu every time.", "", "Hold a Bound Scroll and right click a waystone to lock it to that exact destination. From then on, using the scroll teleports you straight there, no waystone list, no picking.", "", "Perfect for a dedicated base-to-farm shuttle you'll use over and over."]
	quest.6E1028ADFBFD29F0.title: "Warp Stone"
	quest.6E1028ADFBFD29F0.quest_desc: ["Scrolls are great, but they're one-shot. Eventually you want fast travel that never runs out.", "", "Craft a Warp Stone: it works just like a scroll, but it's reusable forever (just respect the cooldown between warps).", "", "Once you have one, you'll never craft a throwaway scroll again."]
	quest.6E10CAABE2FB9047.title: "Nature's Compass"
	quest.6E10CAABE2FB9047.quest_desc: ["You've already got a Nature's Compass in your inventory from the tutorial, it's not just a decoration.", "", "Right click it, pick a biome (including modded ones), and it'll point you straight there, cutting hours of blind wandering down to a short walk.", "", "This is your GPS for every biome-hunting quest in this chapter, keep it on you."]
	quest.6E107C4620D6D510.title: "Better Dungeons"
	quest.6E107C4620D6D510.quest_desc: ["The overhauled dungeons scattered underground aren't your average mob spawner box anymore, they're proper skeleton, spider, and zombie lairs with layered rooms and real threats.", "", "Find one and clear it out, expect waves of mobs, not just a single cage.", "", "Consider it your first real test of exploration gear."]
	quest.6E1038B6474C8135.title: "Better Mineshafts"
	quest.6E1038B6474C8135.quest_desc: ["Vanilla mineshafts got a serious glow-up: they're now sprawling, themed differently depending on the biome they spawn in, and much more worth exploring.", "", "Find and explore one, tick this quest once you've done it (honor system, no item to turn in).", "", "Great way to see how varied the underground has become."]
	quest.6E10288B9913A01D.title: "Better Strongholds"
	quest.6E10288B9913A01D.quest_desc: ["Reworked strongholds now pack a library, a crypt, a prison block, and an armory, and you don't need to light a single End Portal to loot them.", "", "Track one down and clear it out for the loot alone.", "", "One of the richest structures you can raid without ever touching the End."]
	quest.6E1049A05270266B.title: "Sky Village"
	quest.6E1049A05270266B.quest_desc: ["Not every village keeps its feet on the ground. Somewhere up in the clouds floats an entire village, houses, paths, villagers and all.", "", "Spot one from the ground (look up while exploring) and climb your way to it. Tick this quest once you've set foot in it (honor system).", "", "One of the most striking sights this modpack has to offer."]
	quest.6E10E3FE13AE8A1E.title: "Towns \& Towers"
	quest.6E10E3FE13AE8A1E.quest_desc: ["Villages and outposts have been reimagined per biome, no two look quite the same anymore.", "", "Visit a modded village or outpost variant you haven't seen before, tick this quest once you've walked through it (honor system).", "", "Worth the detour just to see how much variety got packed in."]
	quest.6E10A58CA4C4974D.title: "Wandering Structures"
	quest.6E10A58CA4C4974D.quest_desc: ["Beyond the big landmarks, small hand-built structures are scattered across the world: cartographer towers, windmills, abandoned camps.", "", "Stumble onto one during your travels and tick this quest once you have (honor system, no specific item needed).", "", "These micro-adventures are half the fun of just wandering off the beaten path."]
	quest.6E10E800E67D6C98.title: "Explorify"
	quest.6E10E800E67D6C98.quest_desc: ["New overworld ruins, taverns, and mausoleums now dot the landscape, built for atmosphere as much as loot.", "", "Find and raid one, tick this quest once you've cleared it (honor system).", "", "Pure adventure flavor: the kind of find that makes exploring worth it."]
	quest.6E103C87B9B175DC.title: "Instanced Loot"
	quest.6E103C87B9B175DC.quest_desc: ["Here's the single most important thing to know about exploring in Steamon: loot chests in structures are instanced per player. Nobody can beat you to it, and you can't beat anyone else to it either.", "", "Look at the chest's color before opening: gold means you haven't looted it yet, blue means you already have. Golden particles floating off a chest mean there's still loot waiting inside, visible from a good distance, use them to scout structures fast.", "", "Once you get this, exploring stops being a race and starts being genuinely relaxing."]
	quest.6E1083A367BFEF5D.title: "Trapped by Loot"
	quest.6E1083A367BFEF5D.quest_desc: ["Not every golden chest is a free lunch. Some Lootr chests still carry the original structure's redstone traps: pressure plates, tripwires, the works.", "", "Check your surroundings before yanking a chest open, especially in mineshafts and dungeons where traps are common.", "", "A little caution here saves you an unexpected TNT surprise."]
	quest.6E1023BAB0B46F62.title: "Ten Times the Loot"
	quest.6E1023BAB0B46F62.quest_desc: ["One instanced chest is nice. Ten is a habit.", "", "Open 10 Lootr containers total (chests, barrels, whatever counts), across any structures you explore.", "", "It's a nudge to actually get out there and loot, now that nothing's stopping you from taking your share."]
	quest.6E104A6DD56DCB5B.title: "Social Looter"
	quest.6E104A6DD56DCB5B.quest_desc: ["Lootr doesn't just instance chests, it covers barrels, shulker boxes, and even decorative pots found in structures.", "", "Open at least one of each type (chest, barrel, shulker box, pot) to see the system in action across the board.", "", "A quick way to realize just how far the \"your loot is yours\" rule extends."]
	quest.6E10CD98801F10AC.title: "Gilded Cobblemon Chest"
	quest.6E10CD98801F10AC.quest_desc: ["Cobblemon has its own loot structures too, and thanks to Lootr's Cobblemon compatibility, they're instanced exactly like everything else.", "", "Find a Cobblemon loot chest and open it while it's still gold (honor system, no turn-in needed).", "", "Your Pokemon loot, reserved for you and nobody else."]
	quest.6E10C5A68B5A3B0B.title: "Frosted Caves"
	quest.6E10C5A68B5A3B0B.quest_desc: ["Beneath the frost and snow biomes hide entire cave systems of their own: the Frosted Caves, icy and easy to miss from the surface.", "", "Use your Nature's Compass to track one down, or just dig until the stone turns to ice and packed snow.", "", "First of several unique cave biomes worth hunting down."]
	quest.6E1067B976010F8C.title: "Lost Caves"
	quest.6E1067B976010F8C.quest_desc: ["Deep underground, sandstorms rage through cavern systems lined with ancient sandstone: welcome to the Lost Caves.", "", "Find one, either by digging deep or pointing your Nature's Compass at it.", "", "A completely different underground vibe from anything vanilla offers."]
	quest.6E10E7AFDEC37B56.title: "Prickly Peach"
	quest.6E10E7AFDEC37B56.quest_desc: ["The cactus growing wild in the Lost Caves isn't just decoration, it actually bears fruit.", "", "Harvest a Prickly Peach from one of those cacti and eat it.", "", "A tiny discovery, but one plenty of players walk right past without noticing."]
	quest.6E106306A4B895CB.title: "Biome Hunter"
	quest.6E106306A4B895CB.quest_desc: ["Biome \& World Generation quietly adds dozens of unique biomes to the overworld, each with its own look and feel, and even the trees grow differently there thanks to Oh The Trees You'll Grow.", "", "Pull up your Nature's Compass, pick a biome you've never visited, and track it down.", "", "Consider this your gateway into just how much new terrain is hiding in your world."]
	quest.6E10F98F36C1674E.title: "Exotic Wood: Aspen"
	quest.6E10F98F36C1674E.quest_desc: ["Not every tree in this world is oak and birch. Aspen groves bring their own pale, striking wood to the table.", "", "Chop an Aspen Log and plant an Aspen sapling of your own before you leave.", "", "First entry in your exotic wood collection: two more species to go."]
	quest.6E10EE6BE21AEAE5.title: "Exotic Wood: Baobab"
	quest.6E10EE6BE21AEAE5.quest_desc: ["Towering and unmistakable, Baobab trees are some of the tallest you'll find anywhere in the world.", "", "Harvest a Baobab Log and plant a sapling to grow your own.", "", "Second wood down: keep collecting to round out the set."]
	quest.6E10F1A353738BAD.title: "Exotic Wood: Ebony"
	quest.6E10F1A353738BAD.quest_desc: ["Dark, dense, and striking, Ebony wood stands out against every other timber you've collected so far.", "", "Chop an Ebony Log and plant a sapling before moving on.", "", "Third and final wood: complete the set and call yourself a collector."]
	quest.6E105267554AE144.title: "Far Shores"
	quest.6E105267554AE144.quest_desc: ["Continents reshapes the world into genuinely vast landmasses separated by real ocean, not the small islands you're used to.", "", "Build or find a boat, and sail until you make landfall on a continent far from your starting shore. Tick this quest once you've arrived (honor system).", "", "The kind of journey that reminds you just how big this world really is."]
	quest.6E105E7F04571115.title: "Safe Camp"
	quest.6E105E7F04571115.quest_desc: ["You already know how to craft a Magnum Torch, it kept your starting base safe from day one.", "", "Place one at any wild outpost or expedition camp far from home to stop mobs from spawning around it.", "", "A must before you set up a base camp deep in unexplored territory."]
	quest.6E10B1DD57D7156C.title: "Cartographer"
	quest.6E10B1DD57D7156C.quest_desc: ["You've charted the unknown: structures raided, biomes walked, a waystone network stretched across the map. Uncharted doesn't feel like the right word anymore.", "", "Complete at least 6 major exploration objectives from this chapter to earn this title.", "", "The honorary capstone of everything you've uncovered so far."]
	quest.212068CDC4844341.description: [
		"Your factory is built. Now make it move, make it store, and make it split the atom.",
		"",
		"This chapter is pure prestige: trains, mass logistics, and nuclear power. None of it is required to survive Steamon, but all of it will make your empire unstoppable. Pick a branch below and dive in."
	]
	quest.212068CDC4844341.title: "Beyond the Machine"
	quest.211D6BE7E4510D77.description: [
		"Every empire needs a railway. Create's steampunk trains are about to become your fastest way to move goods and players across the map.",
		"",
		"Place Tracks on the ground: they curve and slope automatically to follow the terrain, no manual angling needed. Lay at least one straight stretch to get started.",
		"",
		"This is the foundation of your entire rail network."
	]
	quest.211D6BE7E4510D77.title: "Laying Track"
	quest.2153FF31C75B2388.description: [
		"A track without a station is just a dead-end line. The Station is where trains assemble, dock, and follow their timetable.",
		"",
		"Craft a Railway Casing (the structural block behind every train part) and place a Track Station directly alongside a rail.",
		"",
		"This is the infrastructure piece every train route needs."
	]
	quest.2153FF31C75B2388.title: "Station \& Casing"
	quest.20BB261D93BD450F.description: [
		"A train with no orders just sits there looking pretty. The Schedule is the brain that tells it where to go and when to leave.",
		"",
		"Place a Schedule, then write in your destinations and any wait conditions (timer, redstone, refuel, etc).",
		"",
		"Get this right and your train runs itself, forever."
	]
	quest.20BB261D93BD450F.title: "Train Schedule"
	quest.20CFB6821978F660.description: [
		"Here's the trick nobody tells you: a bogey is not an item you craft and place.",
		"",
		"Put a Railway Casing on top of laid rails, then right-click it to spawn the bogey. &eHold Alt while placing to cycle through bogey styles.&r Assemble a locomotive, bogeys, a seat, and a Schedule together.",
		"",
		"That's your first complete train, ready to roll."
	]
	quest.20CFB6821978F660.title: "Building a Bogey"
	quest.20716E011753F0B8.description: [
		"One train is easy. A dozen trains sharing the same rails without colliding? That takes signals.",
		"",
		"Use the Conductor's Whistle to manage who's driving, and place Semaphores at junctions so trains wait their turn instead of crashing.",
		"",
		"Tip: a network with proper signals scales to as many trains as you can build."
	]
	quest.20716E011753F0B8.title: "Conductor's Whistle"
	quest.20421F7525DCD444.description: [
		"Your factory is finally producing faster than you can carry it away. Time for storage on an industrial scale.",
		"",
		"Stack several Vibrant Vaults adjacent to each other: they assemble into a single massive multiblock, and you can dye the whole thing in any of 16 colors to color-code your warehouse.",
		"",
		"This is where your factory's output finally has a home."
	]
	quest.20421F7525DCD444.title: "The Vibrant Vault"
	quest.20AB89B70AF263E2.description: [
		"Loose items are fine for a workshop. An empire ships in bulk.",
		"",
		"Use a Packager to box items into neat Packages, then load them into a Shipping Container. Pair this with a train route to move full containers automatically, station to station.",
		"",
		"This is the backbone of real automated logistics."
	]
	quest.20AB89B70AF263E2.title: "Packaging \& Shipping"
	quest.21F2F8F25B1BA588.description: [
		"Create Connected adds the tools for precision timing: 6-directional gearboxes, brakes, and pulse generators.",
		"",
		"Build a Sequenced Pulse Generator to fire timed redstone pulses, perfect for triggering contraptions on an exact rhythm instead of a crude clock.",
		"",
		"Tip: this is the difference between a machine that works and one that works elegantly."
	]
	quest.21F2F8F25B1BA588.title: "Create Connected"
	quest.21D9808509537439.description: [
		"Ultimate Factory doesn't add a single new block. It adds recipes, and that changes everything.",
		"",
		"Your existing Create machines (Millstone, Mixer, Crushing Wheels...) can now process Blackstone, End Stone, Netherite, and more. &eCheck REI for the full list.&r",
		"",
		"Time to put your factory to work on materials you never thought it could touch."
	]
	quest.21D9808509537439.title: "Ultimate Factory"
	quest.21AD64735C54E189.description: [
		"Warning: nuclear power is not free. It must be earned, and it can kill you if you're careless.",
		"",
		"Smelt Steel in a Blast Furnace, or produce it through Create mixing if you'd rather automate it.",
		"",
		"This is the base material for every part of the reactor to come."
	]
	quest.21AD64735C54E189.title: "Forged in Steel"
	quest.219524A14AA49B8B.description: [
		"Raw Uranium is useless straight out of the ground. It has to be refined before it can power anything.",
		"",
		"Process Raw Uranium into Uranium Powder, then into Yellowcake, then finally into Uranium Rods, the actual fuel for your reactor.",
		"",
		"&eRadiation damages you without protection: check the Radiation Protection quest before you handle any of this bare.&r"
	]
	quest.219524A14AA49B8B.title: "Uranium \& Yellowcake"
	quest.200C58CB09E67968.description: [
		"Every reactor needs walls that won't melt, crack, or leak.",
		"",
		"Craft Reactor Casing: it forms the outer shell of the reactor multiblock.",
		"",
		"Structure piece 1 of 4."
	]
	quest.200C58CB09E67968.title: "Reactor Casing"
	quest.205B83E93301A030.description: [
		"You'll want to see what's happening inside a live reactor, from a safe distance.",
		"",
		"Craft Reinforced Glass to use as the reactor's observation windows: tough enough to survive next to a fission reaction.",
		"",
		"Structure piece 2 of 4."
	]
	quest.205B83E93301A030.title: "Reinforced Glass"
	quest.2006D4AE6FFD274B.description: [
		"An unmoderated reaction runs away from you fast. Graphite Rods are what keep it in check.",
		"",
		"Craft Graphite Rods: they slow the neutron flux so the reaction stays controllable instead of spiraling.",
		"",
		"Structure piece 3 of 4."
	]
	quest.2006D4AE6FFD274B.title: "Graphite Rod"
	quest.2005A84512DC2C78.description: [
		"Walls alone won't stop radiation. You need something dense enough to actually block it.",
		"",
		"Craft Lead Shielding and line the reactor's walls with it to contain radiation on the inside where it belongs.",
		"",
		"Structure piece 4 of 4, the last one before assembly."
	]
	quest.2005A84512DC2C78.title: "Lead Shielding"
	quest.20A321388A129773.description: [
		"This is the centerpiece: the Core holds the reaction, the Controller lets you run it.",
		"",
		"Assemble the full multiblock: Casing and Lead Shielding around the outside, Reinforced Glass windows, Graphite Rods and Core at the center, Controller on the front face, then insert your Uranium Rods.",
		"",
		"Power on the Controller and you've got a working reactor."
	]
	quest.20A321388A129773.title: "Reactor Core \& Controller"
	quest.21B6E74294D9919E.description: [
		"It is not merely crafted. It is earned: a power that rivals the sun, contained in a shell of steel.",
		"",
		"Push your reactor past 2 million Stress Units of output. Overheating means meltdown, so keep it cooled and watch your temperature gauge at all times.",
		"",
		"This is the industrial peak of nuclear power in Steamon."
	]
	quest.21B6E74294D9919E.title: "Going Critical"
	quest.21577C5F53523680.description: [
		"A reactor doesn't ask permission before it hurts you. Radiation deals damage that gets worse the longer you're exposed.",
		"",
		"Craft and wear the full anti-radiation set: Helmet, Chestplate, Leggings, and Boots together. All four pieces are required for full immunity, missing even one leaves you exposed.",
		"",
		"Survive the power plant you just built."
	]
	quest.21577C5F53523680.title: "Radiation Protection"
	quest.20E7F625CC2F6BF3.description: [
		"From your first lump of Andesite to splitting the atom: this is where the Create story closes.",
		"",
		"Complete at least 2 of the 3 great endgame paths: a working train network, automated packaging/shipping logistics, or a critical nuclear reactor.",
		"",
		"Finish this and the Create chapters are done. Whatever you build next is entirely yours."
	]
	quest.20E7F625CC2F6BF3.title: "Master of Atom \& Rails"
}

{
	chapter.11428B5DCB284F18.title: "The Aether"
	chapter.13E19555881008B6.title: "&6Cogs \& Crates"
	chapter.217E2268CE450D1B.title: "Trainer's First Steps"
	chapter.2A69463259A2529A.title: "PvP Battle Items"
	chapter.2BC90E55E57FA3C2.title: "Daily Quests"
	chapter.320A946A705510B3.title: "Beyond the Machine"
	chapter.3D0322088ABD7480.title: "Otherside"
	chapter.46B599A838F27B8A.title: "&2Farm to Table"
	chapter.51000000000001F4.title: "&2Delights of the World"
	quest.5000000000000004.title: "Fresh Fields"
	quest.5000000000000004.quest_desc: ["Every kitchen starts with what grows in the ground.", "", "Scythe through tall grass to find Cabbage Seeds hiding in the drops. Plant them, wait for the harvest, and pick up your first Cabbage.", "", "Your farm just became the foundation of every meal to come."]
	quest.5000000000000008.title: "The Flint Knife"
	quest.5000000000000008.quest_desc: ["Before pots and pans, a cook needs a blade.", "", "Craft a Flint Knife from flint, a stick, and planks. It is crude, but it is the tool every Farmer's Delight recipe starts with.", "", "Keep it on you: you will be cutting a lot from here on."]
	quest.500000000000000C.title: "The Iron Knife"
	quest.500000000000000C.quest_desc: ["Flint chips and dulls fast. Iron holds an edge.", "", "Smith an Iron Knife. It cuts faster and lasts far longer on the Cutting Board than its flint cousin.", "", "Upgrade now, thank yourself later when you are prepping a feast."]
	quest.500000000000000F.title: "The Cutting Board"
	quest.500000000000000F.quest_desc: ["Chopping does not need a furnace or a single drop of power.", "", "Place a Cutting Board, hold your knife, and right-click ingredients on it to slice, dice, or shred them into recipe components. It costs nothing but a sliver of knife durability.", "", "Tip: &eNo fuel, no energy, no cost&r. This is the cheapest station in the whole mod."]
	quest.5000000000000013.title: "The Cooking Pot"
	quest.5000000000000013.quest_desc: ["The heart of every Farmer's Delight kitchen.", "", "Place a Cooking Pot directly on top of a heat source (a Stove or a lit Campfire), then use a Bowl on it to serve whatever is bubbling inside.", "", "Most soups, stews, and rices in this chapter pass through this pot."]
	quest.5000000000000017.title: "The Skillet"
	quest.5000000000000017.quest_desc: ["Fast food, literally: no station required.", "", "Craft a Skillet and just hold it in your hand near a heat source to fry ingredients directly, no placement needed. It also works as a blunt weapon in a pinch.", "", "Tip: &eThe Skillet cooks while held, it is your fastest way to a hot meal.&r"]
	quest.500000000000001B.title: "Harvest Straw"
	quest.500000000000001B.quest_desc: ["Wheat is not just for bread.", "", "Cut fully grown wheat with a knife instead of harvesting it by hand: you will get Straw alongside the wheat itself.", "", "Straw feeds crafting recipes and makes for cheap, rustic decoration."]
	quest.500000000000001F.title: "The Stove"
	quest.500000000000001F.quest_desc: ["One block, two ways to cook.", "", "Build a Stove: it heats both the Cooking Pot and the Skillet placed on it, and you can skewer up to 6 items on top to roast them directly, no pot needed.", "", "This is your dedicated kitchen centerpiece from here on."]
	quest.5000000000000023.title: "Fried Egg"
	quest.5000000000000023.quest_desc: ["The simplest proof your Skillet works.", "", "Use an Egg directly on a heated Skillet to fry it, no bowl, no pot, just a hot pan.", "", "A quick bite, and your first real dish."]
	quest.5000000000000027.title: "Rich Soil"
	quest.5000000000000027.quest_desc: ["Nothing goes to waste in a real kitchen.", "", "Compost your food scraps into Organic Compost, then use it to turn farmland into Rich Soil. Crops planted on it grow noticeably faster.", "", "Tip: &eRich Soil is the payoff loop: cook, compost, farm faster, cook more.&r"]
	quest.500000000000002B.title: "Campfire Cooking"
	quest.500000000000002B.quest_desc: ["You do not always need a Cooking Pot to eat well.", "", "Place raw food directly on a lit vanilla Campfire: it can cook up to 4 items at once without any Farmer's Delight station at all.", "", "Perfect for a quick camp meal out in the field."]
	quest.500000000000002F.title: "Cooked Rice"
	quest.500000000000002F.quest_desc: ["The backbone of half the recipes in this mod.", "", "Harvest Rice Panicles from a rice paddy, then cook them in a Cooking Pot to get Cooked Rice.", "", "Keep a stack on hand: many dishes ahead call for it."]
	quest.5000000000000033.title: "Vegetable Soup"
	quest.5000000000000033.quest_desc: ["A simple soup, entirely from your own farm.", "", "Combine your vegetables in a Cooking Pot, then serve with a Bowl.", "", "Cheap, filling, and a great early Nourishment source."]
	quest.5000000000000037.title: "Beef Stew"
	quest.5000000000000037.quest_desc: ["Meat and vegetables, together in one pot.", "", "Cook beef alongside your farmed vegetables in the Cooking Pot for a heartier stew than soup alone.", "", "A staple meal that keeps hunger and Nourishment topped up."]
	quest.500000000000003B.title: "Mixed Salad"
	quest.500000000000003B.quest_desc: ["No fire, no pot, no wait.", "", "Chop your vegetables on the Cutting Board and combine them raw: no cooking tool involved at all.", "", "The fastest meal in the whole mod when you are in a hurry."]
	quest.500000000000003F.title: "Fish Stew"
	quest.500000000000003F.quest_desc: ["Something from the water, for a change.", "", "Cook Cod or Salmon with vegetables in the Cooking Pot to make Fish Stew.", "", "A great use for whatever you reel in between farming sessions."]
	quest.5000000000000043.title: "Apple Pie"
	quest.5000000000000043.quest_desc: ["Dessert needs a crust first.", "", "Shape a Pie Crust on the Cutting Board, then bake it with apples to get a full Apple Pie.", "", "Sweet, simple, and the gateway to every other pie in this mod."]
	quest.5000000000000047.title: "Hamburger"
	quest.5000000000000047.quest_desc: ["The dish everyone remembers Farmer's Delight for.", "", "Shape Bread Dough into Buns, cook a Beef Patty on the Skillet, then stack them together.", "", "This is the mod's signature meal, and one of its best Nourishment values."]
	quest.500000000000004B.title: "Stuffed Pumpkin"
	quest.500000000000004B.quest_desc: ["A feast built for the whole table.", "", "Hollow out a pumpkin, stuff it, and place it as a Stuffed Pumpkin Block: right-click to carve out individual servings for everyone at the table.", "", "Great for co-op play: one block feeds a crowd."]
	quest.500000000000004F.title: "Roast Chicken"
	quest.500000000000004F.quest_desc: ["Nothing says feast like a whole bird on the table.", "", "Roast a full chicken and place it down as a feast block, then carve individual plates from it with a knife.", "", "Another multi-serving centerpiece for shared meals."]
	quest.5000000000000053.title: "Honey Glazed Ham"
	quest.5000000000000053.quest_desc: ["A prestige dish worth the extra prep.", "", "Glaze a ham with honey and place it as a feast block for the table.", "", "One of the richest Nourishment dishes in the base mod, save it for when you need it most."]
	quest.5000000000000059.title: "Master Chef"
	quest.5000000000000059.quest_desc: ["You have cooked your way through the entire Farmer's Delight menu.", "", "Prepare every dish in this chapter to earn the Master Chef advancement.", "", "This unlocks the world's regional kitchens (Delights of the World) and opens the door to automating your kitchen with Create."]
	quest.5100000000000004.title: "Delights of the World"
	quest.5100000000000004.quest_desc: ["Every dimension and culture has its own kitchen.", "", "You have already mastered the Farmer's Delight basics: now it is time to see how the Nether, the Aether, the End, the depths, and cultures across the world all cook differently.", "", "Six new kitchens await, each with its own ingredients and its own signature dish."]
	quest.5100000000000008.title: "A Taste of Hell"
	quest.5100000000000008.quest_desc: ["Cooking does not stop at the portal.", "", "Build a Blazier (the Nether's own campfire) and plant Resurgent Soil to grow crops without ever going back to the Overworld.", "", "See the Nether chapter for the full rundown on where to find these."]
	quest.510000000000000C.title: "Hoglin Loin"
	quest.510000000000000C.quest_desc: ["Hunt your next meal the Nether's way.", "", "Kill a Hoglin with a knife instead of any other weapon: knife kills grant bonus cuts of meat over the usual drop.", "", "Hoglin Loin becomes your base Nether protein from here."]
	quest.5100000000000010.title: "Stuffed Hoglin"
	quest.5100000000000010.quest_desc: ["The infernal answer to a Sunday roast.", "", "Stuff a whole Hoglin and place it as a feast block to carve individual servings for the table.", "", "A proper banquet, even this deep in the Nether."]
	quest.5100000000000015.title: "Ghasta with Cream"
	quest.5100000000000015.quest_desc: ["The Nether's signature plate.", "", "Prepare a Plate of Ghasta with Cream, the addon's showcase dish.", "", "This closes out the Nether's kitchen for good."]
	quest.5100000000000019.title: "Cuisine of the Clouds"
	quest.5100000000000019.quest_desc: ["The Aether cooks on its own tier entirely.", "", "Craft Arkenium tools and build a Holystone Stove: the Aether's answer to the Cutting Board and Stove combo, using ingredients found only up there.", "", "Check the Aether chapter for exact locations of these ingredients."]
	quest.510000000000001D.title: "Moa Stew"
	quest.510000000000001D.quest_desc: ["The Aether's staple bird makes for a hearty pot.", "", "Cook Moa meat with local ingredients in a Cooking Pot for a filling stew.", "", "A solid, sky-high meal to keep you fed on your climb."]
	quest.5100000000000021.title: "Gingerbread Moa"
	quest.5100000000000021.quest_desc: ["A dessert as playful as the bird it is shaped after.", "", "Use a Cookie Cutter on gingerbread dough to shape it like a Moa before baking.", "", "A sweet, whimsical treat unique to the Aether's kitchen."]
	quest.5100000000000026.title: "Blue Berry Muffin"
	quest.5100000000000026.quest_desc: ["The Aether's signature bake.", "", "Bake a Blue Berry Muffin using the Aether's own berries.", "", "This closes out the Aether's kitchen for good."]
	quest.510000000000002A.title: "Gastronomy of the End"
	quest.510000000000002A.quest_desc: ["Even the End has a kitchen, if you know where to look.", "", "Chorus fruit, Shulker meat, and yes, even the dragon itself, all become ingredients out here.", "", "A strange, prestigious cuisine for a strange dimension."]
	quest.510000000000002E.title: "Chorus Fruit Pie"
	quest.510000000000002E.quest_desc: ["Chorus fruit is more versatile than it looks.", "", "Grind it into flour, brew it into tea, or bake it straight into a pie: this quest is about the pie.", "", "A dessert only the End can offer."]
	quest.5100000000000032.title: "Bubble Tea"
	quest.5100000000000032.quest_desc: ["A refreshing drink from an unlikely place.", "", "Brew yourself a Bubble Tea using End ingredients.", "", "A nice break between two dimension-hopping runs."]
	quest.5100000000000037.title: "Roasted Dragon"
	quest.5100000000000037.quest_desc: ["The single most prestigious dish in the entire pack.", "", "Prepare Roasted Dragon, an achievement in itself as much as a meal.", "", "This closes out the End's kitchen, and it does not get more endgame than this."]
	quest.510000000000003B.title: "Kitchen in the Dark"
	quest.510000000000003B.quest_desc: ["Miners do not need to surface to eat well.", "", "Carry a Copper Pot (a fully portable Cooking Pot) and plant Cave Carrots, which grow underground without any sunlight at all.", "", "See the Otherside chapter for where to find these ingredients."]
	quest.510000000000003F.title: "Cave Hamburger"
	quest.510000000000003F.quest_desc: ["Fast food for long expeditions.", "", "Assemble a Cave Hamburger for a quick, portable ration you can eat mid-dig without breaking your pickaxe rhythm.", "", "Nomadic food for nomadic mining."]
	quest.5100000000000043.title: "Insect Stew"
	quest.5100000000000043.quest_desc: ["When the pantry runs low underground, you improvise.", "", "Cook a stew from the insects you find in the depths.", "", "A true survival dish for when supply runs are not an option."]
	quest.5100000000000048.title: "Nutritional Bar"
	quest.5100000000000048.quest_desc: ["The Miner's signature ration.", "", "Compress a Nutritional Bar, dense enough to keep you fed on a dig with no trip back to the surface.", "", "This closes out the Miner's kitchen for good."]
	quest.510000000000004C.title: "A World of Flavor"
	quest.510000000000004C.quest_desc: ["Cultural cuisine brings entirely new ingredients to the table.", "", "Avocado, corn, and cucumber join your farm, feeding tacos, burritos, sushi, and more.", "", "A whole new set of cultures to cook through."]
	quest.5100000000000050.title: "Beef Burrito"
	quest.5100000000000050.quest_desc: ["Roll it up and dig in.", "", "Make your own Tortillas first, then fill and roll them into a Beef Burrito.", "", "Fast, filling street food from your own kitchen."]
	quest.5100000000000054.title: "Chicken Taco"
	quest.5100000000000054.quest_desc: ["A quick bite with a lot of flavor.", "", "Top a Tortilla with chicken and your garnish of choice to build a Chicken Taco.", "", "Another street food staple worth keeping in rotation."]
	quest.5100000000000059.title: "Midori Roll"
	quest.5100000000000059.quest_desc: ["The cultural kitchen's signature dish.", "", "Roll a Midori Roll with the freshest ingredients you can find.", "", "This closes out the Cultural Delights kitchen for good."]
	quest.510000000000005D.title: "The Keg"
	quest.510000000000005D.quest_desc: ["This is not cooking, it is fermenting, and it plays by different rules.", "", "Place a Keg, add your liquid and ingredients, then let it sit and mature at the right temperature.", "", "Tip: &eThe Keg is a whole new mechanic, patience and temperature matter more than heat.&r"]
	quest.5100000000000061.title: "Temperature Control"
	quest.5100000000000061.quest_desc: ["Fermentation lives and dies by the thermometer.", "", "Warmer conditions speed up the process, colder ones slow it down: adjust your Keg's environment to control the result.", "", "Master this and every recipe past this point gets easier."]
	quest.5100000000000065.title: "Flaxen Cheese"
	quest.5100000000000065.quest_desc: ["Some things just need time.", "", "Let a wheel of cheese age undisturbed until it matures into Flaxen Cheese.", "", "Patience is the only ingredient this recipe asks for."]
	quest.5100000000000069.title: "Fiery Fondue"
	quest.5100000000000069.quest_desc: ["Not every Keg recipe needs weeks of patience.", "", "Melt Flaxen Cheese down with a fiery kick to make Fiery Fondue: a quick dip that still runs through the Keg, but rewards heat instead of time.", "", "A spicier detour before you move on to real alcohol."]
	quest.510000000000006D.title: "First Brew"
	quest.510000000000006D.quest_desc: ["Your first taste of real alcohol.", "", "Ferment a batch of Beer in the Keg: it is your introduction to buffs and debuffs alike (Tipsy helps, Intoxication does not).", "", "Tip: &eDrink in moderation, the effects stack the more you have.&r"]
	quest.5100000000000072.title: "Rice Wine"
	quest.5100000000000072.quest_desc: ["The brewing branch's signature drink.", "", "Ferment a batch of Rice Wine using the technique you have now mastered.", "", "This closes out the Brewin' and Chewin' branch for good."]
	quest.5100000000000077.title: "A Taste of Every World"
	quest.5100000000000077.quest_desc: ["Nether, Aether, End, the depths, distant cultures, and fermentation itself: you have cooked through all of it.", "", "Complete every regional kitchen in this chapter to prove it.", "", "The jackpot of Steamon's culinary journey, there is nothing left to cook."]
	chapter.4B491D83F2C81B36.title: "Steamon League"
	chapter.5A5AC189BB6CF2ED.title: "Cobblemon Cooking"
	chapter.5EFD32D15CC97C4F.title: "Adventure  Loot"
	chapter.612C81EB79BF4D14.title: "Berries"
	chapter.74F26D82D9CE04F2.title: "Evolution Items"
	chapter.8082BDEB0536DB1D.title: "&aThe Steamon Journey"
	chapter.C0157DBF045118CA.title: "Evolution Items"
	chapter.C0CE44042B5F1369.title: "PvP Battle Items"
	chapter.C0F466D125501734.title: "Cobblemon Cooking"
	chapter.E6E8E3EA674E6CD1.title: "&eWelcome to Steamon"
	quest.00D9F829709642AA.title: "Gym Leader Miguel"
	quest.030706C9972D89C0.quest_desc: ["Sharply raises one random stat when HP runs low. High-risk, high-reward and famously unpredictable."]
	quest.0392EBF332416130.quest_desc: ["Changes a Pokemon's nature to Brave, reshaping its stat spread without re-breeding."]
	quest.04126E3C1AB76169.quest_desc: ["A held metal coating that evolves Onix into Steelix and Scyther into Scizor."]
	quest.05843ACAD754B724.quest_desc: ["Lowers Attack EVs and raises friendship. Handy for re-training a special attacker or evolving on friendship."]
	quest.060BBC24DA4BF541.quest_desc: ["Evolves Gligar into Gliscor when held at night, and can cause flinching."]
	quest.06BA82A06BF7842E.quest_desc: ["A firm food berry used in cooking. No held battle effect on the server."]
	quest.0786B6A084D59A9A.quest_desc: ["A bitter food berry. In the games it can pinch-heal HP but may confuse a picky Pokemon; here it is mainly a cooking ingredient."]
	quest.07B41EF5E9FD3A17.quest_desc: ["Held item that damages an attacker back when the holder is hit by a special move. The special-side counterpart to Jaboca."]
	quest.07E4C99E4BEDE8E9.quest_desc: ["Protects from weather damage and powder moves like Spore."]
	quest.0810A531D8798861.quest_desc: ["Locks the holder into one move but boosts its Special Attack by 50 percent."]
	quest.09EA7E2A62D56CB6.quest_desc: ["An eggplant-shaped food berry. Purely a cooking ingredient with no battle use."]
	quest.0A96541156F30C36.quest_desc: ["Raises the Speed IV toward its maximum."]
	quest.0CE52A5881BE9369.quest_desc: ["Boosts HP potential further; part of the IV candy set."]
	quest.0D00000000000A01.quest_desc: ["This opens the Otherside quest line. The Deeper  Darker dimension beyond the Ancient City portal."]
	quest.0D00000000000A01.title: "Welcome to the Otherside"
	quest.0D22B07789AE6D40.quest_desc: ["A fluffy Poke Puff treat used to raise a Pokemon's friendship."]
	quest.0D383980B566BC0D.quest_desc: ["A sweet cream puff snack, a tasty friendship treat."]
	quest.0D3B3DF1CC03C676.quest_desc: [
		"Craft the Sonorous Staff from a Heart of the Deep, Sculk"
		"Bones and a Soul Crystal. It fires the Warden's sonic boom"
		"on demand, the ultimate Otherside weapon."
	]
	quest.0D3B3DF1CC03C676.title: "The Sonorous Staff"
	quest.0D424E0479541DE2.quest_desc: [
		"Hold the Heart of the Deep, the guaranteed Warden drop."
		"Clear the sculk, veins and catalysts off the portal frame,"
		"then right-click the frame with the Heart to ignite it."
	]
	quest.0D424E0479541DE2.title: "Heart of the Deep"
	quest.0D56EF90278D9F98.quest_desc: [
		"Find an Ancient Temple, buried in the Deeplands biome."
		"It has three levels. An Ancient Compass points the way"
		"if you have crafted one."
	]
	quest.0D56EF90278D9F98.title: "The Ancient Temple"
	quest.0D573A3D893F8FE4.quest_desc: [
		"The Otherside is haunted. Catch 3 Ghost-type Pokemon here,"
		"from Gastly and Duskull to Golett and Spiritomb."
	]
	quest.0D573A3D893F8FE4.title: "Ghosts of the Otherside"
	quest.0D69C613943D8FB1.quest_desc: [
		"Loot the Warden Upgrade Smithing Template from Ancient City"
		"chests (about a 45% chance) or deep in the Ancient Temple."
		"You need it for every piece of Warden gear."
	]
	quest.0D69C613943D8FB1.title: "Warden Upgrade Template"
	quest.0D704EF54A8692D2.quest_desc: [
		"Enter the Otherside dimension through the ignited portal."
		"Beware: darkness is permanent here. Save near the portal"
		"and watch your footing over the void."
	]
	quest.0D704EF54A8692D2.title: "Step Into the Otherside"
	quest.0D75C87DFD66CFEA.quest_desc: [
		"The deepest reaches hide Dragon-types. Catch 3 Dragon-type"
		"Pokemon here, from Goomy and Gible to Noibat and Deino."
	]
	quest.0D75C87DFD66CFEA.title: "Dragons in the Deep"
	quest.0D802B541D5177D2.quest_desc: [
		"Craft the Reinforced Echo Shard: 4 Warden Carapace,"
		"4 Phantom Membrane and 1 Echo Shard in a crafting grid."
		"It is the addition for all Warden gear."
	]
	quest.0D802B541D5177D2.title: "Reinforced Echo Shard"
	quest.0D8409E8541916F7.quest_desc: [
		"Locate an Ancient City in the Deep Dark of the Overworld."
		"Its Reinforced Deepslate frame is a dormant Otherside portal."
		"Come prepared: the Warden lurks here."
	]
	quest.0D8409E8541916F7.title: "The Prebuilt Gate"
	quest.0D853FFF03AF874A.quest_desc: [
		"Break the 2x2 water on the temple entrance level to reach"
		"the hidden floor. Recover a Sculk Transmitter: place two"
		"and shift right-click to link them for wireless redstone."
	]
	quest.0D853FFF03AF874A.title: "The Linker"
	quest.0D910C4F83092A51.quest_desc: [
		"Smith a Resonarium Chestplate: Diamond Chestplate +"
		"Resonarium Plate + Resonarium Upgrade Template. A solid"
		"mid-game set, not the final goal of this dimension."
	]
	quest.0D910C4F83092A51.title: "Resonarium Armor"
	quest.0D994F3743783D4C.quest_desc: ["A magma-heated device that evolves Magmar into Magmortar."]
	quest.0DA011BA1F60AA1B.quest_desc: [
		"Paradox Pokemon roam the Otherside. Catch one more rare"
		"Dragon-type such as Roaring Moon or Raging Bolt to round"
		"out your Otherside dex."
	]
	quest.0DA011BA1F60AA1B.title: "Echoes of Another Time"
	quest.0DC288DA0D480DD9.quest_desc: [
		"Defeat a Warden. It always drops the Heart of the Deep"
		"and 1 to 3 Warden Carapace. The Heart is the portal key;"
		"the Carapace is the base of Warden armor."
	]
	quest.0DC288DA0D480DD9.title: "Slay the Warden"
	quest.0DD84E0B3DC7A88B.quest_desc: [
		"Combine 4 Resonarium with 4 Scutes to press a Resonarium"
		"Plate. This is the smithing addition for the whole set."
	]
	quest.0DD84E0B3DC7A88B.title: "Resonarium Plate"
	quest.0DE2D2ABD01B6240.quest_desc: [
		"Perpetual night breeds Dark-types. Catch 3 Dark-type"
		"Pokemon in the Otherside, such as Deino, Scraggy and Malamar."
	]
	quest.0DE2D2ABD01B6240.title: "Creatures of Darkness"
	quest.0DEADDEFF1333A3E.quest_desc: [
		"Visit all four Otherside biomes: the dangerous Deeplands,"
		"the calm Echoing Forest, the Overcast Columns and the"
		"Blooming Caverns."
	]
	quest.0DEADDEFF1333A3E.title: "A World to Explore"
	quest.0DEB68547CDDD594.quest_desc: [
		"The true endgame. Smith a full set of Warden armor from"
		"Netherite pieces, Reinforced Echo Shards and the Warden"
		"Upgrade Template. Sculk-forged protection for the deepest dark."
	]
	quest.0DEB68547CDDD594.title: "Warden Armor"
	quest.0DF27C813E62ED08.quest_desc: [
		"Hunt the small Sludges in the Blooming Caverns. They drop"
		"Resonarium, the raw material for a lightweight sculk armor"
		"set that sits between iron and diamond."
	]
	quest.0DF27C813E62ED08.title: "Resonarium Ore"
	quest.0DFA5A299C8FE1E3.quest_desc: [
		"Smith a Warden Helmet: Netherite Helmet + Reinforced Echo"
		"Shard + Warden Upgrade Template. Worn in the Otherside it"
		"cancels the permanent darkness effect."
	]
	quest.0DFA5A299C8FE1E3.title: "See in the Dark"
	quest.0E0D01F9864B2458.title: "Gym Leader Tee"
	quest.0E433EF0B0919A69.quest_desc: ["Adds a single Special Attack EV."]
	quest.0ED6291DA820379B.quest_desc: ["Held by Clamperl it evolves into Huntail, and boosts Special Attack."]
	quest.0F46F990084649AE.quest_desc: ["Raises Special Defense when HP runs low, helping a special wall survive the follow-up hit."]
	quest.0F99E51F573AE76E.quest_desc: ["Evolves Moon-linked Pokemon such as Nidorina and Clefairy."]
	quest.1015F00E0936A20C.quest_desc: ["Restores 10 HP when held and HP runs low. A classic early-game pinch heal for frail Pokemon."]
	quest.103C9803731EF929.quest_desc: ["Lowers Special Attack EVs and raises friendship, letting you re-train a physical attacker cleanly."]
	quest.10477055F5BA0E4B.quest_desc: ["Evolves Ice Pokemon like Alolan Vulpix and Galarian Darumaka."]
	quest.1074005F5BFE6C71.quest_desc: ["A zesty red Apricorn juice."]
	quest.10F0A6A7E1E23DFF.quest_desc: [
		"Collect every evolution stone and evolution item to unlock every branch of the Pokedex."
		""
		"Reward: a random evolution stone or rare item plus a big XP payout."
	]
	quest.10F0A6A7E1E23DFF.quest_subtitle: "Gather every evolution item"
	quest.10F0A6A7E1E23DFF.title: "Stone Collector"
	quest.130C627C6A5F1EBB.quest_desc: ["Raises the accuracy of the holder's moves by 10 percent."]
	quest.13E7C3F47FA3A2F1.quest_desc: ["Changes a Pokemon's nature to Naughty, reshaping its stat spread without re-breeding."]
	quest.1490B18DC7964605.quest_desc: ["A dry food berry, the dry member of the flavor-heal family. Best put to use in the kitchen."]
	quest.160AD5DDFCD12842.quest_desc: ["A corn-shaped food berry with no battle effect, good for cooking and juices."]
	quest.1625B3BD9C78D8C4.quest_desc: ["A rich, sweet food berry used purely in cooking and treats."]
	quest.163F89F9BD994CEA.quest_desc: ["Held item that damages an attacker back when the holder is hit by a physical move. Chip revenge on aggressive foes."]
	quest.16E7989751D62820.title: "Gym Leader Gaz"
	quest.176442F9DCC8290F.quest_desc: ["Damages attackers that make contact with the holder. Punishes physical attackers."]
	quest.17CFE63D9CCD4A62.quest_desc: ["A sweet food berry from the flavor-heal family. Sweet-tooth Pokemon love it; great for recipes."]
	quest.17E6A8EE94843D92.quest_desc: ["Adds a single Speed EV to hit a precise benchmark."]
	quest.183BDF232B778A6E.quest_desc: ["A tart food berry with no battle effect. Grow it on a plot and use it in cooking and berry recipes."]
	quest.18625E0A72A07F84.quest_desc: ["An enormous, very sweet food berry. A dessert staple in the kitchen, no battle effect."]
	quest.18646D37EA26C626.quest_desc: ["Swaps a Pokemon's Ability to its Hidden Ability. Highly sought after."]
	quest.188AE9C67B19D68A.quest_desc: ["Locks the holder into one move but boosts its Speed by 50 percent."]
	quest.18D3CED4A6ED20C3.quest_desc: ["Adds Special Attack EVs. Core vitamin for special sweepers."]
	quest.1970EE1ABE3DD38F.title: "Gym Leader Blade"
	quest.1999103A28608AC3.quest_desc: ["A simple berry drink that restores a little HP. Craftable from berries."]
	quest.1999C22F426BB20D.quest_desc: ["Halves one super-effective Water-type hit. Buys a Fire, Ground or Rock type a turn to strike back."]
	quest.19F9D702E551404C.quest_desc: ["A refreshing Apricorn juice brewed from green Apricorns."]
	quest.1A18EF9AC0DDE038.quest_desc: ["Changes a Pokemon's nature to Lax, reshaping its stat spread without re-breeding."]
	quest.1A93AD935EE3EDF2.quest_desc: ["A bitter herbal powder that cures all status conditions cheaply."]
	quest.1AC65393D96E9678.quest_desc: ["Revives a fainted Pokemon with full HP. The premium revival item."]
	quest.1AF90F28483C7B8D.quest_desc: ["A light stone held item that halves the holder's weight for weight-based moves."]
	quest.1B917470468262BB.quest_desc: ["Changes a Pokemon's nature to Lonely, reshaping its stat spread without re-breeding."]
	quest.1BFA2B372F6E2B48.quest_desc: ["Halves one super-effective Grass-type hit, easing the Grass weakness of Water, Ground and Rock types."]
	quest.1C0F43010C872618.quest_desc: ["A mysterious berry that heals the holder when hit by a super-effective move. Rare, powerful, and hard to grow."]
	quest.1D1EE056126AAA28.quest_desc: ["A soft blue food berry used in cooking and dyes. Purely culinary, no battle use."]
	quest.1FB03D40A5F26F5E.quest_desc: ["Halves one super-effective Steel-type hit. Useful on Ice, Rock and Fairy types weak to Steel."]
	quest.1FC375EFCBACAF00.quest_desc: [
		"Mine some &acobblestone&r with your wooden pickaxe and upgrade your tool set to stone."
		""
		"Stone tools last longer and hit harder, and a stone pickaxe is the key that finally opens the door to iron ore."
	]
	quest.1FC375EFCBACAF00.quest_subtitle: "The socle of everything"
	quest.1FC375EFCBACAF00.title: "Stone Age"
	quest.1FE091D678CD5052.quest_desc: ["Held by Clamperl it evolves into Gorebyss, and boosts Special Defense."]
	quest.1FE371A587F832EC.quest_desc: ["An eerie cloth that evolves Dusclops into Dusknoir on trade."]
	quest.1FE67AB5B5252619.quest_desc: ["A tangy yellow Apricorn juice."]
	quest.1FE6F0C60B6EF704.quest_desc: ["Changes a Pokemon's nature to Timid, reshaping its stat spread without re-breeding."]
	quest.2011B7295E3AD0E8.quest_desc: ["Halves Speed but adds Defense EVs after battle."]
	quest.20426A4BA2350D92.quest_desc: ["Changes a Pokemon's nature to Quiet, reshaping its stat spread without re-breeding."]
	quest.20AACBD489D285A7.quest_desc: ["Adds Special Defense EVs, hardening a special wall."]
	quest.20C2A022D887ED88.quest_desc: ["Cures paralysis on a single Pokemon."]
	quest.21121601C2CB9B7E.quest_desc: ["Halves Speed but adds Speed EVs after battle. A breeding and EV-training tool."]
	quest.212D7476B4076095.quest_desc: ["A famously bitter food berry with a strong smell. Culinary only, an acquired taste in recipes."]
	quest.214899BF912F4F74.quest_desc: ["Swaps a Pokemon between its two regular Abilities."]
	quest.21B58E36233A376E.quest_desc: ["A spicy-sweet food berry. No held effect, but a staple ingredient for cooking and treats."]
	quest.22256AB2CA6F8387.quest_desc: ["Adds Defense EVs to build a physical wall."]
	quest.23417F87E6CFA339.quest_desc: ["Halves one super-effective Dragon-type hit. Essential tech on Dragon types in the mirror match."]
	quest.24A196A2176196BB.quest_desc: ["A round stone that evolves Happiny into Chansey when held during the day."]
	quest.24BD917FDE507BEF.quest_desc: ["Changes a Pokemon's nature to Careful, reshaping its stat spread without re-breeding."]
	quest.24EDE1EB4FBADB4C.quest_desc: ["Halves one super-effective Ground-type hit. A common pick on Fire, Electric and Steel types weak to Earthquake."]
	quest.2506D45CAAB9A0E9.quest_desc: ["Lets the holder survive any single hit at 1 HP from full. A frail sweeper staple."]
	quest.2514160C77268B55.quest_desc: ["A sour food berry, the sour member of the flavor-heal family. Chiefly a cooking ingredient here."]
	quest.25FF5F49346F0351.quest_desc: ["Raises Special Attack when HP runs low, powering up a special sweeper on its last legs."]
	quest.2644106AA53AF793.quest_desc: ["Changes a Pokemon's nature to Serious, reshaping its stat spread without re-breeding."]
	quest.26C0C6CE2C52BEB8.quest_desc: ["Restores a moderate amount of HP. The mid-tier heal."]
	quest.26D544BAA33397E4.quest_desc: [
		"Mine your first &aDiamond&r. It hides deep, usually below Y=-59, so bring torches and watch out for lava."
		""
		"Diamonds unlock the enchanting table, obsidian mining, and the best gear the overworld has to offer."
		""
		"&e&lTip:&r you are about to be equipped enough for what comes next: the dimensions."
	]
	quest.26D544BAA33397E4.quest_subtitle: "The classic milestone"
	quest.26D544BAA33397E4.title: "Diamonds Are Forever"
	quest.276E1F7F0129B6A6.title: "Gym Leader Tom"
	quest.28506AD088DC6827.quest_desc: ["Lowers Defense EVs and raises friendship. Useful when reshaping a spread or pushing a friendship evolution."]
	quest.28C66D72E795C3F9.quest_desc: ["Triggers trade evolutions in Cobblemon without a partner. Evolves Machoke, Haunter and more."]
	quest.292433F584B1F7F8.quest_desc: ["Changes a Pokemon's nature to Calm, reshaping its stat spread without re-breeding."]
	quest.29AD13E12B02EE5A.title: "Champion Gazai"
	quest.2A27EACB10DB3932.quest_desc: ["Adds Defense EVs to a Pokemon. Train up a physical wall fast."]
	quest.2AA86FA3605C966D.quest_desc: ["A hairy, sour food berry. No battle use, but a solid cooking ingredient."]
	quest.2BB67258A1BADA4F.title: "Elite Four Tama"
	quest.2BE068E77B254EBC.quest_desc: ["A fluffy cream that evolves Swirlix into Slurpuff on trade."]
	quest.2C8F8890D682892A.quest_desc: ["Halves Speed but adds Attack EVs after battle."]
	quest.2D0DD5D06EE5C01E.quest_desc: ["Adds a single Defense EV to round off bulk."]
	quest.2D2959F7A73FA0EB.quest_desc: ["Raises Defense when HP runs low, letting a wall dig in at the worst moment."]
	quest.2D5627C699DEE86D.quest_desc: ["Thaws a frozen Pokemon."]
	quest.2D61BC168DEC8637.quest_desc: ["Changes a Pokemon's nature to Adamant, reshaping its stat spread without re-breeding."]
	quest.2DBEA8B7F1AF1D5D.quest_desc: ["An electric device that evolves Electabuzz into Electivire."]
	quest.2DE76DFC1086F69F.quest_desc: ["Lets the holder move first within its priority bracket once when HP runs low. A clutch pinch berry for landing the final blow."]
	quest.2E1887D3388210DD.quest_desc: ["Boosts Special Defense by 50 percent but blocks status moves. Turns attackers into tanks."]
	quest.2E4B37499D05A742.quest_desc: [
		"Collect every Cobblemon berry to prove you are a true Berry Master."
		""
		"Reward: a random pull from the Berry Master table plus a big XP payout. The grand prize for filling every plot on the farm."
	]
	quest.2E4B37499D05A742.quest_subtitle: "Collect all 70 berries"
	quest.2E4B37499D05A742.title: "Berry Master"
	quest.2E77D644E3015866.quest_desc: ["Held glasses that boost the power of special moves by 10 percent."]
	quest.2E7F2F734F9ABE0B.quest_desc: ["Evolves Grass Pokemon like Gloom and Exeggcute."]
	quest.3043C909D31355DE.quest_desc: [
		"Steamon quietly smooths out a lot of the grind. Here are 4 passive tricks worth knowing early."
		"{@pagebreak}"
		"&e&lTip:&r enchant a pickaxe with &aVein Mining&r (up to level 3) at an enchanting table or anvil. Mine one block of an ore vein and the whole vein comes with it."
		"{@pagebreak}"
		"Trees fall completely when you break their base log, and replant themselves automatically. Bone Meal also works on far more plants than just vanilla crops now, so keep a stack handy."
		"{@pagebreak}"
		"Right-click a fully grown crop to harvest it and replant it in one single motion. No more breaking and re-planting by hand, ever again."
	]
	quest.3043C909D31355DE.quest_subtitle: "Let the game do the boring parts"
	quest.3043C909D31355DE.title: "Work Smarter"
	quest.3084470212E5AD9E.quest_desc: ["A heavy protective item that evolves Rhydon into Rhyperior on trade."]
	quest.30AFAC41F3B73B72.quest_desc: [
		"You have your first partner, a full ball line, vitamins and evolution stones. The basics are yours."
		""
		"&eUnlocks the Trainer's Path&r. Claim a random reward from the First Steps cache."
		""
		"Reward: one pull from the First Steps loot table, plus a bonus."
	]
	quest.30AFAC41F3B73B72.quest_subtitle: "You are a Trainer now"
	quest.30AFAC41F3B73B72.title: "First Steps Complete"
	quest.3156ED3D702729A3.quest_desc: ["Halves one super-effective Rock-type hit. Great on Fire, Flying, Bug and Ice types that dread Stone Edge."]
	quest.31A8811F6306EC1C.quest_desc: ["Raises accuracy for the next move when HP runs low, guaranteeing an otherwise shaky attack lands."]
	quest.31BD3E00B19E4485.quest_desc: ["A crisp white Apricorn juice."]
	quest.31E6BFCD89999B31.quest_desc: ["Cures poison on a single Pokemon."]
	quest.325E291E2A1ACC80.quest_desc: ["Adds a single HP EV. Fine-tune a spread to the exact point."]
	quest.338F6A3444EB747E.quest_desc: ["Thaws a frozen Pokemon at once so it can act instead of waiting out the freeze."]
	quest.33DFC5D1B2C45880.quest_desc: ["Halves one super-effective Flying-type hit. Shields Grass, Fighting and Bug types from Brave Bird."]
	quest.3557D562DF4C7F99.quest_desc: ["Evolves gender-specific Pokemon like male Kirlia and female Snorunt."]
	quest.35B939FA61281403.quest_desc: ["Evolves Sneasel into Weavile when held at night, and raises the critical-hit ratio."]
	quest.35E796275277CA87.quest_desc: ["Halves one super-effective Poison-type hit, protecting Grass and Fairy types."]
	quest.374870F324D9E89A.quest_desc: ["Halves one super-effective Electric-type hit. Popular on Flying and Water types that fear Thunderbolt."]
	quest.38AE9C9E0567DD5C.quest_desc: [
		"This is the main line of Steamon: a short climb from your very first log to your first step into the End."
		""
		"Punch some &alogs&r to get started. Each milestone below unlocks the next, and a few side paths point you toward Create, Cobblemon and other useful tricks along the way."
		""
		"Follow it top to bottom, or wander off whenever something else catches your eye."
	]
	quest.38AE9C9E0567DD5C.quest_subtitle: "Every journey starts with a tree"
	quest.38AE9C9E0567DD5C.title: "&aEvery Journey Begins"
	quest.3900000000000001.quest_desc: ["This opens the Cobblemon Cooking quest line. Vitamins, mints, mochi, candy, and healing items for training and caring for your team."]
	quest.3900000000000001.title: "Welcome to Cobblemon Cooking"
	quest.39A88117C609668C.quest_desc: ["Adds Attack EVs to a Pokemon, up to the training cap. The staple physical EV booster."]
	quest.3A21272C12F3782D.quest_desc: ["A fiery, spicy food berry covered in bumps. No battle effect; grow it for cooking."]
	quest.3AB4439C155914C0.quest_desc: ["Snaps a confused Pokemon back to its senses, preventing it from hurting itself."]
	quest.3BDE170AFAF57E6B.quest_desc: ["Wakes a sleeping Pokemon."]
	quest.3E7681AB12026F3F.quest_desc: ["Lowers Speed EVs and raises friendship, useful for Trick Room builds or friendship evolutions."]
	quest.3F0B9882273FBF16.quest_desc: [
		"Collect every Cobblemon cooking, vitamin and medicine item to master the kitchen."
		""
		"Reward: a random pull from the Master Chef table plus a big XP payout."
	]
	quest.3F0B9882273FBF16.quest_subtitle: "Cook and collect it all"
	quest.3F0B9882273FBF16.title: "Master Chef"
	quest.4000000000000C01.title: "Beyond the Clouds"
	quest.4000000000000C01.quest_desc: [
		"A kingdom floats above the clouds, waiting for those bold enough to reach it."
		""
		"Check this quest to begin charting your path into the Aether."
		""
		"Every skyward journey starts with a single step."
	]
	quest.40091CD67B4264AE.title: "Enter the Aether"
	quest.40091CD67B4264AE.quest_desc: [
		"The Aether mirrors the Nether, but everything is reversed. Where fire opens one gate, water opens the other."
		""
		"Build a 4x5 Glowstone frame and pour a Water Bucket inside it to ignite the portal."
		""
		"Stepping through unlocks this entire chapter, your gateway to the sky kingdom starts here."
	]
	quest.40380154C8DB6FC8.title: "Skyroot \& Shelter"
	quest.40380154C8DB6FC8.quest_desc: [
		"The Aether grows no ordinary trees. Skyroot is the wood of the sky, and your very first resource up there."
		""
		"Chop 16 Skyroot Logs. Tip: tools crafted from Skyroot double the drop rate of Aether blocks, so craft a Skyroot axe and pickaxe as soon as you can."
		""
		"This gives you shelter and your first proper toolset to survive the clouds."
	]
	quest.40D4379A448269BF.title: "Holystone \& Ambrosium"
	quest.40D4379A448269BF.quest_desc: [
		"Holystone is the bedrock of the Aether, the very stone this realm is built from."
		""
		"Mine 16 Holystone with a Skyroot Pickaxe. It commonly drops Ambrosium Shards, used for light sources and healing."
		""
		"This carries you into the stone tier and lets you light your base without a single lump of coal."
	]
	quest.40842F992469C8BC.title: "The Zanite Tier"
	quest.40842F992469C8BC.quest_desc: [
		"Zanite is the Aether's answer to iron, a shimmering gem with a very unusual trait."
		""
		"Tip: the more damaged a Zanite tool gets, the faster it mines. Push your tools to the edge of breaking for peak performance, and gather Zanite Gemstones along the way."
		""
		"Reaching Zanite opens up the next full gear tier of the sky kingdom."
	]
	quest.40AE8503084F9449.title: "Lighter Than Air"
	quest.40AE8503084F9449.quest_desc: [
		"Aerogel is lighter than the air itself, prized by sky architects for its unique properties."
		""
		"Craft 8 Aerogel and use it to shape your celestial builds without weighing them down."
		""
		"Optional, but a great way to give your Aether base its own identity."
	]
	quest.403252BA15BC35FB.title: "Tame a Moa"
	quest.403252BA15BC35FB.quest_desc: [
		"Moas are the Aether's mounts: flightless, but capable of jumping to incredible heights."
		""
		"Find a Moa Egg, incubate it on a bed of Skyroot planks, then tame the chick that hatches with its favorite food."
		""
		"Optional, but a Moa gives you serious early mobility across the floating islands."
	]
	quest.4033EB6690E842EC.title: "Pendants \& Gloves"
	quest.4033EB6690E842EC.quest_desc: [
		"The Aether rewards those who gear up smart. Pendants grant passive buffs, gloves turn the tide in combat."
		""
		"Equip a Zanite Pendant in your accessory slot for a constant passive bonus while you explore."
		""
		"Optional, but it is your introduction to the Aether's whole accessory system, worth exploring further."
	]
	quest.40AACB4577F3D5EB.title: "Bronze Dungeon: The Slider"
	quest.40AACB4577F3D5EB.quest_desc: [
		"A hidden tunnel on the face of a floating island leads to the Aether's first dungeon."
		""
		"Defeat the Slider, a towering block of living stone, deep inside the Bronze Dungeon. It drops a dungeon key and a set of armor."
		""
		"Your first boss kill, and the door to the Aether's mid-game."
	]
	quest.401CF9AF56F01343.title: "Silver Dungeon: The Valkyrie Queen"
	quest.401CF9AF56F01343.quest_desc: [
		"The Silver Dungeon holds the Valkyrie Temple, home to warriors who only strike if struck first."
		""
		"Farm 10 Victory Medals from the Valkyries (they will not attack unless provoked), then challenge the Valkyrie Queen herself."
		""
		"Your second boss kill, and it unlocks the key to the Gold Dungeon."
	]
	quest.40A3460330537B45.title: "Enchanted Gravitite"
	quest.40A3460330537B45.quest_desc: [
		"Gravitite is the Aether's rarest ore, roughly on par with diamond, and it drifts upward instead of falling."
		""
		"Enchant raw Gravitite to create Enchanted Gravitite. Tools made from it fling blocks on impact, and its armor lets you leap to incredible heights."
		""
		"This is the top material tier of the vanilla Aether, your true endgame gear."
	]
	quest.40DEB2DB8508FE06.title: "Gold Dungeon: The Sun Spirit"
	quest.40DEB2DB8508FE06.quest_desc: [
		"A colossal sphere drifts in the sky, the Gold Dungeon, home to the Sun Spirit itself."
		""
		"Tip: the Sun Spirit is invincible until you shatter the ice crystals shielding it. Break them all, then strike it down."
		""
		"Optional, but defeating it unlocks the Sun Altar, giving you control over day and night. The longest and final boss fight of the vanilla Aether."
	]
	quest.401A19590E99D474.title: "Master of the Aether"
	quest.401A19590E99D474.quest_desc: [
		"Few trainers can call themselves true masters of the sky kingdom."
		""
		"Check this quest once you have completed at least two major Aether milestones from this chapter."
		""
		"A fitting reward for your climb, reachable without ever facing the Gold Dungeon."
	]
	quest.40DD79ECF93094F5.title: "Immersive Skies"
	quest.40DD79ECF93094F5.quest_desc: [
		"Why walk through a portal when you could simply fly there instead?"
		""
		"Assemble an Airship: combine a hull, an engine, and a sail. It is slow, but forgiving to fly, perfect for a first attempt at aviation."
		""
		"Optional, a fun new way to explore the skies at your own pace."
	]
	quest.40233088EF9031F7.title: "A Taste of the Sky"
	quest.40233088EF9031F7.quest_desc: [
		"Blue Berries, Moa Stew, Gingerbread: the Aether has its own harvest, and its own flavor."
		""
		"Gather a batch of Aether ingredients here. Tip: the full recipes are waiting for you in the Culinary chapter, this is just a preview of what is on the menu."
		""
		"Your bridge between the sky kingdom and the kitchen."
	]
	quest.4016A57E0B32D7DF.title: "Deep Aether: Skyjade"
	quest.4016A57E0B32D7DF.quest_desc: [
		"Beneath the Aether lies the Deep Aether, nine uncharted biomes and metals nobody above has ever touched."
		""
		"Mine 4 Skyjade, a material that picks up where Gravitite left off. Tip: Stratus, the tier above it, is obtained through a Smithing Template instead of mining."
		""
		"Optional, this cracks open the entire post-game layer beneath the clouds."
	]
	quest.40F7F648E4C62FF4.title: "Brass Dungeon: Eye of the Storm"
	quest.40F7F648E4C62FF4.quest_desc: [
		"The Brass Dungeon lies hidden within the Deep Aether, home to the Eye of the Storm."
		""
		"Locate the brass-forged dungeon and defeat the Eye of the Storm within."
		""
		"Optional, your fourth boss kill and a key step toward full mastery of the sky."
	]
	quest.40CF7DEF743EEA58.title: "Champion of the Aether"
	quest.40CF7DEF743EEA58.quest_desc: [
		"A true champion of the Aether has all four of its guardians beneath their feet."
		""
		"Defeat the Slider, the Valkyrie Queen, the Sun Spirit, and the Eye of the Storm."
		""
		"Optional, the ultimate accomplishment this realm has to offer. Entirely optional, but it will mean everything if you claim it."
	]
	quest.41EFBDCF0556574A.quest_desc: ["Ignores entry hazards on switch-in. Essential tech against Stealth Rock teams."]
	quest.42B8ED6522652C2F.quest_desc: ["Adds Speed EVs, pushing a sweeper past the field."]
	quest.439125930B53268F.quest_desc: ["Changes a Pokemon's nature to Bold, reshaping its stat spread without re-breeding."]
	quest.43A9B8A977E70989.quest_desc: ["Cures the holder of move-blocking effects like Taunt or Encore, once."]
	quest.43C55E1C1051E955.quest_desc: ["Held item that halves the damage from a super-effective Fire-type move once. A lifesaver for Grass, Ice, Bug and Steel types."]
	quest.44943D9F41393F60.quest_desc: ["Cures a burn, restoring lost Attack pressure and stopping the chip damage each turn."]
	quest.44A2C35534E51C9C.quest_desc: ["Restores a large amount of HP for tougher fights."]
	quest.44C2ABF85A99A9C9.quest_desc: ["Adds Special Defense EVs to a spread."]
	quest.44D4B1C50A9377B4.quest_desc: ["Halves one super-effective Bug-type hit, easing the Bug weakness of Psychic, Grass and Dark types."]
	quest.4756F5C74CF34221.quest_desc: ["Revives a fainted Pokemon with half its HP."]
	quest.4809D43C4E6C288E.quest_desc: ["Adds Attack EVs through a tasty treat."]
	quest.4863CD6DE6F03905.quest_desc: ["Restores about a quarter of max HP when the holder drops to half. The staple bulk-restoring held berry."]
	quest.4867E364EA0C8FF4.quest_desc: ["Boosts the power of super-effective moves by 20 percent."]
	quest.49CCC0D47FD56CC2.quest_desc: [
		"Collect every competitive held item and IV cap to build the perfect battle team."
		""
		"Reward: a random top-tier held item or IV tool plus a big XP payout."
	]
	quest.49CCC0D47FD56CC2.quest_subtitle: "Assemble every battle item"
	quest.49CCC0D47FD56CC2.title: "Battle Master"
	quest.4A090658157A4189.quest_desc: ["Wipes every EV off a Pokemon at once, giving you a clean slate to retrain."]
	quest.4B342B6226C513FC.quest_desc: ["Evolves Pokemon such as Togetic and Roselia."]
	quest.4B478508EF3A5998.quest_desc: ["Fully restores the PP of a single move."]
	quest.4BCA5AE6E024A7AF.quest_desc: ["Halves one super-effective Dark-type hit, guarding Psychic and Ghost types from Dark moves."]
	quest.4C6BC4837AADD3DC.quest_desc: ["Raises a Pokemon's HP IV toward its maximum."]
	quest.4CADC2E0A00608F9.quest_desc: ["A shiny scale that evolves Feebas into the elegant Milotic."]
	quest.4CD930E5A9CD764E.quest_desc: ["Changes a Pokemon's nature to Rash, reshaping its stat spread without re-breeding."]
	quest.4D023215BB17440E.title: "Elite Four Professor Bee"
	quest.4DB5E0E9EE60FE98.quest_desc: ["Lowers the Attack IV, handy for confusion or Foul Play sets."]
	quest.4E3C765D5CF8C1D7.quest_desc: ["Halves Speed but adds HP EVs after battle."]
	quest.4EFD1A480A12986D.description: [
		"Welcome to Steamon, Trainer! Two worlds collide here: the wild region of &cCobblemon&r and the machine age of &6Create&r.",
		"",
		"This chapter covers the essentials: picking your starter, catching your first Pokemon, healing up, and storing your team. Nothing here is a detour, it's the foundation.",
		"",
		"Check the mark to begin, then work your way down the tree at your own pace."
	]
	quest.4EFD1A480A12986D.subtitle: "Welcome to Steamon"
	quest.4EFD1A480A12986D.title: "&cTrainer's First Steps&r"

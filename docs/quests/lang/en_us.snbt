	quest.5095578B35049804.title: "Catch a Grass-type"
	quest.5096E4411BC2AEE2.quest_desc: [
		"A &aKnife&r lets you cut ingredients on a Cutting Board and butcher animals for extra drops."
		""
		"Craft a &aFlint Knife&r to begin, then upgrade to iron and beyond."
		""
		"Reward: a free Iron Knife to get you cutting."

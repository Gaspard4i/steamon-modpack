	quest.50902A5B0B8A2813.quest_desc: [
		"You know the rules, you are in the Discord, and you know your way around. Time to play."
		""
		"Follow the &aSteamon Journey&r line to progress through the pack, and check the &aDaily Quests&r for coins every day."
		""
		"Reward: a starter pouch of spurs and some Poke Balls. Welcome aboard, Trainer."
	]
	quest.50902A5B0B8A2813.quest_subtitle: "Your adventure starts now"
	quest.50902A5B0B8A2813.title: "Get Started"
